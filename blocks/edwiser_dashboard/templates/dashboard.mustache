<div class="row g-4">

<!-- ================= COURSE PROGRESS ================= -->
<div class="col-lg-6">

  <div class="card shadow-sm border-0 rounded-4 h-100">

    <!-- Header -->
    <div class="card-header text-white rounded-1"
         style="background: linear-gradient(to right, #334155, #0f172a);">
      <div class="d-flex justify-content-between align-items-center">

        <div class="d-flex align-items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" style="width:40px;height:40px;" class="block-icon1" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 3v16a2 2 0 0 0 2 2h16"></path>
            <path d="M18 17V9"></path>
            <path d="M13 17V5"></path>
            <path d="M8 17v-3"></path>
          </svg>
          <div>
            <h6 class="mb-0 fw-semibold text-light">Course Progress</h6>
            <small class="text-light opacity-75">Track learner engagement</small>
          </div>
        </div>

        <div class="d-flex gap-2">
          <select id="cpCohort" class="form-select form-select-sm bg-dark text-white d-none">
            <option value="0">Select Cohort</option>
            {{#cohort}}
              <option value="{{id}}">{{name}}</option>
            {{/cohort}}
          </select>

          <select id="cpCourse" class="form-select form-select-sm bg-dark text-white">
            {{#courses}}
              <option value="{{id}}" {{#selected}}selected{{/selected}}>
                {{fullname}}
              </option>
            {{/courses}}
          </select>
        </div>

      </div>
    </div>

    <!-- Body -->
    <div class="card-body d-flex gap-4 flex-wrap align-items-center" style="justify-content: center;">

      <!-- Average Progress -->
      <div class=" text-center" style="width:100px;">
      <div class="bg-warning bg-opacity-10 p-2 mb-2 rounded-3 text-center">
        <small class="text-warning text-uppercase fw-semibold">Average Progress</small>
        <div class="text-2xl fw-bold text-dark" id="cpAverage">{{courseprogress.average}}%</div>
        <small class="text-success">+5% from last month</small>
        </div>
        <div class="bg-secondary bg-opacity-10 p-2 rounded-4 text-center">
        <div class="mt-3 text-2xl fw-bold text-dark" id="cpTotal">{{courseprogress.totallearners}} Total Learners</div>
        <small class="text-muted">
        Total Learners
        </small>
        </div>
      </div>

      <!-- Donut Chart -->
      <div style="width:180px;">
        <canvas id="progressDonut" height="180"
          data-distribution='{{#courseprogress.distribution}}{{value}},{{/courseprogress.distribution}}'></canvas>
      </div>

      <!-- Legend -->
      <div class="small" style="width:140px;" id="cpLegend">
        {{#courseprogress.distribution}}
          <div class="d-flex justify-content-between align-items-center mb-2 cp-legend cursor-pointer" data-range="{{range}}">
            <span class="d-flex align-items-center gap-2">
              <span class="rounded-circle" style="width:10px;height:10px;background-color:{{color}};"></span>
              {{label}}
            </span>
            <div class="text-end">
              <strong>{{value}}</strong>
              <div class="text-muted small">students</div>
            </div>
          </div>
        {{/courseprogress.distribution}}
      </div>

    </div>

    <div class="text-end m-3">
      <a href="{{viewdetailsurl}}" class="btn text-white rounded-pill px-4" style="background: #f57215;">
        View Details
      </a>
    </div>

  </div>
</div>


<!-- ================= SITE OVERVIEW ================= -->
<div class="col-lg-6">

  <div class="card shadow-sm border-0 rounded-4" style="height: -webkit-fill-available;">

    <!-- Header -->
    <div class="card-header text-white rounded-1"
         style="background: linear-gradient(to right, #334155, #0f172a);">
      <div class="d-flex justify-content-between align-items-center">

        <div class="d-flex align-items-center gap-3">
         <svg xmlns="http://www.w3.org/2000/svg" style="width: 40px;
    height: 40px;" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity block-icon1"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg>
          <div>
            <h6 class="mb-0 fw-semibold text-light">Site Overview Stats</h6>
            <small class="text-light opacity-75">
              Monitor key performance metrics
            </small>
          </div>
        </div>
<div class="d-flex gap-2">

  <!-- Cohort -->
  <select id="soCohort" class="form-select form-select-sm">
    <option value="0">All Cohorts</option>
    {{#cohorts}}
      <option value="{{id}}">{{name}}</option>
    {{/cohorts}}
  </select>

  <!-- Days -->
  <select id="soFilter" class="form-select form-select-sm d-none">
    <option value="last7days">Last 7 Days</option>
    <option value="last30days">Last 30 Days</option>
    <option value="thismonth">This Month</option>
  </select>

</div>

        <a href="{{viewdetailsurl1}}" class="btn btn-sm btn- rounded-pill text-white" style="background: #f57215;">
          View Details
        </a>

      </div>
    </div>

    <!-- Stats -->
    <div class="card-body">

      <div class="row g-3 text-center">

        <div class="col-4">
          <div class="bg-light rounded-4 p-3">
            <span class="material-icons text-secondary">groups</span>
            <div class="h4 fw-bold mb-0" data-so="activeusers">{{siteoverview.activeusers}}</div>
            <small class="text-muted">Total Active Users</small>
            <div class="text-success small">▲ +12%</div>
          </div>
        </div>

        <div class="col-4">
          <div class="bg-light rounded-4 p-3">
            <span class="material-icons text-warning">school</span>
            <div class="h4 fw-bold mb-0" data-so="enrollments">{{siteoverview.enrollments}}</div>
            <small class="text-muted">Total Enrollments</small>
            <div class="text-success small">▲ +8%</div>
          </div>
        </div>

        <div class="col-4">
          <div class="bg-light rounded-4 p-3">
            <span class="material-icons text-success">check_circle</span>
            <div class="h4 fw-bold mb-0" data-so="completions">{{siteoverview.completions}}</div>
            <small class="text-muted">Total Completions</small>
            <div class="text-danger small">▼ -3%</div>
          </div>
        </div>

      </div>

      <!-- Line Chart -->
      <div class="mt-4" style="width: 520px; height: 220px;">
    <canvas
  id="overviewChart"
  height="220"
  data-trendactiveusers="{{{siteoverview.trendActiveUsers}}}"
  data-trendenrollments="{{{siteoverview.trendEnrollments}}}"
  data-trendcompletions="{{{siteoverview.trendCompletions}}}"
  data-trenddates="{{{siteoverview.trendDates}}}">
</canvas>

      </div>

    </div>
  </div>

</div>
</div>
<!-- ================= ADDITIONAL DASHBOARD BLOCKS ================= -->
<div class="row g-4 mt-2">

  <!-- ================= COURSE REPORT ================= -->
  <div class="col-12">
    <div class="card shadow-sm border-0 rounded-4" style="height: -webkit-fill-available;">

      <div class="card-header text-white rounded-1"
           style="background: linear-gradient(to right, #334155, #0f172a);">

  <div class="d-flex align-items-center gap-3">
         <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text block-icon1"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>
          <div style="width:40%;">
          
            <h6 class="mb-0 fw-semibold text-light">Course Report</h6>
            <small class="text-light opacity-75">Track learner progress across courses</small>
          </div>
           <div class="d-flex w-100 justify-content-end">
           <input type="text" class="form-control form-control-sm w-25" id="edwiser-search"
                 placeholder="Search in all columns">
                 </div>
        </div>

      
      </div>

      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table align-middle mb-0" id="edwiser-report-body">
            <thead class="table-light">
              <tr>
                <th>User Name</th>
                <th>User Email</th>
                <th>First Name</th>
                <th>Designation</th>
                <th>Department</th>
                <th>Course Name</th>
                <th style="width:160px;">Progress</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
{{#customreport.rows}}
  <tr class="edwiser-row">
    <!-- User Name -->
    <td>{{0}}</td>

    <!-- Email -->
    <td>{{1}}</td>
    <!-- First Name -->
<td>{{2}}</td>
<!-- Department -->
<td>{{3}}</td>
     <!-- Designation -->
    <td>{{4}}</td>
    <!-- Course name -->
    <td>{{6}}</td>
    <!-- Progress -->
    <td>
      <div class="progress" style="height:6px;">
        <div class="progress-bar bg-warning"
             style="width:{{7}}"></div>
      </div>
      <small class="fw-medium">{{7}}</small>
    </td>
    <!-- Status -->
    <td>
      {{#9}}
        <span class="badge bg-success-subtle text-success">
          {{9}}
        </span>
      {{/9}}
      {{^9}}
        <span class="badge bg-warning-subtle text-warning">
          In Progress
        </span>
      {{/9}}
    </td>
  </tr>
{{/customreport.rows}}

{{^customreport.rows}}
  <tr>
    <td colspan="6" class="text-center text-muted py-4">
      No data available
    </td>
  </tr>
{{/customreport.rows}}
</tbody>

          </table>
        </div>
      </div>
<div class="d-flex justify-content-between align-items-center p-3">
  <small class="text-muted">
    Showing <span id="edwiser-start">1</span>–
    <span id="edwiser-end">10</span>
  </small>

  <ul class="pagination pagination-sm mb-0" id="edwiser-pagination"></ul>
</div>

    </div>
  </div>

  <!-- ================= CERTIFICATE STATS ================= -->
  <div class="col-lg-6">
    <div class="card shadow-sm border-0 rounded-4" style="height: -webkit-fill-available;">

      <div class="card-header text-white rounded-1"
         style="background: linear-gradient(to right, #334155, #0f172a);">
      <div class="d-flex justify-content-between align-items-center">

        <div class="d-flex align-items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-award block-icon1"><path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"></path><circle cx="12" cy="8" r="6"></circle></svg>
