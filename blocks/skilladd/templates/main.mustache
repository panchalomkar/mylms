{{!
    @template block_skilladd/main

    This template renders the main content area for the task list block.

    Example context (json):
    {
        "instanceid": 1
    }
}}

<div id="block-skilladd-{{instanceid}}" class="block-skilladd block-cards" data-instanceid="{{instanceid}}">
    <div class="block-skilladd-additem form-group">
      
        {{#isadmin}}
          <div class="block-skilladd-additem-input-container">
            <label for="block-skilladd-input-{{instanceid}}" class="sr-only">{{#str}}additem, block_skilladd{{/str}}</label>
            <input id="block-skilladd-input-{{instanceid}}" type="text" class="block-skilladd-input form-control" autocomplete="off" placeholder="{{#str}}additem, block_skilladd{{/str}}"/>
        </div>
        <button class="block-skilladd-input-button btn btn-secondary">{{#pix}}e/insert, core, {{#str}}additem, block_skilladd{{/str}}{{/pix}}</button>
        <a href="{{adminurl}}" class="block-skilladd-input-button btn btn-secondary ml-2">Add skill by admin</a>
        {{/isadmin}}
            {{^isadmin}}
        <a href="{{userurl}}" class="block-skilladd-input-button btn btn-secondary ml-2">Add skill by user</a>
        {{/isadmin}} 
        
    </div>
    <div class="container-fluid p-0">
        <ul class="block-skilladd-list">
        </ul>
    </div>
</div>
{{#js}}
    require(['block_skilladd/main'], function(Main) {
    Main.init('#block-skilladd-{{instanceid}}');
    });
{{/js}}
