<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="blocks/skilladd/db" VERSION="20221021" COMMENT="XMLDB file for Moodle blocks/skilladd"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="block_skilladd_items" COMMENT="List items">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="User ID"/>
        <FIELD NAME="instanceid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Block instance ID"/>
        <FIELD NAME="name" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Task name"/>
        <FIELD NAME="complete" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Yes/no complete"/>
        <FIELD NAME="position" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid-instanceid" UNIQUE="false" FIELDS="userid, instanceid"/>
      </INDEXES>
    </TABLE>
     <TABLE NAME="block_skilladd" COMMENT="List skill">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="11" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="users id"/>
        <FIELD NAME="department" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="users department"/>
        <FIELD NAME="skill" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="users skill"/>
        <FIELD NAME="skilllevel" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="users skilllevel"/>
        <FIELD NAME="position" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="users position"/>
        <FIELD NAME="grade" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="users grade"/>
        <FIELD NAME="createdby" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="users createdby"/>
        <FIELD NAME="timecreated" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="users timecreated"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
