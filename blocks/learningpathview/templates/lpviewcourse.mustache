<style>
.lp-detail-wrapper * { box-sizing: border-box; }
.lp-detail-wrapper { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 1000px; margin: 0 auto; padding: 20px 0; }
.lp-detail-header { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 32px; }
.lp-back-btn { width: 40px; height: 40px; border-radius: 50%; border: none; background: #f3f4f6; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; margin-top: 4px; text-decoration: none; color: #1a1f36; font-size: 18px; transition: background 0.2s; }
.lp-back-btn:hover { background: #e5e7eb; text-decoration: none; color: #1a1f36; }
.lp-detail-title-area { flex: 1; }
.lp-detail-title-area h1 { font-size: 24px; font-weight: 700; color: #1a1f36; margin: 0 0 6px; }
.lp-detail-title-area p { font-size: 14px; color: #6b7280; margin: 0; line-height: 1.5; }
.lp-detail-actions { display: flex; align-items: center; gap: 14px; flex-shrink: 0; margin-top: 4px; }
.lp-detail-progress-ring { position: relative; width: 44px; height: 44px; }

.lp-detail-progress-ring .ring-bg { fill: none; stroke: #e5e7eb; stroke-width: 4; }
.lp-detail-progress-ring .ring-fg { fill: none; stroke: #f59e0b; stroke-width: 4; stroke-linecap: round; transition: stroke-dashoffset 0.4s ease; }
.lp-resume-btn { padding: 10px 24px; border-radius: 8px; border: 2px solid #f59e0b; background: #fff; color: #1a1f36; font-size: 14px; font-weight: 600; cursor: pointer; text-decoration: none; transition: all 0.2s; display: inline-block; }
.lp-resume-btn:hover { background: #f59e0b; color: #fff; text-decoration: none; }
.lp-smart-section { margin-bottom: 36px; }
.lp-smart-section h3 { font-size: 16px; font-weight: 700; color: #1a1f36; margin: 0 0 16px; }
.lp-smart-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
@media (max-width: 768px) { .lp-smart-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 480px) { .lp-smart-grid { grid-template-columns: 1fr; } }
.lp-smart-card { background: #1a1f36; border-radius: 12px; padding: 16px; color: #fff; }
.lp-smart-card-label { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
.lp-smart-card-icon { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; flex-shrink: 0; }
.lp-smart-card-icon.green { background: #10b981; color: #fff; }
.lp-smart-card-icon.blue { background: #3b82f6; color: #fff; }
.lp-smart-card-icon.teal { background: #14b8a6; color: #fff; }
.lp-smart-card-icon.red { background: #ef4444; color: #fff; }
.lp-smart-card-icon.orange { background: #f59e0b; color: #fff; }
.lp-smart-card-tag { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; }
.lp-smart-card-tag.green { color: #10b981; }
.lp-smart-card-tag.blue { color: #3b82f6; }
.lp-smart-card-tag.teal { color: #14b8a6; }
.lp-smart-card-tag.red { color: #ef4444; }
.lp-smart-card-tag.orange { color: #f59e0b; }
.lp-smart-card-text { font-size: 13px; color: #d1d5db; line-height: 1.4; }
.lp-content-section { margin-bottom: 20px; }
.lp-content-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
.lp-content-header h3 { font-size: 18px; font-weight: 700; color: #1a1f36; margin: 0; }
.lp-content-meta { display: flex; gap: 16px; font-size: 13px; color: #6b7280; }
.lp-content-meta i { margin-right: 4px; }
.lp-course-list { position: relative; padding-left: 40px; }
.lp-course-item { position: relative; margin-bottom: 20px; }
.lp-course-item:last-child { margin-bottom: 0; }
.lp-course-item::before { content: ''; position: absolute; left: -26px; top: 36px; bottom: -40px; width: 2px; background: #f59e0b; }
.lp-course-item:last-child::before { display: none; }
.lp-timeline-dot { position: absolute; left: -34px; top: 20px; width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; z-index: 1; font-size: 9px; }
.lp-timeline-completed { background: #10b981; color: #fff; width: 28px; height: 28px; left: -39px; top: 16px; }
.lp-timeline-inprogress { background: #f59e0b; color: #fff; width: 28px; height: 28px; left: -39px; top: 16px; }
.lp-timeline-locked { background: #9ca3af; color: #fff; width: 28px; height: 28px; left: -39px; top: 16px; }
.lp-course-card { border-radius: 14px; overflow: hidden; display: flex; min-height: 120px; transition: transform 0.2s; }
.lp-course-card.lp-course-done { background: #1a1f36; }
.lp-course-card.lp-course-continue { background: #1a1f36; }
.lp-course-card.lp-course-locked { background: #9ca3af; }
.lp-course-card-img { width: 180px; flex-shrink: 0; overflow: hidden;max-height: 145px; }
.lp-course-card-img img { width: 100%; height: 100%; object-fit: cover; }
.lp-course-card-body { flex: 1; padding: 16px 20px; color: #fff; display: flex; flex-direction: column; }
.lp-course-card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 4px; }
.lp-course-card-body h4 { font-size: 16px; font-weight: 600; margin: 0; color: #fff; }
.lp-course-card-body h4 a { color: #f59e0b; text-decoration: none; }
.lp-course-card-body h4 a:hover { text-decoration: underline; }
.lp-course-card-duration { font-size: 12px; color: #9ca3af; flex-shrink: 0; }
.lp-course-card-desc p {
    font-size: .875rem;
    color: #97a5a7 !important;
    margin: 4px 0 12px;
    line-height: 1.4;

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;

    min-height: 40px;   /* 🔥 ADD THIS */
}
.lp-course-card {
    min-height: 145px;
}
.lp-course-card-footer { display: flex; align-items: center; gap: 12px; }
.lp-course-progress-bar { flex: 1; height: 5px; background: rgba(255,255,255,0.15); border-radius: 3px; overflow: hidden; }
.lp-course-progress-fill { height: 100%; background: #f59e0b; border-radius: 3px; }
.lp-course-done .lp-course-progress-fill { background: #10b981; }
.lp-course-pct-text { font-size: .875rem; color: #97a5a7 !important; white-space: nowrap; }
.lp-course-status-done { font-size: .875rem;color: #10b981; font-weight: 600; white-space: nowrap; }
.lp-course-status-done i { margin-right: 3px; }
.lp-course-status-continue { font-size: .875rem; color: #f59e0b; font-weight: 600; white-space: nowrap; }
.lp-card-progress-pct {
    position: relative;
    width: 44px;
    height: 44px;
}



.lp-card-progress-pct .ring-bg {
    fill: none;
    stroke: #e5e7eb;
    stroke-width: 4;
}

.lp-card-progress-pct .ring-fg {
    fill: none;
    stroke: #f59e0b;
    stroke-width: 4;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.4s ease;
    transform: rotate(-90deg);
    transform-origin: 50% 50%;

}

.lp-circle-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 11px;
    font-weight: 700;
    color: #fff;
}
.lp-course-card {
    display: flex;
    align-items: stretch;
    height: 100%;   /* important */
}
.lp-course-card-footer {
    margin-top: auto;
}
</style>

{{#totallearningpath}}
<div class="lp-detail-wrapper">
    <div class="lp-detail-header">
        <a href="{{backurl}}" class="lp-back-btn"><i class="fa fa-arrow-left"></i></a>
        <div class="lp-detail-title-area">
            <h1>{{learningpathname}}</h1>
            <p>{{{discriotion}}}</p>
        </div>
        <div class="lp-detail-actions">
           <div class="lp-card-progress-pct">
    <svg width="44" height="44" viewBox="0 0 44 44">
        <circle class="ring-bg" cx="22" cy="22" r="18"/>
        <circle class="ring-fg" cx="22" cy="22" r="18"
            stroke-dasharray="113.1"
            stroke-dashoffset="0"
            data-pct="{{progresspercent}}"/>
    </svg>
    <span class="lp-circle-text text-black" >{{progresspercent}}%</span>
</div>
            <a href="{{urllink}}" class="lp-resume-btn">{{buttontext}}</a>
            {{{continuebtn}}}
        </div>
    </div>

    {{#hassmartgoals}}
    <div class="lp-smart-section">
        <h3>SMART Goals</h3>
        <div class="lp-smart-grid">
            {{#smartspecific}}
            <div class="lp-smart-card">
                <div class="lp-smart-card-label">
                    <span class="lp-smart-card-icon green"><i class="fa fa-bullseye"></i></span>
                    <span class="lp-smart-card-tag green">SPECIFIC</span>
                </div>
                <div class="lp-smart-card-text">{{smartspecific}}</div>
            </div>
            {{/smartspecific}}
            {{#smartmeasurable}}
            <div class="lp-smart-card">
                <div class="lp-smart-card-label">
                    <span class="lp-smart-card-icon blue"><i class="fa fa-bar-chart"></i></span>
                    <span class="lp-smart-card-tag blue">MEASURABLE</span>
                </div>
                <div class="lp-smart-card-text">{{smartmeasurable}}</div>
            </div>
            {{/smartmeasurable}}
            {{#smartachievable}}
            <div class="lp-smart-card">
                <div class="lp-smart-card-label">
                    <span class="lp-smart-card-icon teal"><i class="fa fa-check-circle"></i></span>
                    <span class="lp-smart-card-tag teal">ACHIEVABLE</span>
                </div>
                <div class="lp-smart-card-text">{{smartachievable}}</div>
            </div>
            {{/smartachievable}}
            {{#smartrelevant}}
            <div class="lp-smart-card">
                <div class="lp-smart-card-label">
                    <span class="lp-smart-card-icon red"><i class="fa fa-crosshairs"></i></span>
                    <span class="lp-smart-card-tag red">RELEVANT</span>
                </div>
                <div class="lp-smart-card-text">{{smartrelevant}}</div>
            </div>
            {{/smartrelevant}}
            {{#smarttimebound}}
            <div class="lp-smart-card">
                <div class="lp-smart-card-label">
                    <span class="lp-smart-card-icon orange"><i class="fa fa-clock-o"></i></span>
                    <span class="lp-smart-card-tag orange">TIME-BOUND</span>
                </div>
                <div class="lp-smart-card-text">{{smarttimebound}}</div>
            </div>
            {{/smarttimebound}}
        </div>
    </div>
    {{/hassmartgoals}}

    <div class="lp-content-section">
        <div class="lp-content-header">
            <h3>Content</h3>
            <div class="lp-content-meta">
                <span><i class="fa fa-book"></i> {{nocourses}} courses</span>
                <span><i class="fa fa-clock-o"></i> {{duration}}</span>
            </div>
        </div>

        <div class="lp-course-list">
            {{#totalcourse}}
            <div class="lp-course-item">
                <div class="lp-timeline-dot {{timelineiconclass}}">
                    <i class="fa fa-{{timelineicon}}"></i>
                </div>
                <div class="lp-course-card {{coursestatusclass}}">
                    <div class="lp-course-card-img">
                        <img src="{{courseimg}}" alt="{{coursename}}">
                    </div>
                    <div class="lp-course-card-body">
                        <div class="lp-course-card-top">
                            <h4>
                                {{#courselink}}
                                <a {{{courselink}}}>{{coursename}}</a>
                                {{/courselink}}
                                {{^courselink}}
                                {{coursename}}
                                {{/courselink}}
                            </h4>
                            <span class="lp-course-card-duration">{{courseduration}}</span>
                        </div>
                        <div class="lp-course-card-desc">{{{coursedec}}}</div>
                        <div class="lp-course-card-footer">
                            <div class="lp-course-progress-bar">
                                <div class="lp-course-progress-fill" style="width: {{progresspercent}}%"></div>
                            </div>
                           
                        </div>
                        <div class="d-flex justify-content-between mt-2">
                         <span class="lp-course-pct-text" style="color: #f2feff !important;">{{progresspercent}}% complete</span>
                            {{{coursestatushtml}}}
                            </div>
                    </div>
                </div>
            </div>
            {{/totalcourse}}
        </div>
    </div>
</div>
{{/totallearningpath}}

<script>
document.addEventListener("DOMContentLoaded", function () {

    var circles = document.querySelectorAll('.ring-fg');

    circles.forEach(function(circle) {
        var pct = parseFloat(circle.getAttribute('data-pct')) || 0;

        var radius = 18;
        var circumference = 2 * Math.PI * radius;

        var offset = circumference - (pct / 100) * circumference;

        circle.style.strokeDasharray = circumference;
        circle.style.strokeDashoffset = offset;
    });

});
</script>
