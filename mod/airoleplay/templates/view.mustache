{{!
    Scenario view / entry page template.
    @template mod_airoleplay/view
    @copyright 2024 Enterprise AI Learning Platform
}}

<div class="air-platform">
<div class="air-scenario-hub">

  {{! ============================================================ }}
  {{! HEADER                                                         }}
  {{! ============================================================ }}
  <div class="air-scenario-hub__header">
    <h1 class="air-scenario-hub__title">{{scenario.name}}</h1>
    {{#scenario.learning_objective}}
      <p class="air-scenario-hub__subtitle">{{scenario.learning_objective}}</p>
    {{/scenario.learning_objective}}
  </div>

  <div class="row g-4">

    {{! ============================================================ }}
    {{! LEFT: Scenario card + Persona                                 }}
    {{! ============================================================ }}
    <div class="col-lg-8">

      {{! Scenario info card }}
      <div class="air-results-card mb-4">
        <div class="d-flex align-items-start gap-4 flex-wrap">

          {{! Persona avatar }}
          {{#persona}}
            <div style="flex-shrink:0">
              <div style="width:100px;height:100px;border-radius:50%;overflow:hidden;border:3px solid #6366f1;box-shadow:0 8px 24px rgba(99,102,241,0.25)">
                {{#avatar_url}}
                  <img src="{{avatar_url}}" alt="{{name}}" style="width:100%;height:100%;object-fit:cover">
                {{/avatar_url}}
                {{^avatar_url}}
                  <div style="width:100%;height:100%;background:linear-gradient(135deg,#6366f1,#8b5cf6);display:flex;align-items:center;justify-content:center;color:white;font-size:2.5rem;font-weight:800">
                    {{#name}}{{.}}{{/name}}
                  </div>
                {{/avatar_url}}
              </div>
            </div>
          {{/persona}}

          <div style="flex:1">
            {{#persona}}
              <h2 class="mb-1" style="font-size:1.375rem;font-weight:800">{{name}}</h2>
              <div style="color:#6366f1;font-size:0.875rem;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.75rem">
                {{type}} · {{tone}}
              </div>
            {{/persona}}
            {{^persona}}
              <h2 class="mb-1" style="font-size:1.375rem;font-weight:800">{{scenario.name}}</h2>
            {{/persona}}

            <div class="air-persona-card__meta">
              <span class="air-badge air-badge--difficulty-{{scenario.difficulty}}">
                {{scenario.difficulty}}
              </span>
              {{#scenario.enable_voice}}
                <span class="air-badge air-badge--voice">🎙️ Voice</span>
              {{/scenario.enable_voice}}
              <span class="air-badge air-badge--lang">🌐 {{scenario.language}}</span>
              {{#scenario.industry}}
                <span class="air-badge" style="background:#f3f4f6;color:#374151">{{scenario.industry}}</span>
              {{/scenario.industry}}
            </div>

            {{#scenario.intro}}
              <div class="text-muted" style="font-size:0.9375rem;line-height:1.6">
                {{{scenario.intro}}}
              </div>
            {{/scenario.intro}}
          </div>

        </div>

        {{! Scenario meta row }}
        <div class="row g-3 mt-3 pt-3" style="border-top:1px solid #f1f5f9">
          {{#scenario.max_attempts}}
            <div class="col-6 col-md-3">
              <div style="font-size:0.75rem;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:0.06em">Max Attempts</div>
              <div style="font-size:1.25rem;font-weight:800">{{scenario.max_attempts}}</div>
            </div>
          {{/scenario.max_attempts}}
          <div class="col-6 col-md-3">
            <div style="font-size:0.75rem;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:0.06em">Pass Score</div>
            <div style="font-size:1.25rem;font-weight:800">{{scenario.pass_score}}%</div>
          </div>
          {{#scenario.max_duration}}
            <div class="col-6 col-md-3">
              <div style="font-size:0.75rem;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:0.06em">Time Limit</div>
              <div style="font-size:1.25rem;font-weight:800">{{scenario.max_duration}}s</div>
            </div>
          {{/scenario.max_duration}}
          {{#scenario.max_turns}}
            <div class="col-6 col-md-3">
              <div style="font-size:0.75rem;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:0.06em">Max Turns</div>
              <div style="font-size:1.25rem;font-weight:800">{{scenario.max_turns}}</div>
            </div>
          {{/scenario.max_turns}}
        </div>

      </div>

      {{! Attempt history }}
      {{#has_attempts}}
        <div class="air-results-card">
          <div class="air-results-card__title">📋 Attempt History</div>
          <div class="air-sessions-table">
            <table>
              <thead>
                <tr>
                  <th>#</th>
                  <th>Score</th>
                  <th>Result</th>
                  <th>Duration</th>
                  <th>Date</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {{#attempts}}
                  <tr>
                    <td><strong>Attempt {{attempt}}</strong></td>
                    <td>
                      {{#score}}<strong>{{score}}/100</strong>{{/score}}
                      {{^score}}<span class="text-muted">—</span>{{/score}}
                    </td>
                    <td>
                      {{#passed}}<span class="badge bg-success">✓ Passed</span>{{/passed}}
                      {{^passed}}
                        {{#score}}<span class="badge bg-danger">✗ Failed</span>{{/score}}
                        {{^score}}<span class="badge bg-secondary">{{status_label}}</span>{{/score}}
                      {{/passed}}
                    </td>
                    <td>{{duration}}</td>
                    <td>{{date}}</td>
                    <td>
                      {{#can_view}}
                        <a href="{{wwwroot}}/mod/airoleplay/results.php?session={{id}}"
                           class="btn btn-sm btn-outline-primary">View Feedback</a>
                      {{/can_view}}
                    </td>
                  </tr>
                {{/attempts}}
              </tbody>
            </table>
          </div>
        </div>
      {{/has_attempts}}

    </div>

    {{! ============================================================ }}
    {{! RIGHT: CTA + Stats                                            }}
    {{! ============================================================ }}
    <div class="col-lg-4">

      {{! Start card }}
      <div class="air-results-card mb-3" style="text-align:center">

        {{#has_passed}}
          <div style="font-size:2.5rem;margin-bottom:0.5rem">🏆</div>
          <div style="font-weight:800;font-size:1.125rem;color:#065f46;margin-bottom:0.5rem">You've Passed!</div>
          <div style="font-size:0.875rem;color:#64748b;margin-bottom:1.25rem">
            Best score: <strong>{{best_score}}/100</strong>
          </div>
        {{/has_passed}}
        {{^has_passed}}
          {{#attempts_used}}
            <div style="font-size:0.875rem;color:#64748b;margin-bottom:1rem">
              {{attempts_used}} attempt(s) used
              {{#attempts_left}} · <strong>{{attempts_left}}</strong> remaining{{/attempts_left}}
            </div>
          {{/attempts_used}}
          {{^attempts_used}}
            <div style="font-size:1rem;color:#64748b;margin-bottom:1.25rem">
              Start your first attempt
            </div>
          {{/attempts_used}}
        {{/has_passed}}

        {{! Language selector }}
        {{#scenario.enable_voice}}
          <div class="mb-3 text-start">
            <label class="form-label" style="font-weight:600;font-size:0.875rem">🌐 Language</label>
            <select class="form-select form-select-sm" id="air-language-select">
              {{#supported_languages}}
                <option value="{{code}}" {{#selected}}selected{{/selected}}>{{name}}</option>
              {{/supported_languages}}
            </select>
          </div>
        {{/scenario.enable_voice}}

        {{#can_attempt}}
          <form action="{{start_url}}" method="post" id="air-start-form">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="language" id="air-lang-input" value="{{scenario.language}}">
            {{#scenario.enable_voice}}
              <div class="d-grid gap-2 mb-2">
                <button type="submit" name="type" value="voice" class="air-btn air-btn--primary" style="justify-content:center">
                  🎙️ Start Voice Roleplay
                </button>
                <button type="submit" name="type" value="chat" class="air-btn air-btn--ghost" style="justify-content:center">
                  💬 Start Chat Roleplay
                </button>
              </div>
            {{/scenario.enable_voice}}
            {{^scenario.enable_voice}}
              <button type="submit" name="type" value="chat" class="air-btn air-btn--primary w-100" style="justify-content:center;font-size:1rem;padding:0.875rem">
                🚀 Start Roleplay
              </button>
            {{/scenario.enable_voice}}
          </form>
        {{/can_attempt}}
        {{^can_attempt}}
          <button class="air-btn w-100" disabled style="justify-content:center;background:#f1f5f9;color:#94a3b8;cursor:not-allowed">
            {{#attempts_left}}No attempts remaining{{/attempts_left}}
            {{^attempts_left}}Not available{{/attempts_left}}
          </button>
        {{/can_attempt}}

      </div>

      {{! Time gates }}
      {{#scenario.timeopen}}
        <div class="air-results-card mb-3" style="font-size:0.875rem">
          <div class="air-results-card__title">⏰ Availability</div>
          <div><strong>Opens:</strong> {{scenario.timeopen}}</div>
          {{#scenario.timeclose}}<div><strong>Closes:</strong> {{scenario.timeclose}}</div>{{/scenario.timeclose}}
        </div>
      {{/scenario.timeopen}}

      {{! Manager / L&D actions }}
      {{#can_manage}}
        <div class="air-results-card">
          <div class="air-results-card__title">⚙️ Admin</div>
          <div class="d-grid gap-2">
            <a href="{{manage_url}}" class="air-btn air-btn--ghost" style="justify-content:center;font-size:0.875rem">
              ✏️ Edit Scenario
            </a>
            {{#can_view_reports}}
              <a href="{{reports_url}}" class="air-btn air-btn--ghost" style="justify-content:center;font-size:0.875rem">
                📊 View Reports
              </a>
            {{/can_view_reports}}
          </div>
        </div>
      {{/can_manage}}

    </div>

  </div>{{! row }}

</div>{{! .air-scenario-hub }}
</div>{{! .air-platform }}

<script>
// Sync language selector to hidden form input.
(function() {
  var sel = document.getElementById('air-language-select');
  var inp = document.getElementById('air-lang-input');
  if (sel && inp) {
    sel.addEventListener('change', function() { inp.value = this.value; });
  }
})();
</script>
