{{#lp_view_tab}}
  <div class="overview lp-ov">

    <!-- ===================== Overview hero card ===================== -->
    <div class="lp-ov-card">
      <div class="row description">
        <div class="col-sm-4 img-course lp-ov-media-col lp-custom-img">
          <div class="conten-img-lp lp-ov-media">
            {{#dataimage}}
              <img src="{{site_url}}//local/learningpaths/pluginfile.php?learningpathid={{dataid}}&t={{dataimg}}" class="img-responsive lp_img_description">
            {{/dataimage}}
          </div>
        </div>

        <div class="col-sm-8 conent-descriptionlp conent-descriptionlp-custom lp-ov-body">

          <div class="lp-ov-desc">
            <span class="lp-ov-desc-label">{{#str}}description, local_learningpaths{{/str}}</span>
            <div class="lp-ov-desc-text cusotm-lp-txt">{{{desc}}}</div>
            <div class="lp-ov-draft-badge">{{{publish_btn}}}</div>
          </div>

          <div class="lp-ov-tags">
            {{{lp_custom_properties_html}}}
          </div>

          <div class="propierty-lp lp-ov-stats">
            <div class="row propierty-first lp-ov-stats-row">
              <div class="col-sm-3 lp-stat-col">
                <div class="lp-stat-pill">
                  <span class="lp-stat-icon"><i class="wid wid-datelp fa fa-calendar" aria-hidden="true"></i></span>
                  <span class="lp-stat-text">
                    <small>{{#str}}startdate, local_learningpaths{{/str}}</small>
                    <strong>{{startdate}}</strong>
                  </span>
                </div>
              </div>
              <div class="col-sm-3 lp-stat-col">
                <div class="lp-stat-pill">
                  <span class="lp-stat-icon"><i class="wid wid-datelp fa fa-clock-o" aria-hidden="true"></i></span>
                  <span class="lp-stat-text">
                    <small>{{#str}}enddate, local_learningpaths{{/str}}</small>
                    <strong>{{endate}}</strong>
                  </span>
                </div>
              </div>
              <div class="col-sm-3 lp-stat-col">
                <div class="lp-stat-pill">
                  <span class="lp-stat-icon"><i class="wid wid-courselp fa fa-users" aria-hidden="true"></i></span>
                  <span class="lp-stat-text">
                    <small>{{#str}}total_users_, local_learningpaths{{/str}}</small>
                    <strong>{{data_total_users}}</strong>
                  </span>
                </div>
              </div>
              <div class="col-sm-3 lp-stat-col">
                <div class="lp-stat-pill">
                  <span class="lp-stat-icon"><i class="wid wid-courselp fa fa-star" aria-hidden="true"></i></span>
                  <span class="lp-stat-text">
                    <small>{{#str}}total_credits_, local_learningpaths{{/str}}</small>
                    <strong>{{datacredits}}</strong>
                  </span>
                </div>
              </div>
            </div>

            <div class="row propierty-second lp-ov-stats-row">
              <div class="col-sm-3 lp-stat-col">
                <div class="lp-stat-pill">
                  <span class="lp-stat-icon"><i class="wid wid-icon-phbook fa fa-book" aria-hidden="true"></i></span>
                  <span class="lp-stat-text">
                    <small>{{#str}}total_courses_, local_learningpaths{{/str}}</small>
                    <strong>{{data_total_courses}}</strong>
                  </span>
                </div>
              </div>
              <div class="col-sm-3 lp-stat-col">
                <div class="lp-stat-pill">
                  <span class="lp-stat-icon"><i class="wid wid-startlp fa fa-globe" aria-hidden="true"></i></span>
                  <span class="lp-stat-text">
                    <small>{{#str}}total_cohorts, local_learningpaths{{/str}}</small>
                    <strong>{{data_total_cohorts}}</strong>
                  </span>
                </div>
              </div>
              <div class="col-sm-3 lp-stat-col">
                <div class="lp-stat-pill">
                  <span class="lp-stat-icon"><i class="wid wid-exclamation-circle fa fa-check-circle" aria-hidden="true"></i></span>
                  <span class="lp-stat-text">
                    <small>{{#str}}required_, local_learningpaths{{/str}}</small>
                    <strong>{{data_total_courses_required}}</strong>
                  </span>
                </div>
              </div>
              <div class="col-sm-3 lp-stat-col">
                <div class="lp-stat-pill">
                  <span class="lp-stat-icon"><i class="wid wid-icon-phbook fa fa-check-circle" aria-hidden="true"></i></span>
                  <span class="lp-stat-text">
                    <small>{{#str}}total_users, local_learningpaths{{/str}}</small>
                    <strong>{{total_users}}</strong>
                  </span>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- ===================== Dashboard / courses table ===================== -->
    <div class="row">
      <div class="col-sm-12 title-block lp-dash-header">
        <div class="lp-dash-heading">
          <h4>{{#str}}dashboard, local_learningpaths{{/str}}</h4>
          <p class="lp-dash-subtitle">Courses assigned to this learning path</p>
        </div>
        <span class="edit lp-dash-edit">
          <a id="courses-tab-button" data-toggle="tab" data-bs-toggle="tab" href="#learningpath-courses-tab"><i class="fa fa-edit" aria-hidden="true"></i></a>
        </span>
      </div>

      <div class="block-lpd col-sm-12">
        <div class="block_lpd_content lp-dash-card custom-course-table" id="block_lpd_content">
          {{{lpd_text_html}}}
        </div>
      </div>
    </div>
  </div>
{{/lp_view_tab}}