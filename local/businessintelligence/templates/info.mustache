{{!
    @template local_businessintelligence/info

    Small (i) button with a hover / focus tooltip.

    Context variables required for this template:
    * info - tooltip text
    * iconinfo - info icon SVG (inherited from parent context)

    Example context (json):
    {
        "info": "Learners with activity in the selected period.",
        "iconinfo": "<svg></svg>"
    }
}}
<span class="lbi-info">
    <button type="button" class="lbi-info-btn" aria-label="{{#str}}moreinfo, local_businessintelligence{{/str}}" aria-describedby="lbi-tip-{{uniqid}}-{{key}}{{tipid}}">{{{iconinfo}}}</button>
    <span class="lbi-tip" role="tooltip" id="lbi-tip-{{uniqid}}-{{key}}{{tipid}}">{{info}}</span>
</span>
