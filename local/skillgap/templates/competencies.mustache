{{! @template local_skillgap/competencies - competency + sub-competency hierarchy manager (Figma UI) }}
<style>
  .local-skillgap-comp{
    --sg-navy-1:#0A1F3D;
    --sg-navy-2:#0D2647;
    --sg-navy-soft:#12365C;
    --sg-orange:#F5A623;
    --sg-orange-light:#FDF1DC;
    --sg-blue:#2F6FED;
    --sg-blue-light:#EAF0FE;
    --sg-green:#1E9E58;
    --sg-green-light:#E7F8EE;
    --sg-amber:#B45309;
    --sg-amber-light:#FEF3DC;
    --sg-red:#E5484D;
    --sg-red-light:#FDEAEA;
    --sg-gray-light:#EEF1F5;
    --sg-gray-bg:#F5F7FA;
    --sg-border:#E7EBF1;
    --sg-text-muted:#8A93A3;
    --sg-text-dark:#1B2A41;
    font-family:inherit;color:var(--sg-text-dark);background:var(--sg-gray-bg);
    padding:24px;border-radius:14px;
  }
  .local-skillgap-comp *{box-sizing:border-box;}
 #page-local-skillgap-admin-competencies div[role="main"] {
    filter: none;
    padding: 0px !important;
    box-shadow: none !important;
    background: #f6f8fc;
}
  /* ── Page header ── */
  .sg-page-head{display:flex;align-items:center;gap:14px;margin-bottom:18px;}
  .sg-head-icon{width:46px;height:46px;border-radius:12px;background:var(--sg-orange-light);color:var(--sg-orange);
    display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;}
  .sg-page-head h2{margin:0;font-weight:800;font-size:26px;color:var(--sg-text-dark);}
  .sg-page-head .sg-sub{color:var(--sg-text-muted);font-size:13.5px;margin-top:2px;}

  /* ── Cards / filters ── */
  .sg-card{background:#fff;border:1px solid var(--sg-border);border-radius:14px;}
  .sg-filter{padding:18px 20px;display:flex;flex-wrap:wrap;align-items:flex-end;gap:16px;margin-bottom:18px;}
  .sg-field{flex:1 1 240px;min-width:200px;}
  .sg-field label{font-size:12.5px;font-weight:700;color:var(--sg-text-dark);display:block;margin-bottom:6px;}
  .sg-select{width:100%;border:1px solid var(--sg-border);border-radius:10px;padding:11px 14px;font-size:14px;background:#fff;color:var(--sg-text-dark);}
  /* searchable combo */
  .sg-combo{position:relative;width:100%;}
  .sg-combo-input{width:100%;border:1px solid var(--sg-border);border-radius:10px;padding:11px 34px 11px 14px;font-size:14px;background:#fff;color:var(--sg-text-dark);cursor:pointer;}
  .sg-combo-input::placeholder{color:var(--sg-text-muted);}
  .sg-combo-caret{position:absolute;right:14px;top:50%;transform:translateY(-50%);color:var(--sg-text-muted);font-size:12px;pointer-events:none;}
  .sg-combo-panel{position:absolute;left:0;right:0;top:calc(100% + 4px);background:#fff;border:1px solid var(--sg-border);
    border-radius:10px;box-shadow:0 8px 24px rgba(10,31,61,.12);max-height:260px;overflow-y:auto;z-index:60;display:none;}
  .sg-combo.open .sg-combo-panel{display:block;}
  .sg-combo-opt{padding:10px 14px;font-size:13.5px;cursor:pointer;border-bottom:1px solid var(--sg-gray-light);}
  .sg-combo-opt:last-child{border-bottom:none;}
  .sg-combo-opt:hover,.sg-combo-opt.active{background:var(--sg-blue-light);color:var(--sg-navy-1);}
  .sg-combo-empty{padding:12px 14px;color:var(--sg-text-muted);font-size:13px;}
  .sg-btn-navy{display:inline-flex;align-items:center;gap:7px;background:var(--sg-navy-1);border:1px solid var(--sg-navy-1);
    border-radius:10px;padding:11px 22px;font-size:13.5px;font-weight:600;color:#fff;}
  .sg-btn-navy:hover{background:var(--sg-navy-2);color:#fff;}

  /* ── Add competency card ── */
  .sg-add-card{padding:18px 20px;}
  .sg-add-title{font-weight:700;font-size:15px;color:var(--sg-text-dark);display:flex;align-items:center;gap:8px;margin-bottom:16px;}
  .sg-add-title i{color:var(--sg-orange);}
  .sg-add-card label{font-size:12.5px;font-weight:700;color:var(--sg-text-dark);display:block;margin-bottom:6px;}
  .sg-input,.sg-textarea{width:100%;border:1px solid var(--sg-border);border-radius:10px;padding:10px 14px;font-size:13.5px;background:#fff;color:var(--sg-text-dark);}
  .sg-textarea{resize:vertical;min-height:110px;}
  .sg-btn-block{width:100%;justify-content:center;margin-top:6px;}

  /* ── Accordion (main competency) ── */
  .sg-acc{border-radius:12px;overflow:hidden;border-left:4px solid var(--sg-orange);margin-bottom:14px;
    box-shadow:0 1px 3px rgba(10,31,61,.06);}
  .sg-acc-head{background:var(--sg-navy-1);color:#fff;padding:14px 18px;display:flex;align-items:center;
    justify-content:space-between;flex-wrap:wrap;gap:10px;cursor:pointer;}
  .sg-acc-head-left{display:flex;align-items:center;gap:12px;min-width:0;}
  .sg-acc-caret{color:#fff;font-size:15px;transition:transform .18s;flex-shrink:0;}
  .sg-acc.open .sg-acc-caret{transform:rotate(90deg);}
  .sg-acc-title{font-weight:700;font-size:15px;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .sg-acc-head-right{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
  .sg-acc-body{background:#fff;border:1px solid var(--sg-border);border-top:none;border-radius:0 0 10px 10px;
    padding:18px 20px;display:none;}
  .sg-acc.open .sg-acc-body{display:block;}

  /* pills on navy header */
  .sg-pill-q{background:var(--sg-green);color:#fff;border-radius:20px;font-size:11.5px;font-weight:700;padding:4px 12px;white-space:nowrap;}
  .sg-pill-q.sg-warn{background:var(--sg-orange);}
  .sg-pill-sub{background:var(--sg-navy-soft);color:#cbd8e8;border-radius:20px;font-size:11.5px;font-weight:600;padding:4px 12px;white-space:nowrap;}
  .sg-hdr-btn{display:inline-flex;align-items:center;gap:6px;background:transparent;border:1px solid rgba(255,255,255,.4);
    border-radius:8px;padding:6px 12px;font-size:12.5px;font-weight:600;color:#fff;text-decoration:none;}
  .sg-hdr-btn:hover{background:rgba(255,255,255,.12);color:#fff;text-decoration:none;}
  .sg-hdr-circle{width:34px;height:34px;border-radius:8px;background:#fff;border:none;display:inline-flex;
    align-items:center;justify-content:center;font-size:13px;color:var(--sg-navy-1);}
  .sg-hdr-circle.sg-del{color:var(--sg-red);}
  .sg-hdr-circle:hover{background:#f1f3f7;}

  /* ── Course mapping (main) ── */
  .sg-map-label{font-size:12px;font-weight:700;color:var(--sg-text-muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:8px;}
  .sg-course-badge{display:inline-flex;align-items:center;gap:6px;background:var(--sg-gray-light);color:var(--sg-text-dark);
    border-radius:20px;font-size:12px;font-weight:600;padding:4px 12px;margin:0 6px 6px 0;}
  .sg-course-badge a{color:var(--sg-text-muted);text-decoration:none;font-weight:700;}
  .sg-map-row{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:6px;}
  .sg-select-sm{border:1px solid var(--sg-border);border-radius:10px;padding:8px 12px;font-size:13px;background:#fff;min-width:220px;max-width:100%;}
  .sg-btn-orange{display:inline-flex;align-items:center;gap:6px;background:var(--sg-orange);border:none;border-radius:10px;
    padding:9px 16px;font-size:13px;font-weight:600;color:#fff;}
  .sg-btn-orange:hover{background:#e0940e;color:#fff;}
  .sg-divider{border:none;border-top:1px solid var(--sg-border);margin:16px 0;}

  /* ── Hierarchy section ── */
  .sg-hier-head{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:12px;}
  .sg-hier-label{font-size:12px;font-weight:700;color:var(--sg-text-muted);text-transform:uppercase;letter-spacing:.5px;}
  .sg-btn-outline{display:inline-flex;align-items:center;gap:6px;background:#fff;border:1px solid var(--sg-border);border-radius:10px;
    padding:8px 14px;font-size:12.5px;font-weight:600;color:var(--sg-text-dark);text-decoration:none;}
  .sg-btn-outline:hover{border-color:var(--sg-navy-1);color:var(--sg-text-dark);text-decoration:none;}
  .sg-btn-outline i{color:var(--sg-text-muted);}

  /* ── Sub-competency accordion ── */
  .sg-sub{border:1px solid var(--sg-border);border-left:3px solid var(--sg-orange);border-radius:10px;margin-bottom:10px;overflow:hidden;}
  .sg-sub-head{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;padding:12px 14px;
    background:#fff;cursor:pointer;}
  .sg-sub.open .sg-sub-head{background:#F8FAFC;}
  .sg-sub-head-left{display:flex;align-items:center;gap:10px;min-width:0;}
  .sg-sub-caret{color:var(--sg-text-muted);font-size:13px;transition:transform .18s;}
  .sg-sub.open .sg-sub-caret{transform:rotate(90deg);}
  .sg-sub-name{font-weight:700;font-size:13.5px;color:var(--sg-text-dark);}
  .sg-sub-head-right{display:flex;align-items:center;gap:6px;flex-wrap:wrap;}
  .sg-sqc-pill{background:var(--sg-green);color:#fff;border-radius:20px;font-size:11px;font-weight:700;padding:3px 10px;white-space:nowrap;}
  .sg-sqc-pill.sg-warn{background:var(--sg-orange);}
  .sg-sqc-pill.sg-zero{background:var(--sg-gray-light);color:var(--sg-text-muted);}
  .sg-sub-btn{display:inline-flex;align-items:center;gap:5px;background:#fff;border:1px solid var(--sg-border);border-radius:8px;
    padding:5px 11px;font-size:12px;font-weight:600;color:var(--sg-text-dark);text-decoration:none;}
  .sg-sub-btn:hover{border-color:var(--sg-navy-1);color:var(--sg-text-dark);text-decoration:none;}
  .sg-circle{width:32px;height:32px;border-radius:8px;background:#fff;border:1px solid var(--sg-border);display:inline-flex;
    align-items:center;justify-content:center;font-size:12px;color:var(--sg-text-dark);}
  .sg-circle:hover{border-color:var(--sg-navy-1);}
  .sg-circle.sg-del{border-color:var(--sg-red-light);color:var(--sg-red);}
  .sg-circle.sg-del:hover{background:var(--sg-red-light);}
  .sg-sub-body{padding:12px 14px;border-top:1px solid var(--sg-border);background:#fff;display:none;}
  .sg-sub.open .sg-sub-body{display:block;}

  .sg-courses-line{font-size:12.5px;color:var(--sg-text-muted);margin-bottom:8px;display:flex;flex-wrap:wrap;align-items:center;gap:6px;}
  .sg-course-badge-info{display:inline-flex;align-items:center;gap:6px;background:var(--sg-blue-light);color:var(--sg-blue);
    border-radius:20px;font-size:11.5px;font-weight:600;padding:3px 10px;}
  .sg-course-badge-info a{color:var(--sg-blue);text-decoration:none;font-weight:700;}

  /* ── Sub-sub rows ── */
  .sg-subsub{border:1px solid var(--sg-border);border-left:3px solid var(--sg-orange);border-radius:8px;margin:8px 0 0 22px;overflow:hidden;}
  .sg-subsub-head{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;padding:10px 12px;background:#FFFBF3;}
  .sg-subsub-name{font-size:12.5px;color:var(--sg-text-dark);font-weight:600;}
  .sg-subsub-courses{padding:8px 12px;border-top:1px solid var(--sg-border);background:#fff;}

  .sg-inline-form{margin-top:10px;display:none;}
  .sg-inline-form.show{display:block;}
  .sg-csv-panel{margin-bottom:14px;display:none;}
  .sg-csv-panel.show{display:block;}
  .sg-csv-inner{border:1px dashed var(--sg-orange);border-radius:10px;padding:14px;background:var(--sg-orange-light);}

  .sg-add-sub-row{margin-top:12px;display:flex;flex-wrap:wrap;gap:8px;}

  .sg-empty{color:var(--sg-text-muted);font-size:13px;padding:10px 0;}
  .sg-alert-warn{background:var(--sg-orange-light);border:1px solid #F3D89A;border-radius:12px;padding:14px 18px;
    font-size:13.5px;color:#8a5a00;display:flex;align-items:flex-start;gap:10px;}
  .sg-alert-warn i{color:var(--sg-orange);margin-top:2px;}
  .sg-alert-info{background:var(--sg-blue-light);border:1px solid #D7E3FB;border-radius:12px;padding:14px 18px;font-size:13.5px;color:#2B4B8A;}
</style>

<div class="local-skillgap-comp p-0">

  {{! ── Page header ── }}
  <div class="sg-page-head">
    <div class="sg-head-icon"><i class="fa fa-star"></i></div>
    <div>
      <h2>{{#str}} competencies, local_skillgap {{/str}}</h2>
      <div class="sg-sub">Build competencies and manage their sub-competency hierarchy.</div>
    </div>
  </div>

  {{! ── Filters ── }}
  <div class="sg-card sg-filter">
    <form method="get" action="{{{wwwroot}}}/local/skillgap/admin/competencies.php"
          class="d-flex flex-wrap align-items-end" style="gap:16px;width:100%;">
      <div class="sg-field">
        <label>{{#str}} department, local_skillgap {{/str}}</label>
        <input type="hidden" name="deptid" id="sg-dept-value" value="{{selected_deptid}}">
        <div class="sg-combo" id="sg-dept-combo"
             data-options='[{{#dept_options}}{"id":"{{id}}","name":"{{name}}"{{#selected}},"sel":1{{/selected}}},{{/dept_options}}{"id":"","name":""}]'>
          <input type="text" class="sg-combo-input" id="sg-dept-input" placeholder="Search department..." autocomplete="off" readonly>
          <i class="fa fa-chevron-down sg-combo-caret"></i>
          <div class="sg-combo-panel" id="sg-dept-panel"></div>
        </div>
      </div>
      <div class="sg-field">
        <label>{{#str}} designation, local_skillgap {{/str}}</label>
        <input type="hidden" name="desigid" id="sg-desig-value" value="{{selected_desigid}}">
        <div class="sg-combo" id="sg-desig-combo"
             data-options='[{{#desig_options}}{"id":"{{id}}","name":"{{name}}"{{#selected}},"sel":1{{/selected}}},{{/desig_options}}{"id":"","name":""}]'>
          <input type="text" class="sg-combo-input" id="sg-desig-input" placeholder="Search designation..." autocomplete="off" readonly>
          <i class="fa fa-chevron-down sg-combo-caret"></i>
          <div class="sg-combo-panel" id="sg-desig-panel"></div>
        </div>
      </div>
      <div><button type="submit" class="sg-btn-navy"><i class="fa fa-search"></i>Load</button></div>
    </form>
  </div>

  {{#has_filter}}
  <div class="row">
    {{! ── Add competency ── }}
    <div class="col-12 col-md-4 mb-4">
      <div class="sg-card sg-add-card">
        <div class="sg-add-title"><i class="fa fa-plus-circle"></i>Add Main Competency</div>
        <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/competencies.php?deptid={{selected_deptid}}&desigid={{selected_desigid}}">
          <input type="hidden" name="action"  value="save_comp">
          <input type="hidden" name="sesskey" value="{{sesskey}}">
          <div class="mb-3">
            <label>{{#str}} competency_name, local_skillgap {{/str}} <span style="color:var(--sg-red);">*</span></label>
            <input type="text" name="name" class="sg-input" required placeholder="e.g. Leadership">
          </div>
          <div class="mb-3">
            <label>{{#str}} description, local_skillgap {{/str}}</label>
            <textarea name="description" class="sg-textarea" placeholder="Brief description..."></textarea>
          </div>
          <button type="submit" class="sg-btn-navy sg-btn-block"><i class="fa fa-save"></i>{{#str}} save, local_skillgap {{/str}}</button>
        </form>
      </div>
    </div>

    {{! ── Competency list ── }}
    <div class="col-12 col-md-8 mb-4">
      {{#comp_rows}}
      <div class="sg-acc" data-load-subcomp-counts="{{id}}">
        {{! ── Main header ── }}
        <div class="sg-acc-head">
          <div class="sg-acc-head-left">
            <i class="fa fa-caret-right sg-acc-caret"></i>
            <span class="sg-acc-title">{{name}}</span>
          </div>
          <div class="sg-acc-head-right">
            <span class="sg-pill-q {{^has_5_questions}}sg-warn{{/has_5_questions}}">{{q_count}}/5 Questions</span>
            <span class="sg-pill-sub">{{sub_count}} Sub-Comps</span>
            <a href="{{{wwwroot}}}/local/skillgap/admin/questions.php?compid={{id}}" class="sg-hdr-btn"><i class="fa fa-question-circle"></i>Questions</a>
            <button type="button" class="sg-hdr-circle sg-edit-comp-btn"
                    data-id="{{id}}" data-name="{{name}}" data-description="{{description}}"
                    data-deptid="{{selected_deptid}}" data-desigid="{{selected_desigid}}"
                    data-sesskey="{{sesskey}}" data-wwwroot="{{{wwwroot}}}"><i class="fa fa-pencil"></i></button>
            <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/competencies.php?deptid={{selected_deptid}}&desigid={{selected_desigid}}"
                  class="d-inline" onsubmit="return confirm('Delete competency and all its sub-competencies?');">
              <input type="hidden" name="action"  value="delete_comp">
              <input type="hidden" name="id"      value="{{id}}">
              <input type="hidden" name="sesskey" value="{{sesskey}}">
              <button type="submit" class="sg-hdr-circle sg-del"><i class="fa fa-trash"></i></button>
            </form>
          </div>
        </div>

        {{! ── Main body ── }}
        <div class="sg-acc-body">
          {{#description}}<p class="text-muted small mb-3">{{description}}</p>{{/description}}

          {{! Main course mapping }}
          <div class="sg-map-label">{{#str}} mapped_courses, local_skillgap {{/str}}</div>
          <div>
            {{#mapped_courses}}
            <span class="sg-course-badge">{{coursename}}
              <a href="{{{wwwroot}}}/local/skillgap/admin/competencies.php?deptid={{selected_deptid}}&desigid={{selected_desigid}}&action=unmap_course&compid={{compid_val}}&courseid={{courseid}}&sesskey={{sesskey_val}}" title="Remove">&times;</a>
            </span>
            {{/mapped_courses}}
            {{^has_courses}}<span class="text-muted small">None</span>{{/has_courses}}
          </div>
          <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/competencies.php?deptid={{selected_deptid}}&desigid={{selected_desigid}}" class="sg-map-row">
            <input type="hidden" name="action"  value="map_course">
            <input type="hidden" name="compid"  value="{{id}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <select name="courseid" class="sg-select-sm">{{#course_options}}<option value="{{id}}">{{name}}</option>{{/course_options}}</select>
            <button type="submit" class="sg-btn-orange"><i class="fa fa-link"></i>Map Course</button>
          </form>

          <hr class="sg-divider">

          {{! Hierarchy header }}
          <div class="sg-hier-head">
            <span class="sg-hier-label">Sub-Competency Hierarchy</span>
            <div class="d-flex" style="gap:8px;">
              <button type="button" class="sg-btn-orange sg-show-csv-upload" data-compid="{{id}}"><i class="fa fa-upload"></i>CSV Upload</button>
              <a href="{{{wwwroot}}}/local/skillgap/admin/download_sample.php?type=subcomps" class="sg-btn-outline"><i class="fa fa-download"></i>Sample CSV</a>
            </div>
          </div>

          {{! CSV panel }}
          <div class="sg-csv-panel" id="sg-csv-panel-{{id}}">
            <div class="sg-csv-inner">
              <p class="small text-muted mb-2">CSV format: <strong>Sub-Competency, Sub-Sub-Competency</strong> (header row required)</p>
              <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/competencies.php?deptid={{selected_deptid}}&desigid={{selected_desigid}}" enctype="multipart/form-data" class="d-flex flex-wrap align-items-center" style="gap:8px;">
                <input type="hidden" name="action"  value="upload_csv_sub">
                <input type="hidden" name="compid"  value="{{id}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="file" name="csvfile" class="form-control-file" accept=".csv" required>
                <button type="submit" class="sg-btn-orange"><i class="fa fa-upload"></i>Import</button>
              </form>
            </div>
          </div>

          {{! Sub-competency accordions }}
          {{#sub_trees}}
          <div class="sg-sub">
            <div class="sg-sub-head">
              <div class="sg-sub-head-left">
                <i class="fa fa-caret-right sg-sub-caret"></i>
                <span class="sg-sub-name">{{sub_name}}</span>
              </div>
              <div class="sg-sub-head-right">
                <span class="sg-sqc-pill sg-zero" id="sg-sqc-{{sub_id}}">0/5 Q</span>
                <a href="{{{wwwroot}}}/local/skillgap/admin/subcomp_questions.php?subcompid={{sub_id}}&compid={{comp_id}}&deptid={{deptid}}&desigid={{desigid}}" class="sg-sub-btn"><i class="fa fa-question-circle"></i>Questions</a>
                <button type="button" class="sg-circle sg-edit-subcomp-btn" data-id="{{sub_id}}"><i class="fa fa-pencil"></i></button>
                <button type="button" class="sg-circle sg-add-subsub-btn" data-parentsubid="{{sub_id}}"><i class="fa fa-plus"></i></button>
                <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/competencies.php?deptid={{deptid}}&desigid={{desigid}}"
                      class="d-inline" onsubmit="return confirm('Delete this sub-competency?');">
                  <input type="hidden" name="action"  value="delete_sub">
                  <input type="hidden" name="subid"   value="{{sub_id}}">
                  <input type="hidden" name="sesskey" value="{{sesskey}}">
                  <button type="submit" class="sg-circle sg-del"><i class="fa fa-trash"></i></button>
                </form>
              </div>
            </div>

            <div class="sg-sub-body">
              {{! Sub inline edit }}
              <div class="sg-inline-form" id="sg-edit-sub-form-{{sub_id}}">
                <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/competencies.php?deptid={{deptid}}&desigid={{desigid}}" class="d-flex flex-wrap align-items-center" style="gap:8px;">
                  <input type="hidden" name="action"  value="update_sub">
                  <input type="hidden" name="subid"   value="{{sub_id}}">
                  <input type="hidden" name="sesskey" value="{{sesskey}}">
                  <input type="text" name="subname" class="sg-select-sm" value="{{sub_name}}" required>
                  <button type="submit" class="sg-btn-navy" style="padding:8px 14px;"><i class="fa fa-save"></i>Save</button>
                  <button type="button" class="sg-btn-outline sg-cancel-inline" data-target="sg-edit-sub-form-{{sub_id}}">Cancel</button>
                </form>
              </div>

              {{! Sub course mapping }}
              <div class="sg-courses-line">
                <span><i class="fa fa-link mr-1"></i>Courses:</span>
                {{#sub_mapped_courses}}
                <span class="sg-course-badge-info">{{coursename}}
                  <a href="{{{wwwroot}}}/local/skillgap/admin/competencies.php?deptid={{selected_deptid}}&desigid={{selected_desigid}}&action=unmap_subcomp_course&subcompid={{subcompid_val}}&courseid={{courseid}}&sesskey={{sesskey_val}}" title="Remove">&times;</a>
                </span>
                {{/sub_mapped_courses}}
                {{^sub_has_courses}}<span>None mapped</span>{{/sub_has_courses}}
              </div>
              <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/competencies.php?deptid={{deptid}}&desigid={{desigid}}" class="sg-map-row">
                <input type="hidden" name="action"    value="map_subcomp_course">
                <input type="hidden" name="subcompid" value="{{sub_id}}">
                <input type="hidden" name="sesskey"   value="{{sesskey}}">
                <select name="courseid" class="sg-select-sm"><option value="">-- Map a course --</option>{{#course_options}}<option value="{{id}}">{{name}}</option>{{/course_options}}</select>
                <button type="submit" class="sg-btn-orange"><i class="fa fa-link"></i>Map</button>
              </form>

              {{! Add sub-sub }}
              <div class="sg-inline-form" id="sg-add-subsub-form-{{sub_id}}">
                <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/competencies.php?deptid={{deptid}}&desigid={{desigid}}" class="d-flex flex-wrap align-items-center" style="gap:8px;">
                  <input type="hidden" name="action"      value="save_sub">
                  <input type="hidden" name="compid"      value="{{comp_id}}">
                  <input type="hidden" name="parentsubid" value="{{sub_id}}">
                  <input type="hidden" name="sesskey"     value="{{sesskey}}">
                  <input type="text" name="subname" class="sg-select-sm" placeholder="Sub-sub competency name..." required>
                  <button type="submit" class="sg-btn-navy" style="padding:8px 14px;"><i class="fa fa-plus"></i>Add</button>
                  <button type="button" class="sg-btn-outline sg-cancel-inline" data-target="sg-add-subsub-form-{{sub_id}}">Cancel</button>
                </form>
              </div>

              {{! Sub-subs }}
              {{#sub_subs}}
              <div class="sg-subsub">
                <div class="sg-subsub-head">
                  <div class="d-flex align-items-center" style="gap:8px;min-width:0;">
                    <i class="fa fa-angle-right text-muted"></i>
                    <span class="sg-subsub-name">{{subsub_name}}</span>
                  </div>
                  <div class="d-flex align-items-center" style="gap:6px;flex-wrap:wrap;">
                    <span class="sg-sqc-pill sg-zero" id="sg-sqc-{{subsub_id}}">0/5 Q</span>
                    <a href="{{{wwwroot}}}/local/skillgap/admin/subcomp_questions.php?subcompid={{subsub_id}}&compid={{comp_id}}&deptid={{deptid}}&desigid={{desigid}}" class="sg-sub-btn"><i class="fa fa-question-circle"></i>Q</a>
                    <button type="button" class="sg-circle sg-edit-subcomp-btn" data-id="{{subsub_id}}"><i class="fa fa-pencil"></i></button>
                    <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/competencies.php?deptid={{deptid}}&desigid={{desigid}}"
                          class="d-inline" onsubmit="return confirm('Delete this sub-sub-competency?');">
                      <input type="hidden" name="action"  value="delete_sub">
                      <input type="hidden" name="subid"   value="{{subsub_id}}">
                      <input type="hidden" name="sesskey" value="{{sesskey}}">
                      <button type="submit" class="sg-circle sg-del"><i class="fa fa-trash"></i></button>
                    </form>
                  </div>
                </div>
                <div class="sg-subsub-courses">
                  <div class="sg-inline-form" id="sg-edit-sub-form-{{subsub_id}}">
                    <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/competencies.php?deptid={{deptid}}&desigid={{desigid}}" class="d-flex flex-wrap align-items-center" style="gap:8px;margin-bottom:8px;">
                      <input type="hidden" name="action"  value="update_sub">
                      <input type="hidden" name="subid"   value="{{subsub_id}}">
                      <input type="hidden" name="sesskey" value="{{sesskey}}">
                      <input type="text" name="subname" class="sg-select-sm" value="{{subsub_name}}" required>
                      <button type="submit" class="sg-btn-navy" style="padding:8px 14px;"><i class="fa fa-save"></i>Save</button>
                      <button type="button" class="sg-btn-outline sg-cancel-inline" data-target="sg-edit-sub-form-{{subsub_id}}">Cancel</button>
                    </form>
                  </div>
                  <div class="sg-courses-line">
                    <span><i class="fa fa-link mr-1"></i>Courses:</span>
                    {{#subsub_mapped_courses}}
                    <span class="sg-course-badge-info">{{coursename}}
                      <a href="{{{wwwroot}}}/local/skillgap/admin/competencies.php?deptid={{selected_deptid}}&desigid={{selected_desigid}}&action=unmap_subcomp_course&subcompid={{subcompid_val}}&courseid={{courseid}}&sesskey={{sesskey_val}}" title="Remove">&times;</a>
                    </span>
                    {{/subsub_mapped_courses}}
                    {{^subsub_has_courses}}<span>None mapped</span>{{/subsub_has_courses}}
                  </div>
                  <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/competencies.php?deptid={{deptid}}&desigid={{desigid}}" class="sg-map-row">
                    <input type="hidden" name="action"    value="map_subcomp_course">
                    <input type="hidden" name="subcompid" value="{{subsub_id}}">
                    <input type="hidden" name="sesskey"   value="{{sesskey}}">
                    <select name="courseid" class="sg-select-sm"><option value="">-- Map a course --</option>{{#course_options}}<option value="{{id}}">{{name}}</option>{{/course_options}}</select>
                    <button type="submit" class="sg-btn-orange"><i class="fa fa-link"></i>Map</button>
                  </form>
                </div>
              </div>
              {{/sub_subs}}
            </div>
          </div>
          {{/sub_trees}}
          {{^sub_trees}}<p class="sg-empty"><i class="fa fa-info-circle mr-1"></i>No sub-competencies yet.</p>{{/sub_trees}}

          {{! Add sub-competency }}
          <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/competencies.php?deptid={{selected_deptid}}&desigid={{selected_desigid}}" class="sg-add-sub-row">
            <input type="hidden" name="action"  value="save_sub">
            <input type="hidden" name="compid"  value="{{id}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="text" name="subname" class="sg-select-sm" placeholder="Add sub-competency...">
            <button type="submit" class="sg-btn-outline"><i class="fa fa-plus"></i>Add Sub</button>
          </form>
        </div>
      </div>
      {{/comp_rows}}
      {{^comp_rows}}<div class="sg-alert-info">No competencies yet. Add one on the left.</div>{{/comp_rows}}
    </div>
  </div>
  {{/has_filter}}
  {{^has_filter}}
  <div class="sg-alert-warn"><i class="fa fa-arrow-up"></i><span>Select a Department and Designation above to manage competencies.</span></div>
  {{/has_filter}}

  {{! ── Edit main competency modal ── }}
  <div class="modal fade" id="sg-edit-comp-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header" style="background:var(--sg-navy-1);color:#fff;">
          <h5 class="modal-title"><i class="fa fa-pencil mr-2" style="color:var(--sg-orange);"></i>Edit Competency</h5>
          <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
        </div>
        <div class="modal-body">
          <form method="post" id="sg-edit-comp-form">
            <input type="hidden" name="action"  value="save_comp">
            <input type="hidden" name="editid"  id="sg-edit-comp-editid">
            <input type="hidden" name="sesskey" id="sg-edit-comp-sesskey">
            <div class="mb-3"><label class="font-weight-bold">Name <span style="color:var(--sg-red);">*</span></label>
              <input type="text" name="name" id="sg-edit-comp-name" class="sg-input" required></div>
            <div class="mb-3"><label class="font-weight-bold">Description</label>
              <textarea name="description" id="sg-edit-comp-description" class="sg-textarea"></textarea></div>
            <button type="submit" class="sg-btn-navy sg-btn-block"><i class="fa fa-save"></i>Save Changes</button>
          </form>
        </div>
      </div>
    </div>
  </div>

</div>

<script>
(function() {
  var root = document.querySelector('.local-skillgap-comp');
  if (!root) { return; }
  var wwwroot = window.M && M.cfg ? M.cfg.wwwroot : '';
  var sesskey = window.M && M.cfg ? M.cfg.sesskey  : '';
  /* ── Searchable filter combos (Department + Designation) ── */
  function initCombo(comboId, inputId, panelId, valueId, submitOnPick) {
    var combo = document.getElementById(comboId);
    if (!combo) { return; }
    var input = document.getElementById(inputId);
    var panel = document.getElementById(panelId);
    var value = document.getElementById(valueId);
    var opts  = [];
    try { opts = (JSON.parse(combo.getAttribute('data-options')) || []).filter(function(o){ return o.id !== ''; }); } catch (e) {}
    var escC = function(s){ return String(s).replace(/</g,'&lt;').replace(/>/g,'&gt;'); };

    var preset = opts.filter(function(o){ return o.sel; })[0];
    if (preset) { input.value = preset.name; value.value = preset.id; }
    else if (value.value) { var cur0 = opts.filter(function(o){ return o.id === value.value; })[0]; if (cur0) { input.value = cur0.name; } }

    function render(f) {
      var q = (f || '').toLowerCase(), html = '';
      opts.forEach(function(o) {
        if (!q || o.name.toLowerCase().indexOf(q) !== -1) {
          html += '<div class="sg-combo-opt" data-id="' + o.id + '">' + escC(o.name) + '</div>';
        }
      });
      panel.innerHTML = html || '<div class="sg-combo-empty">No match.</div>';
    }
    function open() { combo.classList.add('open'); input.removeAttribute('readonly'); input.value=''; render(''); input.focus(); }
    function close() {
      combo.classList.remove('open'); input.setAttribute('readonly','readonly');
      var cur = opts.filter(function(o){ return o.id === value.value; })[0];
      input.value = cur ? cur.name : '';
    }
    input.addEventListener('click', function(e){ e.stopPropagation(); combo.classList.contains('open') ? close() : open(); });
    input.addEventListener('input', function(){ if (combo.classList.contains('open')) { render(this.value); } });
    panel.addEventListener('click', function(e){
      var opt = e.target.closest('.sg-combo-opt'); if (!opt) { return; }
      value.value = opt.getAttribute('data-id');
      var cur = opts.filter(function(o){ return o.id === value.value; })[0];
      input.value = cur ? cur.name : '';
      combo.classList.remove('open'); input.setAttribute('readonly','readonly');
      if (submitOnPick) { var frm = combo.closest('form'); if (frm) { frm.submit(); } }
    });
    document.addEventListener('click', function(e){ if (!combo.contains(e.target)) { close(); } });
  }
  initCombo('sg-dept-combo',  'sg-dept-input',  'sg-dept-panel',  'sg-dept-value',  true);
  initCombo('sg-desig-combo', 'sg-desig-input', 'sg-desig-panel', 'sg-desig-value', true);

  /* ── Main accordion toggle ── */
  root.querySelectorAll('.sg-acc-head').forEach(function(head) {
    head.addEventListener('click', function(e) {
      if (e.target.closest('button, a, form, select, input, textarea, label')) { return; }
      head.parentElement.classList.toggle('open');
    });
  });

  /* ── Sub accordion toggle ── */
  root.querySelectorAll('.sg-sub-head').forEach(function(head) {
    head.addEventListener('click', function(e) {
      if (e.target.closest('button, a, form, select, input, textarea, label')) { return; }
      head.parentElement.classList.toggle('open');
    });
  });

  function openSub(id) {
    var body = document.getElementById('sg-edit-sub-form-' + id) || document.getElementById('sg-add-subsub-form-' + id);
    if (!body) { return; }
    var sub = body.closest('.sg-sub');
    if (sub) { sub.classList.add('open'); }
  }

  /* ── CSV upload toggle ── */
  root.addEventListener('click', function(e) {
    var btn = e.target.closest('.sg-show-csv-upload');
    if (!btn) { return; }
    var panel = document.getElementById('sg-csv-panel-' + btn.getAttribute('data-compid'));
    if (panel) { panel.classList.toggle('show'); btn.closest('.sg-acc').classList.add('open'); }
  });

  /* ── Inline edit sub / add sub-sub ── */
  root.addEventListener('click', function(e) {
    var edit = e.target.closest('.sg-edit-subcomp-btn');
    if (edit) {
      var id = edit.getAttribute('data-id');
      openSub(id);
      var f = document.getElementById('sg-edit-sub-form-' + id);
      if (f) { f.classList.toggle('show'); }
      return;
    }
    var add = e.target.closest('.sg-add-subsub-btn');
    if (add) {
      var pid = add.getAttribute('data-parentsubid');
      openSub(pid);
      var af = document.getElementById('sg-add-subsub-form-' + pid);
      if (af) { af.classList.toggle('show'); }
    }
  });

  /* ── Cancel inline ── */
  root.addEventListener('click', function(e) {
    var btn = e.target.closest('.sg-cancel-inline');
    if (!btn) { return; }
    var el = document.getElementById(btn.getAttribute('data-target'));
    if (el) { el.classList.remove('show'); }
  });

  /* ── Edit main competency modal ── */
  root.addEventListener('click', function(e) {
    var btn = e.target.closest('.sg-edit-comp-btn');
    if (!btn) { return; }
    document.getElementById('sg-edit-comp-editid').value      = btn.getAttribute('data-id');
    document.getElementById('sg-edit-comp-sesskey').value     = btn.getAttribute('data-sesskey');
    document.getElementById('sg-edit-comp-name').value        = btn.getAttribute('data-name');
    document.getElementById('sg-edit-comp-description').value = btn.getAttribute('data-description') || '';
    document.getElementById('sg-edit-comp-form').action =
      btn.getAttribute('data-wwwroot') + '/local/skillgap/admin/competencies.php?deptid=' +
      btn.getAttribute('data-deptid') + '&desigid=' + btn.getAttribute('data-desigid');
    if (window.$ && $('#sg-edit-comp-modal').modal) { $('#sg-edit-comp-modal').modal('show'); }
  });

  /* ── Load sub-competency question counts (AJAX) ── */
  root.querySelectorAll('[data-load-subcomp-counts]').forEach(function(el) {
    var compid = el.getAttribute('data-load-subcomp-counts');
    fetch(wwwroot + '/local/skillgap/admin/ajax_helper.php?action=subcomp_question_counts&compid=' + compid + '&sesskey=' + sesskey)
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (!data || data.status !== 'ok') { return; }
        Object.keys(data.counts).forEach(function(sid) {
          var badge = document.getElementById('sg-sqc-' + sid);
          if (!badge) { return; }
          var n = data.counts[sid];
          badge.textContent = n + '/5 Q';
          badge.classList.remove('sg-zero', 'sg-warn');
          if (n === 0) { badge.classList.add('sg-zero'); }
          else if (n < 5) { badge.classList.add('sg-warn'); }
        });
      })
      .catch(function() {});
  });
})();
</script>
