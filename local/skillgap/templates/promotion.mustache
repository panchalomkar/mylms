{{!
  @template local_skillgap/promotion
  Promotion panel — shows all users, their readiness, current and next designation, and promote action.
}}
<div class="local-skillgap">
  <h3 class="mb-4"><i class="fa fa-arrow-up mr-2 text-success"></i>{{#str}} promotion, local_skillgap {{/str}}</h3>
  <div class="alert alert-info small">
    <i class="fa fa-info-circle mr-1"></i>
    Users are listed when they have assessment scores recorded. Readiness is calculated as the percentage of
    competencies marked <strong>Competent</strong>. A user with &ge;80% is considered <strong>Ready</strong>.
    Promoting a user updates their designation to the next level in the hierarchy and assigns any active
    assessments for that designation automatically.
  </div>
  <div class="card">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="thead-light">
            <tr>
              <th>{{#str}} user_name, local_skillgap {{/str}}</th>
              <th>{{#str}} department, local_skillgap {{/str}}</th>
              <th>Current Designation</th>
              <th>Next Designation</th>
              <th>{{#str}} readiness, local_skillgap {{/str}}</th>
              <th>Progress</th>
              <th>{{#str}} action, local_skillgap {{/str}}</th>
            </tr>
          </thead>
          <tbody>
            {{#promotion_users}}
            <tr>
              <td class="font-weight-medium">{{fullname}}</td>
              <td>{{department}}</td>
              <td>
                <span class="text-muted">{{current_desig}}</span>
              </td>
              <td>
                {{#has_next_desig}}
                <span class="font-weight-bold" style="color:#033252;">
                  <i class="fa fa-long-arrow-right mr-1" style="color:#eb980d;"></i>{{next_desig}}
                </span>
                {{/has_next_desig}}
                {{^has_next_desig}}
                <span class="text-muted small">Top level</span>
                {{/has_next_desig}}
              </td>
              <td><span class="badge badge-{{badge_class}}">{{readiness_label}}</span></td>
              <td>
                <div class="progress" style="height:8px;min-width:80px;">
                  <div class="progress-bar bg-{{badge_class}}" style="width:{{readiness_pct}}%;"></div>
                </div>
              </td>
              <td>
                {{#can_promote}}
                <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/promotion.php" class="d-inline"
                      onsubmit="return confirm('Promote {{fullname}} to {{next_desig}}?');">
                  <input type="hidden" name="action"  value="promote">
                  <input type="hidden" name="userid"  value="{{userid}}">
                  <input type="hidden" name="sesskey" value="{{sesskey}}">
                  <button type="submit" class="btn btn-sm btn-success">
                    <i class="fa fa-arrow-up mr-1"></i>{{#str}} promote, local_skillgap {{/str}}
                  </button>
                </form>
                {{/can_promote}}
                {{#already_promoted}}
                <span class="badge badge-success px-2 py-1">
                  <i class="fa fa-check mr-1"></i>Promoted recently
                </span>
                {{/already_promoted}}
                {{^can_promote}}{{^already_promoted}}<span class="text-muted small">Not ready</span>{{/already_promoted}}{{/can_promote}}
              </td>
            </tr>
            {{/promotion_users}}
            {{^has_promotions}}
            <tr><td colspan="7" class="text-center text-muted py-3">{{#str}} no_promotions, local_skillgap {{/str}}</td></tr>
            {{/has_promotions}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
