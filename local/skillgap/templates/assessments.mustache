{{!
  @template local_skillgap/assessments
  Assessment creation and management.
  After saving, user is redirected to questions.php to add questions.
}}
<div class="local-skillgap container-fluid px-0">

  <div class="d-flex align-items-center justify-content-between flex-wrap mb-4">
    <h3 class="mb-0" style="color:#033252;">
      <i class="fa fa-check-square-o mr-2" style="color:#eb980d;"></i>
      {{#str}} assessments, local_skillgap {{/str}}
    </h3>
    <a href="{{{wwwroot}}}/local/skillgap/admin/index.php" class="btn btn-outline-secondary btn-sm">
      <i class="fa fa-arrow-left mr-1"></i>{{#str}} admin_dashboard, local_skillgap {{/str}}
    </a>
  </div>

  <div class="alert py-2 small mb-4" style="background:#e8f1f8;border:1px solid #b5d4f4;border-radius:6px;">
    <i class="fa fa-info-circle mr-1" style="color:#033252;"></i>
    <strong>Workflow:</strong> Select competencies that already have 5 questions mapped.
    Each selected competency contributes exactly 5 questions to the assessment.
    Only competencies showing <span class="badge badge-success" style="font-size:10px;">5/5</span> can be selected.
  </div>

  <div class="row">
    {{! ── Create / Edit form ── }}
    <div class="col-12 col-lg-5 mb-4">
      <div class="card">
        <div class="card-header" style="background:#033252;color:#fff;">
          <h5 class="mb-0" id="sg-form-title"><i class="fa fa-plus-circle mr-2" style="color:#eb980d;"></i>{{#str}} add_assessment, local_skillgap {{/str}}</h5>
        </div>
        <div class="card-body">
          <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/assessments.php" id="sg-create-assessment-form">
            <input type="hidden" name="action"  value="save" id="sg-form-action">
            <input type="hidden" name="id"      value="" id="sg-edit-id">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="compids" id="sg-compids-input">

            <div class="form-group">
              <label class="font-weight-bold small">{{#str}} assessment_title, local_skillgap {{/str}} <span class="text-danger">*</span></label>
              <input type="text" name="title" class="form-control" required placeholder="e.g. Q3 Engineering Assessment">
            </div>

            <div class="form-group">
              <label class="font-weight-bold small">{{#str}} department, local_skillgap {{/str}} <span class="text-danger">*</span></label>
              <select name="deptid" id="sg-assess-dept" class="form-control" required>
                {{#dept_options}}
                <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                {{/dept_options}}
              </select>
            </div>

            <div class="form-group">
              <label class="font-weight-bold small">{{#str}} designation, local_skillgap {{/str}} <span class="text-danger">*</span></label>
              <select name="desigid" id="sg-assess-desig" class="form-control" required>
                <option value="">-- Select Department first --</option>
              </select>
            </div>

            <div class="form-group">
              <label class="font-weight-bold small">{{#str}} frequency, local_skillgap {{/str}} <span class="text-danger">*</span></label>
              <select name="frequency" class="form-control" required>
                <option value="quarterly">{{#str}} quarterly, local_skillgap {{/str}}</option>
                <option value="half_yearly">{{#str}} half_yearly, local_skillgap {{/str}}</option>
                <option value="yearly">{{#str}} yearly, local_skillgap {{/str}}</option>
              </select>
            </div>

            <div class="form-row">
              <div class="form-group col-md-6">
                <label class="font-weight-bold small">{{#str}} start_date, local_skillgap {{/str}} <span class="text-danger">*</span></label>
                <input type="date" name="startdate" id="sg-startdate" class="form-control" required>
              </div>
              <div class="form-group col-md-6">
                <label class="font-weight-bold small">{{#str}} end_date, local_skillgap {{/str}} <span class="text-danger">*</span></label>
                <input type="date" name="enddate" class="form-control" required>
              </div>
            </div>

            <div class="form-group">
              <label class="font-weight-bold small">{{#str}} select_competencies, local_skillgap {{/str}} <span class="text-danger">*</span></label>
              <div id="sg-comp-checkboxes"
                   class="border rounded p-3"
                   style="max-height:320px;overflow-y:auto;min-height:60px;background:#f8f9fa;">
                <p class="text-muted small mb-0">
                  <i class="fa fa-arrow-up mr-1"></i>Select department and designation above.
                </p>
              </div>
              <small class="text-muted">Select any combination of main, sub, and sub-sub competencies. Each selected competency contributes 5 questions.</small>
            </div>

            {{! Hierarchy preview table — shown after competencies selected }}
            <div id="sg-comp-preview" class="mb-3" style="display:none;">
              <label class="font-weight-bold small">Selected Competencies &amp; Questions:</label>
              <table class="table table-sm table-bordered mb-0">
                <thead class="thead-light">
                  <tr>
                    <th>Competency</th>
                    <th style="width:70px;">Level</th>
                    <th class="text-center" style="width:100px;">Questions</th>
                  </tr>
                </thead>
                <tbody id="sg-comp-preview-body"></tbody>
                <tfoot>
                  <tr class="font-weight-bold" style="background:#f8f9fa;">
                    <td colspan="2">Total Questions</td>
                    <td class="text-center" id="sg-comp-preview-total">0</td>
                  </tr>
                </tfoot>
              </table>
            </div>

            <button type="submit" class="btn btn-block font-weight-bold"
                    id="sg-submit-btn"
                    style="background:#eb980d;color:#fff;">
              <i class="fa fa-save mr-1"></i><span id="sg-submit-label">Save &amp; Add Questions</span>
            </button>
            <button type="button" class="btn btn-block btn-outline-secondary btn-sm mt-1"
                    id="sg-cancel-edit-btn" style="display:none;" onclick="sgResetForm()">
              <i class="fa fa-times mr-1"></i>Cancel Edit
            </button>
          </form>
        </div>
      </div>
    </div>

    {{! ── Assessment list ── }}
    <div class="col-12 col-lg-7 mb-4">
      <div class="card">
        <div class="card-header" style="background:#033252;color:#fff;">
          <h5 class="mb-0"><i class="fa fa-list-alt mr-2" style="color:#eb980d;"></i>All Assessments</h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
              <thead class="thead-light">
                <tr>
                  <th>{{#str}} assessment_title, local_skillgap {{/str}}</th>
                  <th>Dept / Designation</th>
                  <th>Freq</th>
                  <th>Competencies</th>
                  <th>Total Q</th>
                  <th>{{#str}} status, local_skillgap {{/str}}</th>
                  <th>{{#str}} action, local_skillgap {{/str}}</th>
                </tr>
              </thead>
              <tbody>
                {{#assessments}}
                <tr>
                  <td class="font-weight-medium">{{title}}</td>
                  <td><small class="text-muted">{{dept_name}}<br>{{desig_name}}</small></td>
                  <td><small>{{frequency}}</small></td>
                  <td>
                    {{! Show actual competency names, not just count }}
                    {{#comp_details}}
                    <span class="badge mr-1 mb-1 {{#has_5}}badge-success{{/has_5}}{{^has_5}}badge-warning{{/has_5}}"
                          title="{{q_count}}/5 questions" style="font-size:11px;">
                      {{cname}}
                      <small>({{q_count}}/5)</small>
                    </span>
                    {{/comp_details}}
                    {{^comp_details}}
                    <span class="text-muted small">—</span>
                    {{/comp_details}}
                  </td>
                  <td class="text-center">
                    <span class="badge badge-info">{{total_questions}}</span>
                  </td>
                  <td><span class="badge badge-{{status_badge}}">{{status_label}}</span></td>
                  <td>
                    <a href="{{{wwwroot}}}/local/skillgap/admin/questions.php?assessmentid={{id}}"
                       class="btn btn-sm mb-1" style="background:#033252;color:#fff;" title="Manage Questions">
                      <i class="fa fa-question-circle mr-1"></i>Questions
                    </a>
                    {{! Preview button }}
                    <button type="button" class="btn btn-sm btn-outline-info mb-1 sg-preview-assessment-btn"
                            data-id="{{id}}" data-sesskey="{{sesskey}}" title="Preview full assessment">
                      <i class="fa fa-eye mr-1"></i>Preview
                    </button>
                    {{! Edit button }}
                    <button type="button" class="btn btn-sm btn-outline-secondary mb-1 sg-edit-assessment-btn"
                            data-id="{{id}}"
                            data-title="{{title_val}}"
                            data-deptid="{{deptid_val}}"
                            data-desigid="{{desigid_val}}"
                            data-frequency="{{frequency_val}}"
                            data-startdate="{{startdate_val}}"
                            data-enddate="{{enddate_val}}"
                            data-compids="{{{compids_json}}}"
                            title="Edit this assessment">
                      <i class="fa fa-pencil mr-1"></i>Edit
                    </button>
                    {{! Competency Report button }}
                    <a href="{{{wwwroot}}}/local/skillgap/admin/assessment_report.php?assessmentid={{id}}"
                       class="btn btn-sm btn-outline-primary mb-1 d-none" title="View competency-wise report">
                      <i class="fa fa-bar-chart mr-1"></i>Report
                    </a>
                    {{! Publish button (only show when not yet active) }}
                    {{#is_draft}}
                    {{#can_publish}}
                    <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/assessments.php"
                          class="d-inline" onsubmit="return confirm('Publish this assessment? Users with matching department/designation will see it.');">
                      <input type="hidden" name="action"  value="publish">
                      <input type="hidden" name="id"      value="{{id}}">
                      <input type="hidden" name="sesskey" value="{{sesskey}}">
                      <button type="submit" class="btn btn-sm btn-success mb-1" title="Publish assessment">
                        <i class="fa fa-check-circle mr-1"></i>Publish
                      </button>
                    </form>
                    {{/can_publish}}
                    {{^can_publish}}
                    <span class="btn btn-sm btn-outline-secondary mb-1 disabled" title="Add 5 questions to all competencies first">
                      <i class="fa fa-lock mr-1"></i>Publish
                    </span>
                    {{/can_publish}}
                    {{/is_draft}}
                    {{#is_active}}
                    <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/assessments.php"
                          class="d-inline" onsubmit="return confirm('Move assessment back to Draft?');">
                      <input type="hidden" name="action"  value="unpublish">
                      <input type="hidden" name="id"      value="{{id}}">
                      <input type="hidden" name="sesskey" value="{{sesskey}}">
                      <button type="submit" class="btn btn-sm btn-outline-warning mb-1" title="Unpublish (move to Draft)">
                        <i class="fa fa-undo mr-1"></i>Unpublish
                      </button>
                    </form>
                    {{/is_active}}
                    {{! Delete button }}
                    <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/assessments.php"
                          class="d-inline" onsubmit="return confirm('Delete this assessment?');">
                      <input type="hidden" name="action"  value="delete">
                      <input type="hidden" name="id"      value="{{id}}">
                      <input type="hidden" name="sesskey" value="{{sesskey}}">
                      <button type="submit" class="btn btn-sm btn-outline-danger mb-1" title="Delete">
                        <i class="fa fa-trash"></i>
                      </button>
                    </form>
                  </td>
                </tr>
                {{/assessments}}
                {{^assessments}}
                <tr>
                  <td colspan="7" class="text-center text-muted py-4">
                    <i class="fa fa-inbox fa-2x mb-2 d-block"></i>
                    {{#str}} no_assessments, local_skillgap {{/str}}
                  </td>
                </tr>
                {{/assessments}}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

{{! ── Assessment Preview Modal ── }}
<div class="modal fade" id="sg-assessment-preview-modal" tabindex="-1" role="dialog"
     data-wwwroot="{{{wwwroot}}}">
  <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
    <div class="modal-content">
      <div class="modal-header p-2" style="background:#033252;color:#fff;">
        <h5 class="modal-title text-light">
          <i class="fa fa-eye mr-2" style="color:#eb980d;"></i>Assessment Preview
        </h5>
        <button type="button" class="close text-white" data-dismiss="modal" data-bs-dismiss="modal">&times;</button>
      </div>
      <div class="modal-body" id="sg-preview-modal-body">
        <div class="text-center py-5">
          <div class="spinner-border text-primary" role="status"></div>
          <p class="mt-2 text-muted small">Loading preview...</p>
        </div>
      </div>
      <div class="modal-footer" id="sg-preview-modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  // Read wwwroot from data attribute (triple-brace rendered, never HTML-escaped).
  var modal   = document.getElementById('sg-assessment-preview-modal');
  var wwwroot = modal ? modal.getAttribute('data-wwwroot') : '';
  var _lastSesskey = '';

  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.sg-preview-assessment-btn');
    if (!btn) { return; }
    var aid     = btn.getAttribute('data-id');
    var sesskey = btn.getAttribute('data-sesskey');  // always present from template

    document.getElementById('sg-preview-modal-body').innerHTML =
      '<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div>' +
      '<p class="mt-2 text-muted small">Loading preview...</p></div>';
    document.getElementById('sg-preview-modal-footer').innerHTML =
      '<button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">Close</button>';

    var previewModalEl = document.getElementById('sg-assessment-preview-modal');
if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
  bootstrap.Modal.getOrCreateInstance(previewModalEl).show();
} else {
  previewModalEl.classList.add('show');
  previewModalEl.style.display = 'block';
  previewModalEl.removeAttribute('aria-hidden');
  document.body.classList.add('modal-open');
  var bd = document.createElement('div');
  bd.className = 'modal-backdrop fade show';
  bd.id = 'sg-preview-backdrop';
  document.body.appendChild(bd);
}

    fetch(wwwroot + '/local/skillgap/admin/ajax_helper.php?action=preview_assessment&assessmentid=' + aid + '&sesskey=' + sesskey)
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (!data || data.status !== 'ok') {
          document.getElementById('sg-preview-modal-body').innerHTML =
            '<div class="alert alert-danger">Failed to load preview.</div>';
          return;
        }
        var html = '<div class="mb-3"><h5 style="color:#033252;">' + esc(data.title) + '</h5>' +
          '<span class="badge badge-info mr-1">Total: ' + data.total_q + ' questions</span>' +
          '<span class="badge badge-secondary mr-1">' + data.comp_blocks.length + ' competencies</span>' +
          (data.is_published
            ? '<span class="badge badge-success"><i class="fa fa-check-circle mr-1"></i>Published</span>'
            : '<span class="badge badge-warning"><i class="fa fa-pencil mr-1"></i>Draft</span>') +
          '</div>';

        // Validation errors block.
        if (data.has_errors && data.errors && data.errors.length) {
          html += '<div class="alert alert-warning py-2"><strong><i class="fa fa-exclamation-triangle mr-1"></i>Validation Issues:</strong><ul class="mb-0 mt-1 pl-3">';
          data.errors.forEach(function(err) { html += '<li class="small">' + esc(err) + '</li>'; });
          html += '</ul></div>';
        }

        html += '<table class="table table-sm table-bordered mb-4"><thead class="thead-light">' +
          '<tr><th>Competency</th><th class="text-center" style="width:80px;">Level</th><th class="text-center" style="width:100px;">Questions</th><th class="text-center" style="width:90px;">Status</th></tr></thead><tbody>';
        data.comp_blocks.forEach(function(cb) {
          var levelColor = {Main:'#033252', Sub:'#eb980d', 'Sub-Sub':'#ffc107'}[cb.level] || '#333';
          html += '<tr><td class="font-weight-medium">' + esc(cb.name) + '</td>' +
            '<td class="text-center"><span class="badge badge-light border small" style="color:' + levelColor + ';">' + esc(cb.level || 'Main') + '</span></td>' +
            '<td class="text-center"><span class="badge badge-' + (cb.ready ? 'success' : 'warning') + '">' + cb.q_count + '/5</span></td>' +
            '<td class="text-center">' + (cb.ready
              ? '<small class="text-success"><i class="fa fa-check-circle mr-1"></i>Ready</small>'
              : '<small class="text-warning"><i class="fa fa-exclamation-triangle mr-1"></i>Need ' + (5 - cb.q_count) + ' more</small>') +
            '</td></tr>';
        });
        html += '</tbody></table>';
        var letters = ['A','B','C','D'];
        data.comp_blocks.forEach(function(cb) {
          html += '<div class="mb-4"><h6 class="font-weight-bold mb-2 px-3 py-2 rounded" style="background:#033252;color:#fff;">' +
            '<i class="fa fa-list mr-2" style="color:#eb980d;"></i>' + esc(cb.name) +
            ' <small>(' + cb.q_count + '/5)</small></h6>';
          if (!cb.questions || cb.questions.length === 0) {
            html += '<p class="text-muted small px-2">No questions added yet.</p>';
          } else {
            cb.questions.forEach(function(q) {
              html += '<div class="mb-3 px-2" style="border-left:3px solid #eb980d;">' +
                '<p class="mb-1 small"><span class="badge badge-secondary mr-1">Q' + q.num + '</span><strong>' + esc(q.text) + '</strong></p>' +
                '<div class="row ml-1">';
              q.options.forEach(function(o, i) {
                html += '<div class="col-6 mb-1 small"><span class="badge ' +
                  (o.iscorrect ? 'badge-success' : 'badge-light border') + ' mr-1">' + letters[i] + '</span>' +
                  (o.iscorrect ? '<strong>' + esc(o.text) + '</strong>' : '<span class="text-muted">' + esc(o.text) + '</span>') +
                  '</div>';
              });
              html += '</div></div>';
            });
          }
          html += '</div>';
        });
        document.getElementById('sg-preview-modal-body').innerHTML = html;
        var allReady = data.comp_blocks.length > 0 && data.comp_blocks.every(function(cb) { return cb.ready; });
        var footer = '<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>';
        if (!data.is_published && allReady) {
          footer += ' <button type="button" class="btn btn-success sg-publish-from-preview" data-aid="' + aid + '">' +
            '<i class="fa fa-check-circle mr-1"></i>Publish Assessment</button>';
        } else if (!data.is_published) {
          footer += ' <span class="text-warning small ml-2"><i class="fa fa-exclamation-triangle mr-1"></i>Complete all questions before publishing.</span>';
        } else {
          footer += ' <span class="text-success small ml-2"><i class="fa fa-check-circle mr-1"></i>This assessment is published.</span>';
        }
        document.getElementById('sg-preview-modal-footer').innerHTML = footer;
      })
      .catch(function() {
        document.getElementById('sg-preview-modal-body').innerHTML =
          '<div class="alert alert-danger">Request failed. Please try again.</div>';
      });
  });

  // Store sesskey globally within this IIFE for the publish action.
  var _lastSesskey = '';

  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.sg-preview-assessment-btn');
    if (btn) { _lastSesskey = btn.getAttribute('data-sesskey') || ''; }
  });

  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.sg-publish-from-preview');
    if (!btn) { return; }
    if (!confirm('Publish this assessment? Users with matching department/designation will see it.')) { return; }
    var aid = btn.getAttribute('data-aid');
    var form = document.createElement('form');
    form.method = 'post';
    form.action = wwwroot + '/local/skillgap/admin/assessments.php';
    form.innerHTML = '<input type="hidden" name="action" value="publish">' +
      '<input type="hidden" name="id" value="' + aid + '">' +
      '<input type="hidden" name="sesskey" value="' + _lastSesskey + '">';
    document.body.appendChild(form);
    form.submit();
  });
// ── Close preview modal — all triggers ──────────────────────────────────
document.addEventListener('click', function(e) {
  if (e.target.closest('[data-dismiss="modal"]') || e.target === document.getElementById('sg-assessment-preview-modal')) {
    var previewModalEl = document.getElementById('sg-assessment-preview-modal');
    if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
      bootstrap.Modal.getOrCreateInstance(previewModalEl).hide();
    } else {
      previewModalEl.classList.remove('show');
      previewModalEl.style.display = 'none';
      previewModalEl.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('modal-open');
      var bd = document.getElementById('sg-preview-backdrop');
      if (bd) { bd.remove(); }
    }
  }
});
  function esc(str) {
    var d = document.createElement('div');
    d.appendChild(document.createTextNode(str || ''));
    return d.innerHTML;
  }

  // Edit Assessment is handled by AMD module (amd/src/skillgap.js bindEditAssessment).
  // Cancel edit button calls AMD's sgResetEditForm via global.
 document.addEventListener('click', function(e) {
    if (e.target.closest('#sg-cancel-edit-btn')) {
        if (typeof window.sgResetEditForm === 'function') {
            window.sgResetEditForm();
        }
    }
});

})();
</script>
