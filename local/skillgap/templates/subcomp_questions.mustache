{{! @template local_skillgap/subcomp_questions - questions manager for a sub / sub-sub competency (Figma UI) }}
<style>
  .local-skillgap-sq{
    --sg-navy-1:#0A1F3D;
    --sg-navy-2:#0D2647;
    --sg-orange:#F5A623;
    --sg-orange-light:#FDF1DC;
    --sg-blue:#2F6FED;
    --sg-blue-light:#EAF0FE;
    --sg-green:#1E9E58;
    --sg-green-light:#E7F8EE;
    --sg-amber:#B45309;
    --sg-red:#E5484D;
    --sg-red-light:#FDEAEA;
    --sg-gray-light:#EEF1F5;
    --sg-gray-bg:#F5F7FA;
    --sg-border:#E7EBF1;
    --sg-text-muted:#8A93A3;
    --sg-text-dark:#1B2A41;
    font-family:inherit;color:var(--sg-text-dark);background:var(--sg-gray-bg);
    padding:24px;border-radius:14px;
  }
  .local-skillgap-sq *{box-sizing:border-box;}
#page-local-skillgap-admin-subcomp_questions div[role="main"] {
    filter: none;
    padding: 0px !important;
    box-shadow: none !important;
    background: #f6f8fc;
}
  /* ── Top: back + progress ── */
  .sg-back-link{display:inline-flex;align-items:center;gap:6px;color:var(--sg-text-muted);font-size:13px;font-weight:600;text-decoration:none;margin-bottom:12px;}
  .sg-back-link:hover{color:var(--sg-navy-1);text-decoration:none;}
  .sg-prog-head{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:8px;}
  .sg-prog-title{font-weight:800;font-size:17px;color:var(--sg-text-dark);}
  .sg-prog-crumb{font-size:12px;color:var(--sg-text-muted);margin-top:2px;}
  .sg-prog-pill{border-radius:20px;font-size:12.5px;font-weight:700;padding:4px 14px;color:#fff;}
  .sg-prog-pill.sg-warn{background:var(--sg-orange);}
  .sg-prog-pill.sg-ok{background:var(--sg-green);}
  .sg-prog-track{background:var(--sg-gray-light);border-radius:8px;height:10px;overflow:hidden;margin-bottom:8px;}
  .sg-prog-fill{height:100%;border-radius:8px;transition:width .25s;}
  .sg-prog-fill.sg-warn{background:var(--sg-orange);}
  .sg-prog-fill.sg-ok{background:var(--sg-green);}
  .sg-prog-warn{font-size:12.5px;color:var(--sg-amber);display:flex;align-items:center;gap:6px;}
  .sg-prog-warn i{color:var(--sg-orange);}
  .sg-prog-ok{font-size:12.5px;color:var(--sg-green);font-weight:600;display:flex;align-items:center;gap:6px;}

  /* ── Cards ── */
  .sg-card{background:#fff;border:1px solid var(--sg-border);border-radius:14px;overflow:hidden;}
  .sg-section-header{background:var(--sg-navy-1);color:#fff;padding:14px 20px;display:flex;align-items:center;
    justify-content:space-between;flex-wrap:wrap;gap:10px;}
  .sg-section-header h5{color:#fff;margin:0;font-weight:700;font-size:15px;display:flex;align-items:center;gap:10px;}
  .sg-section-header h5 i{color:var(--sg-orange);}
  .sg-hdr-ok{background:rgba(255,255,255,.16);color:#fff;border-radius:20px;font-size:12px;font-weight:600;padding:4px 12px;}

  /* ── Add form ── */
  .sg-form-body{padding:18px 20px;}
  .sg-form-body label{font-size:12px;font-weight:700;color:var(--sg-text-dark);display:block;margin-bottom:6px;}
  .sg-input,.sg-textarea,.sg-select{width:100%;border:1px solid var(--sg-border);border-radius:10px;padding:9px 12px;font-size:13.5px;background:#fff;color:var(--sg-text-dark);}
  .sg-textarea{resize:vertical;min-height:70px;}
  .sg-btn-navy{display:inline-flex;align-items:center;justify-content:center;gap:7px;background:var(--sg-navy-1);border:1px solid var(--sg-navy-1);
    border-radius:10px;padding:10px 18px;font-size:13.5px;font-weight:600;color:#fff;}
  .sg-btn-navy:hover{background:var(--sg-navy-2);color:#fff;}
  .sg-btn-block{width:100%;}
  .sg-btn-orange{display:inline-flex;align-items:center;gap:6px;background:var(--sg-orange);border:none;border-radius:10px;
    padding:9px 16px;font-size:13px;font-weight:600;color:#fff;}
  .sg-btn-orange:hover{background:#e0940e;color:#fff;}
  .sg-btn-outline{display:inline-flex;align-items:center;justify-content:center;gap:6px;background:#fff;border:1px solid var(--sg-border);
    border-radius:10px;padding:9px 14px;font-size:13px;font-weight:600;color:var(--sg-text-dark);text-decoration:none;}
  .sg-btn-outline:hover{border-color:var(--sg-navy-1);color:var(--sg-text-dark);text-decoration:none;}
  .sg-btn-outline i{color:var(--sg-text-muted);}
  .sg-divider{border:none;border-top:1px solid var(--sg-border);margin:16px 0;}

  /* ── Question rows ── */
  .sg-q-row{padding:18px 20px;border-bottom:1px solid var(--sg-border);}
  .sg-q-row:last-child{border-bottom:none;}
  .sg-q-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:14px;}
  .sg-q-left{display:flex;align-items:flex-start;gap:10px;min-width:0;}
  .sg-q-badge{width:34px;height:34px;min-width:34px;border-radius:50%;background:var(--sg-navy-1);color:#fff;
    display:flex;align-items:center;justify-content:center;font-size:11.5px;font-weight:700;}
  .sg-q-source{border:1px solid var(--sg-border);border-radius:8px;font-size:10.5px;font-weight:700;letter-spacing:.5px;
    color:var(--sg-text-muted);padding:3px 8px;text-transform:uppercase;flex-shrink:0;}
  .sg-q-text{font-weight:700;font-size:14px;color:var(--sg-text-dark);padding-top:6px;}
  .sg-q-actions{display:flex;gap:6px;flex-shrink:0;}
  .sg-circle{width:34px;height:34px;border-radius:8px;background:#fff;border:1px solid var(--sg-border);display:inline-flex;
    align-items:center;justify-content:center;font-size:12.5px;color:var(--sg-text-dark);}
  .sg-circle:hover{border-color:var(--sg-navy-1);}
  .sg-circle.sg-del{border-color:var(--sg-red-light);color:var(--sg-red);}
  .sg-circle.sg-del:hover{background:var(--sg-red-light);}

  .sg-opts{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  @media (max-width:640px){.sg-opts{grid-template-columns:1fr;}}
  .sg-opt{display:flex;align-items:center;gap:10px;border:1px solid var(--sg-border);border-radius:12px;padding:11px 14px;font-size:13px;}
  .sg-opt.sg-correct{background:var(--sg-green-light);border:1.5px solid var(--sg-green);}
  .sg-opt-radio{width:20px;height:20px;min-width:20px;border-radius:50%;border:1.5px solid var(--sg-border);
    display:flex;align-items:center;justify-content:center;font-size:10px;}
  .sg-opt.sg-correct .sg-opt-radio{background:var(--sg-green);border-color:var(--sg-green);color:#fff;}
  .sg-opt-text{color:var(--sg-text-muted);}
  .sg-opt.sg-correct .sg-opt-text{color:var(--sg-green);font-weight:600;}

  /* ── Inline edit ── */
  .sg-edit-panel{margin-top:14px;padding:16px;border:1px solid var(--sg-border);border-radius:12px;background:#F8FAFC;display:none;}
  .sg-edit-panel.show{display:block;}
  .sg-edit-title{font-weight:700;font-size:13px;color:var(--sg-navy-1);margin-bottom:12px;display:flex;align-items:center;gap:6px;}
  .sg-edit-title i{color:var(--sg-orange);}
  .sg-grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  @media (max-width:640px){.sg-grid2{grid-template-columns:1fr;}}

  .sg-empty{text-align:center;color:var(--sg-text-muted);padding:40px 16px;}
</style>

<div class="local-skillgap-sq">

  {{! ── Back link ── }}
  <a href="{{{wwwroot}}}/local/skillgap/admin/competencies.php?deptid={{deptid}}&desigid={{desigid}}" class="sg-back-link">
    <i class="fa fa-arrow-left"></i>Back to Competencies
  </a>

  {{! ── Progress header ── }}
  <div class="sg-prog-head">
    <div>
      <div class="sg-prog-title">{{subcomp_name}}</div>
      <div class="sg-prog-crumb">
        {{comp_name}}{{#is_subsub}} &rsaquo; {{parent_name}}{{/is_subsub}} &rsaquo; <strong>{{subcomp_name}}</strong>
      </div>
    </div>
    <span class="sg-prog-pill {{#has_5_questions}}sg-ok{{/has_5_questions}}{{^has_5_questions}}sg-warn{{/has_5_questions}}">{{q_count}}/5</span>
  </div>
  <div class="sg-prog-track">
    <div class="sg-prog-fill {{#has_5_questions}}sg-ok{{/has_5_questions}}{{^has_5_questions}}sg-warn{{/has_5_questions}}" style="width:{{q_pct}}%;"></div>
  </div>
  {{#has_5_questions}}<div class="sg-prog-ok"><i class="fa fa-check-circle"></i>5/5 &mdash; complete</div>{{/has_5_questions}}
  {{^has_5_questions}}<div class="sg-prog-warn"><i class="fa fa-exclamation-triangle"></i>{{remaining}} more question(s) needed.</div>{{/has_5_questions}}

  <div class="row mt-4">

    {{! ── Add question ── }}
    {{#can_add_more}}
    <div class="col-12 col-md-5 mb-4">
      <div class="sg-card">
        <div class="sg-section-header"><h5><i class="fa fa-plus-circle"></i>Add Question ({{remaining}} remaining)</h5></div>
        <div class="sg-form-body">
          <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/subcomp_questions.php?subcompid={{subcompid}}&compid={{compid}}&assessmentid={{assessmentid}}&deptid={{deptid}}&desigid={{desigid}}">
            <input type="hidden" name="action"  value="save_question">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <div class="mb-3">
              <label>Question Text <span style="color:var(--sg-red);">*</span></label>
              <textarea name="questiontext" class="sg-textarea" required placeholder="Enter question..."></textarea>
            </div>
            <div class="sg-grid2 mb-3">
              <div><label>Option A <span style="color:var(--sg-red);">*</span></label><input type="text" name="option_a" class="sg-input" required></div>
              <div><label>Option B <span style="color:var(--sg-red);">*</span></label><input type="text" name="option_b" class="sg-input" required></div>
              <div><label>Option C <span style="color:var(--sg-red);">*</span></label><input type="text" name="option_c" class="sg-input" required></div>
              <div><label>Option D <span style="color:var(--sg-red);">*</span></label><input type="text" name="option_d" class="sg-input" required></div>
            </div>
            <div class="mb-3">
              <label>Correct Answer <span style="color:var(--sg-red);">*</span></label>
              <select name="correct" class="sg-select" required>
                <option value="0">A — is correct</option>
                <option value="1">B — is correct</option>
                <option value="2">C — is correct</option>
                <option value="3">D — is correct</option>
              </select>
            </div>
            <button type="submit" class="sg-btn-navy sg-btn-block"><i class="fa fa-plus-circle"></i>Add Question</button>
          </form>

          <hr class="sg-divider">
          <label>CSV Upload</label>
          <p class="text-muted small">Format: Question, OptionA, OptionB, OptionC, OptionD (first option = correct)</p>
          <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/subcomp_questions.php?subcompid={{subcompid}}&compid={{compid}}&assessmentid={{assessmentid}}&deptid={{deptid}}&desigid={{desigid}}" enctype="multipart/form-data" class="d-flex align-items-center" style="gap:8px;">
            <input type="hidden" name="action"  value="upload_csv">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="file" name="csvfile" class="form-control-file" accept=".csv" required style="flex:1;">
            <button type="submit" class="sg-btn-orange"><i class="fa fa-upload"></i>Import</button>
          </form>
          <a href="{{{wwwroot}}}/local/skillgap/admin/download_sample.php?type=questions" class="sg-btn-outline sg-btn-block mt-2"><i class="fa fa-download"></i>Download Sample CSV</a>
        </div>
      </div>
    </div>
    {{/can_add_more}}

    {{! ── Existing questions ── }}
    <div class="{{#can_add_more}}col-12 col-md-7{{/can_add_more}}{{^can_add_more}}col-12{{/can_add_more}} mb-4">
      <div class="sg-card">
        <div class="sg-section-header">
          <h5><i class="fa fa-list"></i>Existing Questions ({{q_count}}/5)</h5>
          {{#has_5_questions}}<span class="sg-hdr-ok"><i class="fa fa-check-circle mr-1"></i>Complete</span>{{/has_5_questions}}
        </div>
        <div class="card-body p-0">
          {{#question_rows}}
          <div class="sg-q-row">
            <div class="sg-q-top">
              <div class="sg-q-left">
                <span class="sg-q-badge">Q{{num}}</span>
                <span class="sg-q-source">{{source}}</span>
                <span class="sg-q-text">{{questiontext}}</span>
              </div>
              <div class="sg-q-actions">
                <button type="button" class="sg-circle sg-edit-question-btn" data-qid="{{id}}"><i class="fa fa-pencil"></i></button>
                <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/subcomp_questions.php?subcompid={{subcompid}}&compid={{compid}}&assessmentid={{assessmentid}}&deptid={{deptid}}&desigid={{desigid}}"
                      class="d-inline" onsubmit="return confirm('Delete this question?');">
                  <input type="hidden" name="action"  value="delete_question">
                  <input type="hidden" name="id"      value="{{id}}">
                  <input type="hidden" name="sesskey" value="{{sesskey}}">
                  <button type="submit" class="sg-circle sg-del"><i class="fa fa-trash"></i></button>
                </form>
              </div>
            </div>

            <div class="sg-opts">
              {{#options}}
              <div class="sg-opt {{#iscorrect}}sg-correct{{/iscorrect}}">
                <span class="sg-opt-radio">{{#iscorrect}}<i class="fa fa-check"></i>{{/iscorrect}}</span>
                <span class="sg-opt-text">{{text}}</span>
              </div>
              {{/options}}
            </div>

            {{! Inline edit }}
            <div class="sg-edit-panel" id="sg-edit-qform-{{id}}">
              <div class="sg-edit-title"><i class="fa fa-pencil"></i>Edit Question</div>
              <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/subcomp_questions.php?subcompid={{subcompid}}&compid={{compid}}&assessmentid={{assessmentid}}&deptid={{deptid}}&desigid={{desigid}}">
                <input type="hidden" name="action"  value="update_question">
                <input type="hidden" name="id"      value="{{id}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <div class="mb-3"><label>Question Text</label><textarea name="questiontext" class="sg-textarea" required>{{questiontext}}</textarea></div>
                <div class="sg-grid2 mb-3">
                  <div><label>A</label><input type="text" name="option_a" class="sg-input" value="{{opt_a}}" required></div>
                  <div><label>B</label><input type="text" name="option_b" class="sg-input" value="{{opt_b}}" required></div>
                  <div><label>C</label><input type="text" name="option_c" class="sg-input" value="{{opt_c}}" required></div>
                  <div><label>D</label><input type="text" name="option_d" class="sg-input" value="{{opt_d}}" required></div>
                </div>
                <div class="mb-3">
                  <label>Correct</label>
                  <select name="correct" class="sg-select">
                    <option value="0" {{#correct_0}}selected{{/correct_0}}>A is correct</option>
                    <option value="1" {{#correct_1}}selected{{/correct_1}}>B is correct</option>
                    <option value="2" {{#correct_2}}selected{{/correct_2}}>C is correct</option>
                    <option value="3" {{#correct_3}}selected{{/correct_3}}>D is correct</option>
                  </select>
                </div>
                <div class="d-flex" style="gap:8px;">
                  <button type="submit" class="sg-btn-navy"><i class="fa fa-save"></i>Save</button>
                  <button type="button" class="sg-btn-outline sg-cancel-edit-question" data-qid="{{id}}">Cancel</button>
                </div>
              </form>
            </div>
          </div>
          {{/question_rows}}
          {{^question_rows}}
          <div class="sg-empty"><i class="fa fa-inbox fa-2x mb-2 d-block"></i>No questions yet. Add your first question on the left.</div>
          {{/question_rows}}
        </div>
      </div>
    </div>

  </div>
</div>

<script>
(function() {
  var root = document.querySelector('.local-skillgap-sq');
  if (!root) { return; }
  root.addEventListener('click', function(e) {
    var edit = e.target.closest('.sg-edit-question-btn');
    if (edit) {
      var f = document.getElementById('sg-edit-qform-' + edit.getAttribute('data-qid'));
      if (f) { f.classList.toggle('show'); }
      return;
    }
    var cancel = e.target.closest('.sg-cancel-edit-question');
    if (cancel) {
      var cf = document.getElementById('sg-edit-qform-' + cancel.getAttribute('data-qid'));
      if (cf) { cf.classList.remove('show'); }
    }
  });
})();
</script>
