{{!
  @template local_skillgap/analytics_visibility
  Team Analytics Visibility Mapping — multi-select target designations.
}}
<div class="local-skillgap">

  <div class="d-flex align-items-center justify-content-between flex-wrap mb-4">
    <div>
      <h3 class="mb-0" style="color:#033252;">
        <i class="fa fa-eye mr-2" style="color:#eb980d;"></i>Team Analytics Visibility Mapping
      </h3>
      <p class="text-muted small mt-1 mb-0">Configure which designation can view team analytics of one or more other designations.</p>
    </div>
    <a href="{{{wwwroot}}}/local/skillgap/admin/designations.php"
       class="btn btn-sm btn-outline-secondary mt-2 mt-md-0">
      <i class="fa fa-arrow-left mr-1"></i>Back to Designations
    </a>
  </div>

  <div class="alert alert-info small mb-4">
    <i class="fa fa-info-circle mr-1"></i>
    <strong>How it works:</strong> Select a <em>Viewer</em> designation (who can see analytics) and one or
    more <em>Target</em> designations (whose analytics become visible). All users with the viewer designation
    will automatically see reports for all users with the target designation(s).
  </div>

  <div class="row">

    {{! ── Add Mapping Form ── }}
    <div class="col-md-5 mb-4">
      <div class="card">
        <div class="card-header" style="background:#033252;color:#fff;">
          <h6 class="mb-0"><i class="fa fa-plus-circle mr-2" style="color:#eb980d;"></i>Add Visibility Mapping</h6>
        </div>
        <div class="card-body">
          <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/analytics_visibility.php"
                id="sg-vis-form">
            <input type="hidden" name="action"       value="add_mapping">
            <input type="hidden" name="sesskey"      value="{{sesskey}}">
            <input type="hidden" name="viewer_desig" id="sg-viewer-desig-val">
            <input type="hidden" name="viewer_dept"  id="sg-viewer-dept-val">
            <input type="hidden" name="targets_json" id="sg-targets-json-val">

            {{! Viewer designation }}
            <div class="form-group">
              <label class="font-weight-bold small">
                <i class="fa fa-user mr-1" style="color:#eb980d;"></i>
                Viewer Designation <span class="text-danger">*</span>
              </label>
              <small class="text-muted d-block mb-1">This designation CAN VIEW analytics of targets.</small>
              <select id="sg-viewer-sel" class="form-control form-control-sm" required>
                <option value="">-- Select Viewer Designation --</option>
                {{#desig_opts}}
                <option value="{{value}}">{{label}}</option>
                {{/desig_opts}}
              </select>
              <div id="sg-viewer-chosen" class="mt-1 small text-success" style="display:none;">
                <i class="fa fa-check-circle mr-1"></i><span id="sg-viewer-chosen-label"></span>
              </div>
            </div>

            {{! Target designations — multi-select checklist }}
            <div class="form-group">
              <label class="font-weight-bold small">
                <i class="fa fa-users mr-1" style="color:#033252;"></i>
                Target Designation(s) <span class="text-danger">*</span>
                <span class="badge badge-secondary ml-1" id="sg-target-count">0 selected</span>
              </label>
              <small class="text-muted d-block mb-1">Analytics of these designation(s) will be visible to the viewer.</small>
              <div id="sg-target-list"
                   class="border rounded p-2"
                   style="max-height:220px;overflow-y:auto;background:#f8f9fa;">
                <p class="text-muted small mb-0 p-1">Select a Viewer Designation first to load targets.</p>
              </div>
            </div>

            <button type="button" class="btn btn-block" style="background:#033252;color:#fff;"
                    id="sg-vis-submit-btn" disabled>
              <i class="fa fa-save mr-1"></i>Add Mapping(s)
            </button>
          </form>
        </div>
      </div>
    </div>

    {{! ── Existing Mappings ── }}
    <div class="col-md-7 mb-4">
      <div class="card">
        <div class="card-header bg-white d-flex align-items-center justify-content-between">
          <h6 class="mb-0 font-weight-bold" style="color:#033252;">
            <i class="fa fa-list mr-1" style="color:#eb980d;"></i>Configured Mappings
          </h6>
        </div>
        <div class="card-body p-0">
          {{#has_mappings}}
          <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
              <thead class="thead-light">
                <tr>
                  <th>Viewer Dept</th>
                  <th>Viewer Designation</th>
                  <th class="text-center" style="width:30px;"></th>
                  <th>Target Dept</th>
                  <th>Target Designation</th>
                  <th style="width:60px;">Remove</th>
                </tr>
              </thead>
              <tbody>
                {{#mapping_rows}}
                <tr>
                  <td class="small text-muted align-middle">{{viewer_dept}}</td>
                  <td class="align-middle">
                    <span class="badge badge-light border" style="color:#eb980d;">{{viewer_desig}}</span>
                  </td>
                  <td class="text-center align-middle text-muted small"><i class="fa fa-eye"></i></td>
                  <td class="small text-muted align-middle">{{target_dept}}</td>
                  <td class="align-middle">
                    <span class="badge badge-light border" style="color:#033252;">{{target_desig}}</span>
                  </td>
                  <td class="align-middle">
                    <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/analytics_visibility.php"
                          onsubmit="return confirm('Remove this mapping?');">
                      <input type="hidden" name="action"  value="delete_mapping">
                      <input type="hidden" name="id"      value="{{id}}">
                      <input type="hidden" name="sesskey" value="{{sesskey}}">
                      <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="fa fa-trash"></i>
                      </button>
                    </form>
                  </td>
                </tr>
                {{/mapping_rows}}
              </tbody>
            </table>
          </div>
          {{/has_mappings}}
          {{^has_mappings}}
          <div class="p-4 text-center text-muted">
            <i class="fa fa-eye-slash fa-2x mb-2 d-block"></i>
            No visibility mappings configured yet.
          </div>
          {{/has_mappings}}
        </div>
      </div>

      {{! How-to card }}
      <div class="card mt-3">
        <div class="card-body small py-3">
          <p class="font-weight-bold mb-2" style="color:#033252;">
            <i class="fa fa-question-circle mr-1" style="color:#eb980d;"></i>Example
          </p>
          <p class="mb-1 text-muted">
            <strong>HOD</strong> <i class="fa fa-eye mx-1"></i> can view analytics of:
            Senior Manager, Manager, Assistant Manager, Assistant
          </p>
          <p class="mb-0 text-muted">
            <strong>Senior Manager</strong> <i class="fa fa-eye mx-1"></i> can view:
            Manager, Assistant Manager, Assistant
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  // All designation options from PHP — used to populate the target checklist.
  var allOpts = [
    {{#desig_opts}}
    { value: '{{value}}', label: '{{label}}' },
    {{/desig_opts}}
  ];

  var viewerSel      = document.getElementById('sg-viewer-sel');
  var viewerDesize   = document.getElementById('sg-viewer-desig-val');
  var viewerDept     = document.getElementById('sg-viewer-dept-val');
  var targetsJson    = document.getElementById('sg-targets-json-val');
  var targetList     = document.getElementById('sg-target-list');
  var targetCount    = document.getElementById('sg-target-count');
  var submitBtn      = document.getElementById('sg-vis-submit-btn');
  var viewerChosen   = document.getElementById('sg-viewer-chosen');
  var viewerChosenLbl= document.getElementById('sg-viewer-chosen-label');
  var form           = document.getElementById('sg-vis-form');

  function updateTargetCount() {
    var checked = targetList.querySelectorAll('input[type="checkbox"]:checked').length;
    targetCount.textContent = checked + ' selected';
    submitBtn.disabled = checked === 0 || !viewerSel.value;
    // Build JSON for hidden input.
    var selected = [];
    targetList.querySelectorAll('input[type="checkbox"]:checked').forEach(function(cb) {
      selected.push(cb.value);
    });
    targetsJson.value = JSON.stringify(selected);
  }

  viewerSel.addEventListener('change', function() {
    var val = this.value;
    if (!val) {
      targetList.innerHTML = '<p class="text-muted small mb-0 p-1">Select a Viewer Designation first.</p>';
      viewerChosen.style.display = 'none';
      viewerDesize.value = '';
      viewerDept.value   = '';
      submitBtn.disabled = true;
      return;
    }
    var parts = val.split('||');
    viewerDesize.value       = parts[0] || '';
    viewerDept.value         = parts[1] || '';
    viewerChosenLbl.textContent = this.options[this.selectedIndex].text;
    viewerChosen.style.display  = 'block';

    // Render target checkboxes excluding the selected viewer.
    var html = '';
    allOpts.forEach(function(opt) {
      if (opt.value === val) { return; } // don't allow self-mapping
      var safeLabel = opt.label.replace(/</g,'&lt;').replace(/>/g,'&gt;');
      var safeVal   = opt.value.replace(/"/g, '&quot;');
      html += '<div class="form-check py-1 border-bottom">' +
        '<input type="checkbox" class="form-check-input sg-target-cb" ' +
        'value="' + safeVal + '" id="tgt_' + btoa(unescape(encodeURIComponent(opt.value))).replace(/[^a-zA-Z0-9]/g,'') + '">' +
        '<label class="form-check-label small ml-1" ' +
        'for="tgt_' + btoa(unescape(encodeURIComponent(opt.value))).replace(/[^a-zA-Z0-9]/g,'') + '">' +
        safeLabel + '</label></div>';
    });
    targetList.innerHTML = html || '<p class="text-muted small p-1">No other designations available.</p>';

    targetList.querySelectorAll('.sg-target-cb').forEach(function(cb) {
      cb.addEventListener('change', updateTargetCount);
    });
    updateTargetCount();
  });

  // Add "Select All" / "Clear All" helpers
  var helperDiv = document.createElement('div');
  helperDiv.className = 'mb-1 d-flex gap-2';
  helperDiv.innerHTML =
    '<button type="button" class="btn btn-xs btn-outline-secondary" style="font-size:11px;padding:1px 8px;" id="sg-sel-all">Select All</button>' +
    '<button type="button" class="btn btn-xs btn-outline-secondary" style="font-size:11px;padding:1px 8px;" id="sg-clr-all">Clear All</button>';
  targetList.parentNode.insertBefore(helperDiv, targetList);

  document.getElementById('sg-sel-all').addEventListener('click', function() {
    targetList.querySelectorAll('.sg-target-cb').forEach(function(cb) { cb.checked = true; });
    updateTargetCount();
  });
  document.getElementById('sg-clr-all').addEventListener('click', function() {
    targetList.querySelectorAll('.sg-target-cb').forEach(function(cb) { cb.checked = false; });
    updateTargetCount();
  });

  submitBtn.addEventListener('click', function() {
    if (!viewerSel.value) {
      alert('Please select a Viewer Designation.');
      return;
    }
    var checked = targetList.querySelectorAll('input[type="checkbox"]:checked').length;
    if (!checked) {
      alert('Please select at least one Target Designation.');
      return;
    }
    form.submit();
  });
})();
</script>
