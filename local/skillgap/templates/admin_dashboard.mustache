{{#js}}
require(['jquery'], function($) {
  var root = document.querySelector('.local-skillgap-admin');
  if (!root) { return; }

  /* Avatar initials for competency performance (e.g. "Customer Support" → "CS"). */
  root.querySelectorAll('.sg-perf-avatar').forEach(function(av) {
    var words = (av.dataset.name || '').trim().split(/\s+/).filter(Boolean);
    var initials = words.length >= 2
      ? (words[0][0] + words[1][0])
      : (words[0] ? words[0][0] : '?');
    av.textContent = initials.toUpperCase();
  });

  /* Generic 6-per-page paginator for every .sg-pg block. */
  root.querySelectorAll('.sg-pg').forEach(function(block) {
    var size    = parseInt(block.dataset.pageSize, 10) || 6;
    var rows    = Array.prototype.slice.call(block.querySelectorAll('.sg-pg-row'));
    var info    = block.querySelector('.sg-page-info');
    var prevBtn = block.querySelector('.sg-page-prev');
    var nextBtn = block.querySelector('.sg-page-next');
    if (!rows.length) { return; }
    var page = 1;
    var totalPages = Math.max(1, Math.ceil(rows.length / size));

    function render() {
      page = Math.min(Math.max(1, page), totalPages);
      var start = (page - 1) * size;
      rows.forEach(function(r, i) { r.style.display = (i >= start && i < start + size) ? '' : 'none'; });
      if (info) {
        info.textContent = 'Showing ' + (start + 1) + '-' + Math.min(start + size, rows.length) + ' of ' + rows.length;
      }
      if (prevBtn) { prevBtn.disabled = (page <= 1); }
      if (nextBtn) { nextBtn.disabled = (page >= totalPages); }
    }
    if (prevBtn) { prevBtn.addEventListener('click', function() { page--; render(); }); }
    if (nextBtn) { nextBtn.addEventListener('click', function() { page++; render(); }); }
    render();
  });
});
{{/js}}
