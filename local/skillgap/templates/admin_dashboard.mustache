{{!
  @template local_skillgap/admin_dashboard
  Admin overview dashboard — Figma-matched UI.
  Bootstrap only; scoped styles under .local-skillgap-admin.
}}
<style>
  .local-skillgap-admin{
    --sg-navy-1:#0A1F3D;
    --sg-navy-2:#0D2647;
    --sg-orange:#F5A623;
    --sg-orange-light:#FDF1DC;
    --sg-blue:#2F6FED;
    --sg-blue-light:#EAF0FE;
    --sg-green:#1E9E58;
    --sg-green-light:#E7F8EE;
    --sg-amber:#B45309;
    --sg-amber-light:#FEF3DC;
    --sg-red:#E5484D;
    --sg-red-light:#FDEAEA;
    --sg-gray:#6B7280;
    --sg-gray-light:#EEF1F5;
    --sg-gray-bg:#F5F7FA;
    --sg-border:#E7EBF1;
    --sg-text-muted:#8A93A3;
    --sg-text-dark:#1B2A41;
    font-family:inherit;
    color:var(--sg-text-dark);
    background:var(--sg-gray-bg);
    padding:20px;
    border-radius:14px;
  }
  #page-local-skillgap-admin-index #page-header{display:none;}

#page-local-skillgap-admin-index div[role="main"] {
    background: #f5f7fa !important;
    box-shadow: unset !important;}


  .sg-card { box-shadow: 0 13px 37px rgb(92 107 121 / .1);}
  .local-skillgap-admin *{box-sizing:border-box;}

  /* ── Page header ── */
  .sg-page-head{display:flex;align-items:center;gap:14px;margin-bottom:22px;}
  .sg-head-icon{width:46px;height:46px;border-radius:12px;background:var(--sg-orange-light);color:var(--sg-orange);
    display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;}
  .sg-page-head h3{margin:0;font-weight:800;font-size:24px;color:var(--sg-text-dark);}
  .sg-page-head .sg-sub{color:var(--sg-text-muted);font-size:13.5px;margin-top:2px;}

  /* ── Metric cards ── */
  .sg-metric-card{background:#fff;border:1px solid var(--sg-border);border-radius:14px;padding:18px 20px;height:100%;
    position:relative;border-top:4px solid var(--sg-navy-1);}
  .sg-metric-card.sg-mt-navy{border-top-color:var(--sg-navy-1);}
  .sg-metric-card.sg-mt-orange{border-top-color:var(--sg-orange);}
  .sg-metric-card.sg-mt-green{border-top-color:var(--sg-green);}
  .sg-metric-card.sg-mt-red{border-top-color:var(--sg-red);}
  .sg-metric-label{font-size:11px;letter-spacing:.6px;text-transform:uppercase;color:var(--sg-text-muted);font-weight:700;margin-bottom:8px;}
  .sg-metric-value{font-size:34px;font-weight:800;color:var(--sg-text-dark);line-height:1;}
  .sg-metric-desc{font-size:12.5px;color:var(--sg-text-muted);margin-top:10px;}
  .sg-metric-icon{position:absolute;top:16px;right:16px;width:38px;height:38px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;font-size:15px;}
  .sg-icon-blue{background:var(--sg-blue-light);color:var(--sg-blue);}
  .sg-icon-orange{background:var(--sg-orange-light);color:var(--sg-orange);}
  .sg-icon-green{background:var(--sg-green-light);color:var(--sg-green);}
  .sg-icon-red{background:var(--sg-red-light);color:var(--sg-red);}

  /* ── Card + section headers ── */
  .sg-card{background:#fff;border:1px solid var(--sg-border);border-radius:14px;overflow:hidden;}
  .sg-section-header{background:var(--sg-navy-1);color:#fff;padding:14px 20px;display:flex;align-items:center;
    justify-content:space-between;flex-wrap:wrap;gap:10px;}
  .sg-section-header h5{color:#fff;margin:0;font-weight:700;font-size:15.5px;display:flex;align-items:center;gap:10px;}
  .sg-section-header h5 i{color:var(--sg-orange);}
  .sg-count-badge{background:rgba(255,255,255,.16);color:#fff;font-size:12px;font-weight:700;border-radius:20px;padding:4px 12px;}
  .sg-viewall{background:#fff;color:var(--sg-navy-1);border:none;border-radius:20px;font-weight:600;font-size:12.5px;
    padding:6px 16px;text-decoration:none;display:inline-block;}
  .sg-viewall:hover{color:var(--sg-navy-1);background:#f1f3f7;text-decoration:none;}

  /* ── Quick navigation ── */
  .sg-qn-body{padding:16px 20px;display:flex;flex-wrap:wrap;gap:10px;}
  .sg-pill{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--sg-border);background:#fff;
    color:var(--sg-text-dark);border-radius:24px;padding:8px 16px;font-size:13px;font-weight:600;text-decoration:none;}
  .sg-pill:hover{border-color:var(--sg-navy-1);color:var(--sg-text-dark);text-decoration:none;}
  .sg-pill i{color:var(--sg-text-muted);}
  .sg-pill-primary{background:var(--sg-orange);border-color:var(--sg-orange);color:#fff;box-shadow:0 4px 10px rgba(245,166,35,.35);}
  .sg-pill-primary:hover{background:#e0940e;border-color:#e0940e;color:#fff;}
  .sg-pill-primary i{color:#fff;}

  /* ── Competency performance ── */
  .sg-perf-row{display:flex;align-items:center;gap:14px;padding:12px 20px;}
  .sg-perf-avatar{width:32px;height:32px;border-radius:50%;background:var(--sg-blue-light);color:var(--sg-blue);
    display:flex;align-items:center;justify-content:center;font-size:11.5px;font-weight:700;flex-shrink:0;}
  .sg-perf-main{flex:1 1 auto;min-width:0;}
  .sg-perf-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:7px;}
  .sg-perf-name{font-size:13.5px;font-weight:600;color:var(--sg-text-dark);}
  .sg-perf-pct{font-size:13.5px;font-weight:800;color:var(--sg-text-dark);}
  .sg-progress-track{background:var(--sg-gray-light);border-radius:10px;height:8px;overflow:hidden;}
  .sg-progress-fill{height:100%;border-radius:10px;}
  .sg-fill-success{background:var(--sg-green);}
  .sg-fill-warning{background:var(--sg-orange);}
  .sg-fill-danger{background:var(--sg-red);}

  /* ── Tables ── */
  .local-skillgap-admin table thead th{padding:12px 16px;font-size:11px;text-transform:uppercase;letter-spacing:.5px;
    color:var(--sg-text-muted);font-weight:700;border-top:none;border-bottom:1px solid var(--sg-border);background:#F8FAFC;}
  .local-skillgap-admin table td{vertical-align:middle;border-color:var(--sg-border);font-size:13.5px;padding:12px 16px;}
  .sg-status-badge{border-radius:20px;font-size:11.5px;font-weight:600;padding:4px 12px;display:inline-flex;align-items:center;gap:5px;white-space:nowrap;}
  .sg-status-success{background:var(--sg-green-light);color:var(--sg-green);}
  .sg-status-warning{background:var(--sg-amber-light);color:var(--sg-amber);}
  .sg-status-info{background:var(--sg-blue-light);color:var(--sg-blue);}
  .sg-status-danger{background:var(--sg-red-light);color:var(--sg-red);}
  .sg-status-secondary{background:var(--sg-gray-light);color:var(--sg-gray);}
  .sg-to-text{font-weight:700;color:var(--sg-text-dark);}
  .sg-from-text{color:var(--sg-text-muted);}

  .sg-btn-promote{background:var(--sg-green);color:#fff;border:none;border-radius:20px;font-size:12.5px;font-weight:600;padding:6px 16px;}
  .sg-btn-promote:hover{background:#178a4c;color:#fff;}

  /* ── Pagination footer ── */
  .sg-pagination{display:flex;align-items:center;justify-content:space-between;padding:12px 20px;border-top:1px solid var(--sg-border);
    font-size:12.5px;color:var(--sg-text-muted);flex-wrap:wrap;gap:8px;}
  .sg-page-btn{background:#fff;border:1px solid var(--sg-border);border-radius:16px;padding:5px 14px;font-size:12.5px;
    font-weight:600;color:var(--sg-text-dark);}
  .sg-page-btn:disabled{opacity:.4;}

  .sg-empty{text-align:center;color:var(--sg-text-muted);padding:32px 16px;}
</style>

