{{!
  @template local_skillgap/admin_dashboard
  Admin overview dashboard. Renders inside Moodle standard layout.
  Uses Bootstrap only — no custom sidebar or layout override.
}}

<div class="local-skillgap container-fluid px-0">

  {{! Page header }}
  <div class="d-flex align-items-center justify-content-between flex-wrap mb-4">
    <div>
      <h3 class="mb-0" style="color:#033252;">
        <i class="fa fa-tachometer mr-2" style="color:#eb980d;"></i>
        {{#str}} admin_dashboard, local_skillgap {{/str}}
      </h3>
      <p class="text-muted small mb-0 mt-1">{{#str}} pluginname, local_skillgap {{/str}} &mdash; Overview</p>
    </div>

  </div>

  {{! ── Metric cards ── }}
  <div class="row mb-4">
    <div class="col-6 col-md-3 mb-3">
      <div class="card h-100" style="border-top:4px solid #033252;">
        <div class="card-body text-center py-3">
          <i class="fa fa-users fa-2x mb-2" style="color:#033252;"></i>
          <div class="h2 font-weight-bold mb-1" style="color:#033252;">{{total_users}}</div>
          <div class="small text-muted text-uppercase" style="letter-spacing:.5px;">
            {{#str}} total_users, local_skillgap {{/str}}
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3 mb-3">
      <div class="card h-100" style="border-top:4px solid #eb980d;">
        <div class="card-body text-center py-3">
          <i class="fa fa-star fa-2x mb-2" style="color:#eb980d;"></i>
          <div class="h2 font-weight-bold mb-1" style="color:#854F0B;">{{total_competencies}}</div>
          <div class="small text-muted text-uppercase" style="letter-spacing:.5px;">
            {{#str}} total_competencies, local_skillgap {{/str}}
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3 mb-3">
      <div class="card h-100" style="border-top:4px solid #28a745;">
        <div class="card-body text-center py-3">
          <i class="fa fa-check-circle fa-2x mb-2 text-success"></i>
          <div class="h2 font-weight-bold text-success mb-1">{{active_assessments}}</div>
          <div class="small text-muted text-uppercase" style="letter-spacing:.5px;">
            {{#str}} active_assessments, local_skillgap {{/str}}
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3 mb-3">
      <div class="card h-100" style="border-top:4px solid #dc3545;">
        <div class="card-body text-center py-3">
          <i class="fa fa-exclamation-circle fa-2x mb-2 text-danger"></i>
          <div class="h2 font-weight-bold text-danger mb-1">{{needs_improvement_count}}</div>
          <div class="small text-muted text-uppercase" style="letter-spacing:.5px;">
            {{#str}} needs_improvement_count, local_skillgap {{/str}}
          </div>
        </div>
      </div>
    </div>
  </div>

  {{! ── Quick navigation ── }}
  <div class="card mb-4">
    <div class="card-header py-2" style="background:#033252;color:#fff;">
      <small class="font-weight-bold text-uppercase" style="letter-spacing:1px;">Quick Navigation</small>
    </div>
    <div class="card-body py-2">
      <div class="d-flex flex-wrap" style="gap:8px;">
        <a href="{{{wwwroot}}}/local/skillgap/admin/analytics.php"     class="btn btn-sm font-weight-bold" style="background:#eb980d;color:#fff;"><i class="fa fa-bar-chart mr-1"></i>Analytics</a>
        <a href="{{{wwwroot}}}/local/skillgap/admin/departments.php"   class="btn btn-outline-secondary btn-sm"><i class="fa fa-building mr-1"></i>{{#str}} departments, local_skillgap {{/str}}</a>
        <a href="{{{wwwroot}}}/local/skillgap/admin/designations.php"  class="btn btn-outline-secondary btn-sm"><i class="fa fa-sitemap mr-1"></i>{{#str}} designations, local_skillgap {{/str}}</a>
        <a href="{{{wwwroot}}}/local/skillgap/admin/competencies.php"  class="btn btn-outline-secondary btn-sm"><i class="fa fa-star mr-1"></i>{{#str}} competencies, local_skillgap {{/str}}</a>
        <a href="{{{wwwroot}}}/local/skillgap/admin/questions.php"     class="btn btn-outline-secondary btn-sm"><i class="fa fa-question-circle mr-1"></i>{{#str}} questions, local_skillgap {{/str}}</a>
        <a href="{{{wwwroot}}}/local/skillgap/admin/assessments.php"   class="btn btn-outline-secondary btn-sm"><i class="fa fa-check-square-o mr-1"></i>{{#str}} assessments, local_skillgap {{/str}}</a>
        <a href="{{{wwwroot}}}/local/skillgap/admin/clusters.php"      class="btn btn-outline-secondary btn-sm"><i class="fa fa-object-group mr-1"></i>{{#str}} clusters, local_skillgap {{/str}}</a>
        <a href="{{{wwwroot}}}/local/skillgap/admin/promotion.php"     class="btn btn-outline-secondary btn-sm"><i class="fa fa-arrow-up mr-1"></i>{{#str}} promotion, local_skillgap {{/str}}</a>
        <a href="{{{wwwroot}}}/local/skillgap/admin/weakzones.php"     class="btn btn-outline-secondary btn-sm"><i class="fa fa-exclamation-triangle mr-1"></i>{{#str}} weakzones, local_skillgap {{/str}}</a>
        <a href="{{{wwwroot}}}/local/skillgap/manager/dashboard.php"   class="btn btn-outline-secondary btn-sm"><i class="fa fa-users mr-1"></i>{{#str}} manager_dashboard, local_skillgap {{/str}}</a>
        <a href="{{{wwwroot}}}/local/skillgap/user/dashboard.php"      class="btn btn-outline-secondary btn-sm"><i class="fa fa-user mr-1"></i>{{#str}} user_dashboard, local_skillgap {{/str}}</a>
      </div>
    </div>
  </div>

  <div class="row mb-4">
    {{! ── Competency performance bars ── }}
    <div class="col-12 col-md-6 mb-4">
      <div class="card h-100">
        <div class="card-header" style="background:#033252;color:#fff;">
          <h5 class="mb-0"><i class="fa fa-bar-chart mr-2" style="color:#eb980d;"></i>{{#str}} competency_performance, local_skillgap {{/str}}</h5>
        </div>
        <div class="card-body">
          {{#comp_bars}}
          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="small font-weight-medium">{{name}}</span>
              <span class="small font-weight-bold">{{pct}}%</span>
            </div>
            <div class="progress" style="height:10px;">
              <div class="progress-bar {{bar_class}}" role="progressbar"
                   style="width:{{pct}}%;" aria-valuenow="{{pct}}" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
          </div>
          {{/comp_bars}}
          {{^comp_bars}}
          <div class="text-center text-muted py-4">
            <i class="fa fa-bar-chart fa-2x mb-2 d-block"></i>
            {{#str}} no_data, local_skillgap {{/str}}
          </div>
          {{/comp_bars}}
        </div>
      </div>
    </div>

    {{! ── Recent assessments ── }}
    <div class="col-12 col-md-6 mb-4">
      <div class="card h-100">
        <div class="card-header d-flex justify-content-between align-items-center" style="background:#033252;color:#fff;">
          <h5 class="mb-0"><i class="fa fa-list-alt mr-2" style="color:#eb980d;"></i>{{#str}} recent_assessments, local_skillgap {{/str}}</h5>
          <a href="{{{wwwroot}}}/local/skillgap/admin/assessments.php" class="btn btn-sm btn-outline-light">{{#str}} view_all, local_skillgap {{/str}}</a>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
              <thead class="thead-light">
                <tr>
                  <th>{{#str}} assessment_title, local_skillgap {{/str}}</th>
                  <th>{{#str}} department, local_skillgap {{/str}}</th>
                  <th>{{#str}} frequency, local_skillgap {{/str}}</th>
                  <th>{{#str}} status, local_skillgap {{/str}}</th>
                </tr>
              </thead>
              <tbody>
                {{#recent_assessments}}
                <tr>
                  <td>{{title}}</td>
                  <td>{{dept_name}}</td>
                  <td>{{frequency}}</td>
                  <td><span class="badge badge-{{status_class}}">{{status_label}}</span></td>
                </tr>
                {{/recent_assessments}}
                {{^recent_assessments}}
                <tr>
                  <td colspan="4" class="text-center text-muted py-3">
                    {{#str}} no_assessments, local_skillgap {{/str}}
                  </td>
                </tr>
                {{/recent_assessments}}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  {{! ── Promotion panel ── }}
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center" style="background:#033252;color:#fff;">
      <h5 class="mb-0"><i class="fa fa-arrow-up mr-2" style="color:#eb980d;"></i>{{#str}} promotion, local_skillgap {{/str}}</h5>
      <a href="{{{wwwroot}}}/local/skillgap/admin/promotion.php" class="btn btn-sm btn-outline-light">{{#str}} view_all, local_skillgap {{/str}}</a>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
          <thead class="thead-light">
            <tr>
              <th>{{#str}} user_name, local_skillgap {{/str}}</th>
              <th>{{#str}} department, local_skillgap {{/str}}</th>
              <th>Current &rarr; Next Designation</th>
              <th>{{#str}} readiness, local_skillgap {{/str}}</th>
              <th>{{#str}} action, local_skillgap {{/str}}</th>
            </tr>
          </thead>
          <tbody>
            {{#promotion_users}}
            <tr>
              <td class="font-weight-medium">{{fullname}}</td>
              <td>{{department}}</td>
              <td>
                <span class="text-muted">{{current_desig}}</span>
                {{#has_next_desig}}<i class="fa fa-long-arrow-right mx-1" style="color:#eb980d;"></i>
                <span class="font-weight-bold" style="color:#033252;">{{next_desig}}</span>{{/has_next_desig}}
              </td>
              <td>
                <span class="badge badge-{{badge_class}}">{{readiness_label}}</span>
              </td>
              <td>
                {{#can_promote}}
                <form method="post" action="{{{wwwroot}}}/local/skillgap/admin/promotion.php" class="d-inline"
                      onsubmit="return confirm('Promote {{fullname}} to {{next_desig}}?');">
                  <input type="hidden" name="action"  value="promote">
                  <input type="hidden" name="userid"  value="{{userid}}">
                  <input type="hidden" name="sesskey" value="{{sesskey}}">
                  <button type="submit" class="btn btn-sm btn-success">
                    <i class="fa fa-arrow-up mr-1"></i>{{#str}} promote, local_skillgap {{/str}}
                  </button>
                </form>
                {{/can_promote}}
                {{#already_promoted}}<span class="badge badge-success"><i class="fa fa-check mr-1"></i>Promoted</span>{{/already_promoted}}
                {{^can_promote}}{{^already_promoted}}<span class="text-muted small">{{#str}} not_ready_yet, local_skillgap {{/str}}</span>{{/already_promoted}}{{/can_promote}}
              </td>
            </tr>
            {{/promotion_users}}
            {{^promotion_users}}
            <tr>
              <td colspan="4" class="text-center text-muted py-3">
                {{#str}} no_promotions, local_skillgap {{/str}}
              </td>
            </tr>
            {{/promotion_users}}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  {{! ── Promotion History ──────────────────────────────────────────────────── }}
  {{#has_promo_history}}
  <div class="card mb-4">
    <div class="card-header d-flex align-items-center justify-content-between" style="background:#033252;color:#fff;">
      <h5 class="mb-0">
        <i class="fa fa-history mr-2" style="color:#eb980d;"></i>Promotion History
      </h5>
      <span class="badge badge-light" style="color:#033252;">Last 10</span>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
          <thead class="thead-light">
            <tr>
              <th>User</th>
              <th>Department</th>
              <th>From</th>
              <th></th>
              <th>To</th>
              <th>Promoted By</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            {{#promo_history}}
            <tr>
              <td class="font-weight-medium">{{fullname}}</td>
              <td>{{department}}</td>
              <td><span class="text-muted">{{from_desig}}</span></td>
              <td class="text-center"><i class="fa fa-long-arrow-right" style="color:#eb980d;"></i></td>
              <td><span class="font-weight-bold" style="color:#033252;">{{to_desig}}</span></td>
              <td><small class="text-muted">{{promoted_by}}</small></td>
              <td><small>{{date}}</small></td>
            </tr>
            {{/promo_history}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
  {{/has_promo_history}}

</div>
