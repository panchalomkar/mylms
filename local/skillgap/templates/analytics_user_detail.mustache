{{!
  @template local_skillgap/analytics_user_detail
  User Detail Report — sub-competency breakdown (Image 3 design).
}}
<div class="local-skillgap sg-analytics-wrap" style="background:#f5f7fa;min-height:100vh;padding:24px;">

  {{! Header }}
  <div class="d-flex align-items-start justify-content-between flex-wrap mb-4">
    <div class="d-flex align-items-center">
      <div class="rounded-circle d-flex align-items-center justify-content-center mr-3 font-weight-bold text-white"
           style="width:56px;height:56px;min-width:56px;background:#4a78f5;font-size:18px;">
        {{initials}}
      </div>
      <div>
        <h2 class="mb-0 font-weight-bold" style="color:#1a2b4a;font-size:24px;">
          {{fullname}} &mdash; {{comp_name}}
        </h2>
        <div class="small text-muted mt-1">
          <i class="fa fa-envelope mr-1"></i>{{email}}
        </div>
      </div>
    </div>
    <a href="{{{wwwroot}}}/local/skillgap/admin/analytics_report.php?compid={{compid}}"
       class="btn btn-sm btn-outline-secondary mt-2 mt-md-0" style="border-radius:8px;">
      <i class="fa fa-arrow-left mr-1"></i>{{#str}} back_to_report, local_skillgap {{/str}}
    </a>
  </div>

  {{! Stat cards }}
  <div class="row mb-4">
    <div class="col-6 col-md-3 mb-3">
      <div class="bg-white rounded p-3" style="box-shadow:0 1px 4px rgba(0,0,0,.08);">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="small text-uppercase font-weight-bold" style="color:#8492a6;letter-spacing:.6px;font-size:11px;">
            {{#str}} overall_score, local_skillgap {{/str}}
          </span>
          <span class="rounded-circle d-flex align-items-center justify-content-center"
                style="width:36px;height:36px;background:#eaf0ff;">
            <i class="fa fa-trophy" style="color:#4a78f5;font-size:15px;"></i>
          </span>
        </div>
        <div class="font-weight-bold mb-0" style="font-size:28px;color:#1a2b4a;">{{overall_pct}}%</div>
      </div>
    </div>
    <div class="col-6 col-md-3 mb-3">
      <div class="bg-white rounded p-3" style="box-shadow:0 1px 4px rgba(0,0,0,.08);">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="small text-uppercase font-weight-bold" style="color:#8492a6;letter-spacing:.6px;font-size:11px;">
            {{#str}} competency_status, local_skillgap {{/str}}
          </span>
          <span class="rounded-circle d-flex align-items-center justify-content-center"
                style="width:36px;height:36px;background:#fff8e6;">
            <i class="fa fa-check-circle" style="color:#f0a500;font-size:15px;"></i>
          </span>
        </div>
        <div class="font-weight-bold mb-0" style="font-size:22px;color:#1a2b4a;">{{status_label}}</div>
      </div>
    </div>
    <div class="col-6 col-md-3 mb-3">
      <div class="bg-white rounded p-3" style="box-shadow:0 1px 4px rgba(0,0,0,.08);">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="small text-uppercase font-weight-bold" style="color:#8492a6;letter-spacing:.6px;font-size:11px;">
            {{#str}} sub_competencies, local_skillgap {{/str}}
          </span>
          <span class="rounded-circle d-flex align-items-center justify-content-center"
                style="width:36px;height:36px;background:#f0f2ff;">
            <i class="fa fa-sitemap" style="color:#7c6cf5;font-size:15px;"></i>
          </span>
        </div>
        <div class="font-weight-bold mb-0" style="font-size:28px;color:#1a2b4a;">{{sub_count}}</div>
      </div>
    </div>
    <div class="col-6 col-md-3 mb-3">
      <div class="bg-white rounded p-3" style="box-shadow:0 1px 4px rgba(0,0,0,.08);">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="small text-uppercase font-weight-bold" style="color:#8492a6;letter-spacing:.6px;font-size:11px;">
            {{#str}} completion, local_skillgap {{/str}}
          </span>
          <span class="rounded-circle d-flex align-items-center justify-content-center"
                style="width:36px;height:36px;background:#e6f9f0;">
            <i class="fa fa-percent" style="color:#34c97a;font-size:15px;"></i>
          </span>
        </div>
        <div class="font-weight-bold mb-0" style="font-size:28px;color:#1a2b4a;">{{completion_pct}}%</div>
      </div>
    </div>
  </div>

  {{! Sub-Competency Breakdown table }}
  <div class="bg-white rounded" style="box-shadow:0 1px 4px rgba(0,0,0,.08);overflow:hidden;">
    <div class="px-4 py-3" style="border-bottom:1px solid #f0f0f0;">
      <div class="font-weight-bold" style="color:#1a2b4a;font-size:15px;">
        {{#str}} sub_comp_breakdown, local_skillgap {{/str}}
      </div>
      <div class="small text-muted">
        {{#str}} sub_comp_breakdown_desc, local_skillgap {{/str}}
      </div>
    </div>

    {{#has_subs}}
    <table class="table table-hover mb-0" style="font-size:14px;">
      <thead>
        <tr style="border-bottom:1px solid #f0f0f0;">
          <th class="px-4 py-3" style="color:#8492a6;font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.5px;">
            {{#str}} sub_competency, local_skillgap {{/str}}
          </th>
          <th class="py-3" style="color:#8492a6;font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.5px;min-width:260px;">
            {{#str}} score, local_skillgap {{/str}}
          </th>
          <th class="py-3" style="color:#8492a6;font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.5px;width:180px;">
            {{#str}} status, local_skillgap {{/str}}
          </th>
        </tr>
      </thead>
      <tbody>
        {{#sub_rows}}
        <tr style="border-bottom:1px solid #f8f9fb;">
          <td class="px-4 py-3 font-weight-bold align-middle" style="color:#1a2b4a;">{{name}}</td>
          <td class="align-middle py-3">
            <div class="d-flex align-items-center">
              <div class="progress flex-grow-1 mr-3" style="height:8px;border-radius:4px;background:#eef0f5;max-width:300px;">
                <div class="progress-bar" style="width:{{score_pct}}%;border-radius:4px;
                  {{#score_green}}background:#34c97a;{{/score_green}}
                  {{#score_yellow}}background:#f0a500;{{/score_yellow}}
                  {{#score_red}}background:#e94e4e;{{/score_red}}"></div>
              </div>
              <span class="font-weight-bold" style="font-size:14px;min-width:40px;
                {{#score_green}}color:#34c97a;{{/score_green}}
                {{#score_yellow}}color:#f0a500;{{/score_yellow}}
                {{#score_red}}color:#e94e4e;{{/score_red}}">
                {{score_pct}}%
              </span>
            </div>
          </td>
          <td class="align-middle py-3">
            <span style="display:inline-flex;align-items:center;border-radius:20px;padding:4px 12px;font-size:12px;font-weight:600;
              {{#score_green}}background:#e6f9f0;color:#1a9e5c;{{/score_green}}
              {{#score_yellow}}background:#fff8e6;color:#d48a00;{{/score_yellow}}
              {{#score_red}}background:#fff0f0;color:#e94e4e;{{/score_red}}">
              <span style="width:7px;height:7px;border-radius:50%;margin-right:5px;
                {{#score_green}}background:#1a9e5c;{{/score_green}}
                {{#score_yellow}}background:#d48a00;{{/score_yellow}}
                {{#score_red}}background:#e94e4e;{{/score_red}}"></span>
              {{status_label}}
            </span>
          </td>
        </tr>
        {{/sub_rows}}
      </tbody>
    </table>
    {{/has_subs}}
    {{^has_subs}}
    <div class="text-center py-5 text-muted">
      <i class="fa fa-sitemap fa-2x mb-2 d-block"></i>
      {{#str}} no_sub_competencies, local_skillgap {{/str}}
    </div>
    {{/has_subs}}
  </div>

</div>
