{{!
  @template local_skillgap/analytics_report
  Per-competency user list report — Image 2 design.
}}
<div class="local-skillgap sg-analytics-wrap" style="background:#f5f7fa;min-height:100vh;padding:24px;">

  {{! Breadcrumb & header }}
  <div class="d-flex align-items-start justify-content-between flex-wrap mb-4">
    <div>
      <h2 class="mb-1 font-weight-bold" style="color:#1a2b4a;">
        {{comp_name}} {{#str}} report_title_suffix, local_skillgap {{/str}}
      </h2>
      <p class="text-muted mb-0" style="font-size:14px;">
        {{#str}} learner_performance_breakdown, local_skillgap {{/str}}
      </p>
    </div>
    <div class="d-flex mt-2 mt-md-0" style="gap:8px;">
      <a href="{{{wwwroot}}}/local/skillgap/admin/analytics.php"
         class="btn btn-sm btn-outline-secondary" style="border-radius:8px;">
        <i class="fa fa-arrow-left mr-1"></i>{{#str}} back, local_skillgap {{/str}}
      </a>
      <a href="{{{wwwroot}}}/local/skillgap/admin/analytics_report.php?compid={{compid}}&export=csv"
         class="btn btn-sm text-white font-weight-bold"
         style="border-radius:8px;background:#4a78f5;border:none;">
        <i class="fa fa-download mr-1"></i>{{#str}} export_report, local_skillgap {{/str}}
      </a>
    </div>
  </div>

  {{! Stat cards }}
  <div class="row mb-4">
    <div class="col-6 col-md-3 mb-3">
      <div class="bg-white rounded p-3" style="box-shadow:0 1px 4px rgba(0,0,0,.08);">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="small text-uppercase font-weight-bold" style="color:#8492a6;letter-spacing:.6px;font-size:11px;">
            {{#str}} total_users, local_skillgap {{/str}}
          </span>
          <span class="rounded-circle d-flex align-items-center justify-content-center"
                style="width:36px;height:36px;background:#eaf0ff;">
            <i class="fa fa-users" style="color:#4a78f5;font-size:15px;"></i>
          </span>
        </div>
        <div class="font-weight-bold mb-0" style="font-size:28px;color:#1a2b4a;">{{total_users}}</div>
      </div>
    </div>
    <div class="col-6 col-md-3 mb-3">
      <div class="bg-white rounded p-3" style="box-shadow:0 1px 4px rgba(0,0,0,.08);">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="small text-uppercase font-weight-bold" style="color:#8492a6;letter-spacing:.6px;font-size:11px;">
            {{#str}} average_score, local_skillgap {{/str}}
          </span>
          <span class="rounded-circle d-flex align-items-center justify-content-center"
                style="width:36px;height:36px;background:#fff0f5;">
            <i class="fa fa-line-chart" style="color:#f06292;font-size:15px;"></i>
          </span>
        </div>
        <div class="font-weight-bold mb-0" style="font-size:28px;color:#1a2b4a;">{{avg_pct}}%</div>
      </div>
    </div>
    <div class="col-6 col-md-3 mb-3">
      <div class="bg-white rounded p-3" style="box-shadow:0 1px 4px rgba(0,0,0,.08);">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="small text-uppercase font-weight-bold" style="color:#8492a6;letter-spacing:.6px;font-size:11px;">
            {{#str}} competent_users, local_skillgap {{/str}}
          </span>
          <span class="rounded-circle d-flex align-items-center justify-content-center"
                style="width:36px;height:36px;background:#e6f9f0;">
            <i class="fa fa-user-plus" style="color:#34c97a;font-size:15px;"></i>
          </span>
        </div>
        <div class="font-weight-bold mb-0" style="font-size:28px;color:#1a2b4a;">{{competent_count}}</div>
      </div>
    </div>
    <div class="col-6 col-md-3 mb-3">
      <div class="bg-white rounded p-3" style="box-shadow:0 1px 4px rgba(0,0,0,.08);">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="small text-uppercase font-weight-bold" style="color:#8492a6;letter-spacing:.6px;font-size:11px;">
            {{#str}} needs_improvement_count, local_skillgap {{/str}}
          </span>
          <span class="rounded-circle d-flex align-items-center justify-content-center"
                style="width:36px;height:36px;background:#fff0f0;">
            <i class="fa fa-exclamation-triangle" style="color:#e94e4e;font-size:15px;"></i>
          </span>
        </div>
        <div class="font-weight-bold mb-0" style="font-size:28px;color:#1a2b4a;">{{needs_imp_count}}</div>
      </div>
    </div>
  </div>

  {{! Learners table }}
  <div class="bg-white rounded" style="box-shadow:0 1px 4px rgba(0,0,0,.08);overflow:hidden;">
    <div class="d-flex align-items-center justify-content-between flex-wrap px-4 py-3"
         style="border-bottom:1px solid #f0f0f0;">
      <div>
        <div class="font-weight-bold" style="color:#1a2b4a;font-size:15px;">
          {{#str}} learners, local_skillgap {{/str}}
        </div>
        <div class="small text-muted">{{total_users}} {{#str}} of_users, local_skillgap {{/str}} {{total_users}} {{#str}} users, local_skillgap {{/str}}</div>
      </div>
      <div class="d-flex mt-2 mt-md-0" style="gap:8px;">
        <div class="input-group input-group-sm" style="width:200px;">
          <div class="input-group-prepend">
            <span class="input-group-text" style="background:#f5f7fa;border-right:0;">
              <i class="fa fa-search" style="color:#8492a6;font-size:12px;"></i>
            </span>
          </div>
          <input type="text" id="sg-user-search" class="form-control form-control-sm"
                 placeholder="{{#str}} search_users, local_skillgap {{/str}}"
                 style="border-left:0;background:#f5f7fa;">
        </div>
        <select id="sg-user-status-filter" class="form-control form-control-sm"
                style="width:140px;background:#f5f7fa;">
          <option value="">{{#str}} all_statuses, local_skillgap {{/str}}</option>
          <option value="Competent">{{#str}} status_competent, local_skillgap {{/str}}</option>
          <option value="Moderate">{{#str}} status_moderate, local_skillgap {{/str}}</option>
          <option value="Needs Improvement">{{#str}} status_needs_improvement, local_skillgap {{/str}}</option>
        </select>
      </div>
    </div>

    {{#has_users}}
    <table class="table table-hover mb-0" id="sg-report-table" style="font-size:14px;">
      <thead>
        <tr style="border-bottom:1px solid #f0f0f0;">
          <th class="px-4 py-3" style="color:#8492a6;font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.5px;">
            {{#str}} user_name, local_skillgap {{/str}}
          </th>
          <th class="py-3" style="color:#8492a6;font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.5px;min-width:220px;">
            {{#str}} overall_score, local_skillgap {{/str}}
          </th>
          <th class="py-3" style="color:#8492a6;font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.5px;width:160px;">
            {{#str}} status, local_skillgap {{/str}}
          </th>
          <th class="text-right px-4 py-3" style="color:#8492a6;font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.5px;width:140px;">
            {{#str}} action, local_skillgap {{/str}}
          </th>
        </tr>
      </thead>
      <tbody>
        {{#user_rows}}
        <tr class="sg-user-row" data-name="{{fullname}}" data-status="{{status_label}}"
            style="border-bottom:1px solid #f8f9fb;">
          <td class="px-4 py-3 align-middle">
            <div class="d-flex align-items-center">
              <div class="rounded-circle d-flex align-items-center justify-content-center mr-3 font-weight-bold text-white"
                   style="width:38px;height:38px;min-width:38px;background:#4a78f5;font-size:13px;">
                {{initials}}
              </div>
              <div>
                <div class="font-weight-bold" style="color:#1a2b4a;">{{fullname}}</div>
                <div class="small text-muted">{{email}}</div>
              </div>
            </div>
          </td>
          <td class="align-middle py-3">
            <div class="d-flex align-items-center">
              <div class="progress flex-grow-1 mr-3" style="height:8px;border-radius:4px;background:#eef0f5;max-width:220px;">
                <div class="progress-bar" style="width:{{score_pct}}%;background:{{#score_green_u}}#34c97a{{/score_green_u}}{{#score_yellow_u}}#f0a500{{/score_yellow_u}}{{#score_red_u}}#e94e4e{{/score_red_u}};border-radius:4px;"></div>
              </div>
              <span class="font-weight-bold" style="font-size:14px;color:{{#score_green_u}}#34c97a{{/score_green_u}}{{#score_yellow_u}}#f0a500{{/score_yellow_u}}{{#score_red_u}}#e94e4e{{/score_red_u}};">
                {{score_pct}}%
              </span>
            </div>
          </td>
          <td class="align-middle py-3">
            <span style="display:inline-flex;align-items:center;border-radius:20px;padding:4px 12px;font-size:12px;font-weight:600;
              {{#score_green_u}}background:#e6f9f0;color:#1a9e5c;{{/score_green_u}}
              {{#score_yellow_u}}background:#fff8e6;color:#d48a00;{{/score_yellow_u}}
              {{#score_red_u}}background:#fff0f0;color:#e94e4e;{{/score_red_u}}">
              <span style="width:7px;height:7px;border-radius:50%;margin-right:5px;
                {{#score_green_u}}background:#1a9e5c;{{/score_green_u}}
                {{#score_yellow_u}}background:#d48a00;{{/score_yellow_u}}
                {{#score_red_u}}background:#e94e4e;{{/score_red_u}}"></span>
              {{status_label}}
            </span>
          </td>
          <td class="text-right px-4 align-middle py-3">
            <a href="{{{wwwroot}}}/local/skillgap/admin/analytics_user_detail.php?compid={{compid}}&userid={{userid}}"
               class="btn btn-sm btn-outline-secondary" style="border-radius:6px;font-size:12px;">
              {{#str}} view_details, local_skillgap {{/str}} <i class="fa fa-external-link ml-1" style="font-size:10px;"></i>
            </a>
          </td>
        </tr>
        {{/user_rows}}
      </tbody>
    </table>
    {{/has_users}}
    {{^has_users}}
    <div class="text-center py-5 text-muted">
      <i class="fa fa-users fa-2x mb-2 d-block"></i>
      {{#str}} no_data, local_skillgap {{/str}}
    </div>
    {{/has_users}}
  </div>

</div>

<script>
(function() {
  var search  = document.getElementById('sg-user-search');
  var filter  = document.getElementById('sg-user-status-filter');
  function filterUsers() {
    var q  = search ? search.value.toLowerCase() : '';
    var st = filter ? filter.value.toLowerCase() : '';
    document.querySelectorAll('.sg-user-row').forEach(function(row) {
      var name   = (row.getAttribute('data-name')   || '').toLowerCase();
      var status = (row.getAttribute('data-status') || '').toLowerCase();
      var show   = (!q || name.includes(q)) && (!st || status.includes(st));
      row.style.display = show ? '' : 'none';
    });
  }
  if (search) { search.addEventListener('input',  filterUsers); }
  if (filter) { filter.addEventListener('change', filterUsers); }
})();
</script>
