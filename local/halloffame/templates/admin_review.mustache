{{! local_halloffame/admin_review — PRO UI }}
<style>
.hof-admin-container {
  padding: 30px;
  max-width: 1400px;
  margin: auto;
}

.hof-admin-header h1 {
  font-size: 28px;
  font-weight: 800;
}

.hof-subtitle {
  color: #777;
  margin-top: 5px;
}

.hof-review-grid-wrap {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-top: 20px;
}

.hof-review-card {
  background: #fff;
  border-radius: 16px;
  padding: 20px;
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 20px;
  box-shadow: 0 6px 18px rgba(0,0,0,0.08);
}

.hof-review-title {
  font-size: 18px;
  font-weight: 700;
  display: flex;
  gap: 8px;
}

.hof-review-meta div {
  margin-top: 6px;
  font-size: 14px;
}

.hof-review-notes {
  margin-top: 10px;
  font-size: 14px;
  color: #555;
}

.hof-review-cert {
  width: 100%;
  border-radius: 12px;
  cursor: pointer;
}

.hof-review-cert-pdf {
  border: 2px dashed #ddd;
  padding: 30px;
  text-align: center;
  cursor: pointer;
}

.hof-review-actions {
  grid-column: 1 / -1;
  display: flex;
  justify-content: space-between;
  margin-top: 10px;
}

.hof-btn {
  padding: 8px 14px;
  border-radius: 8px;
  font-weight: 600;
}

.hof-btn-success {
  background: #16a34a;
  color: #fff;
}

.hof-btn-danger {
  background: #dc2626;
  color: #fff;
}

.hof-review-comments {
  grid-column: 1 / -1;
  background: #f9fafb;
  padding: 15px;
  border-radius: 10px;
}

.hof-comment-item {
  display: flex;
  gap: 10px;
  margin-bottom: 10px;
}

.hof-comment-avatar {
  width: 35px;
  height: 35px;
  border-radius: 50%;
}

.hof-comment-body {
  background: #fff;
  padding: 8px 12px;
  border-radius: 10px;
  width: 100%;
}

.hof-comment-head {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
}

.hof-empty-big {
  text-align: center;
  padding: 60px;
  color: #888;
}
</style>
<div class="hof-admin-container">

  <!-- HEADER -->
  <div class="hof-admin-header">
    <div>
      <h1>{{#str}}review,local_halloffame{{/str}}</h1>
      <p class="hof-subtitle">Manage and review submitted achievements</p>
    </div>
  </div>

  {{#hassubmissions}}
  <div class="hof-review-grid-wrap">

    {{#submissions}}
    <div class="hof-review-card">

      <!-- LEFT: DETAILS -->
      <div class="hof-review-left">

        <div class="hof-review-title">
          <i class="fa fa-certificate"></i>
          <span>{{title}}</span>
        </div>

        <div class="hof-review-meta">
          <div><strong>{{#str}}issuingorganisation,local_halloffame{{/str}}:</strong> {{issuer}}</div>
          <div><strong>{{#str}}dateofissue,local_halloffame{{/str}}:</strong> {{issuedatefmt}}</div>
          <div><strong>{{#str}}certificatetype,local_halloffame{{/str}}:</strong> {{type}}</div>
        </div>

        {{#notes}}
        <div class="hof-review-notes">
          <strong>{{#str}}additionalnotes,local_halloffame{{/str}}:</strong>
          <p>{{notes}}</p>
        </div>
        {{/notes}}

        <div class="hof-review-user">
          <i class="fa fa-user"></i>
          {{fullname}}
        </div>

      </div>

      <!-- RIGHT: CERTIFICATE -->
      <div class="hof-review-right">
{{#fileurl}}
          <span class="hof-review-label">{{#str}}externalcertificate,local_halloffame{{/str}}:</span>
          <span>
            {{#fileisimage}}
            <img src="{{{fileurl}}}" class="hof-review-cert hof-cert-clickable"
                 data-fileurl="{{{fileurl}}}" data-title="{{title}}"
                 data-fileisimage="1" data-candownload="1"
                 alt="Certificate" title="{{#str}}viewcertificate,local_halloffame{{/str}}"
                 style="cursor:pointer"/>
            {{/fileisimage}}
            {{^fileisimage}}
            <div class="hof-review-cert hof-cert-clickable"
                 data-fileurl="{{{fileurl}}}" data-title="{{title}}"
                 data-fileisimage="0" data-candownload="1"
                 title="{{#str}}viewcertificate,local_halloffame{{/str}}"
                 style="cursor:pointer;display:inline-flex;flex-direction:column;align-items:center;padding:12px;border:2px dashed #dce3ec;border-radius:10px;gap:4px;">
              <span style="font-size:2rem;">📄</span>
              <span style="font-weight:700;">Certificate</span>
              <span style="font-size:.8rem;color:#888;"></span>
            </div>
            {{/fileisimage}}
            <div  style="margin-top:8px; text-align: center;">
              <a href="{{{fileurl}}}" style="background: #003152; display: none;" target="_blank" rel="noopener noreferrer"
                 class="hof-btn hof-btn-sm hof-btn-secondary">
                <i class="fa fa-external-link" aria-hidden="true"></i>
                Open in new tab
              </a>
              <a href="{{{fileurl}}}"  style="background: #003152;" download
                 class="hof-btn hof-btn-sm hof-btn-secondary">
                <i class="fa fa-download" aria-hidden="true"></i>
                Download
              </a>
            </div>
          </span>
          {{/fileurl}}

      </div>

      <!-- ACTION BAR -->
      <div class="hof-review-actions">

        <button class="hof-toggle-comments d-none" data-id="{{id}}">
          <i class="fa fa-comments"></i>
          Comments ({{commentcount}})
        </button>

        <div class="hof-actions-right">
          <a href="{{rejecturl}}"
             class="hof-btn hof-btn-danger"
             onclick="return confirm('Reject this submission?')">
            <i class="fa fa-times"></i> Reject
          </a>

          <a href="{{approveurl}}"
             class="hof-btn hof-btn-success">
            <i class="fa fa-check"></i> Approve
          </a>
        </div>

      </div>

      <!-- COMMENTS -->
      <div class="hof-review-comments" id="comments-{{id}}" style="display:none;">

        <div class="hof-comments-list" id="hof-comments-list-submission-{{id}}">
          {{#comments}}
          <div class="hof-comment-item">
            <img src="{{{userpictureurl}}}" class="hof-comment-avatar"/>

            <div class="hof-comment-body">
              <div class="hof-comment-head">
                <strong>{{fullname}}</strong>
                <span>{{timecreatedstr}}</span>

                {{#canbedeleted}}
                <button class="hof-comment-delete-btn" data-commentid="{{id}}">
                  <i class="fa fa-trash"></i>
                </button>
                {{/canbedeleted}}
              </div>

              <p>{{{message}}}</p>
            </div>
          </div>
          {{/comments}}

          {{^comments}}
          <div class="hof-empty-small">No comments yet</div>
          {{/comments}}
        </div>

        <div class="hof-comment-form">
          <textarea class="hof-comment-input"
                    placeholder="Write a comment..."
                    data-id="{{id}}" data-type="submission"></textarea>

          <button class="hof-btn hof-btn-primary hof-comment-submit"
                  data-id="{{id}}" data-type="submission">
            <i class="fa fa-paper-plane"></i> Post
          </button>
        </div>

      </div>

    </div>
    {{/submissions}}

  </div>
  {{/hassubmissions}}

  {{^hassubmissions}}
  <div class="hof-empty-big">
    <i class="fa fa-inbox"></i>
    <p>No submissions found</p>
  </div>
  {{/hassubmissions}}

</div>