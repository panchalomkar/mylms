{{! local_halloffame/admin_panel — professional full screen }}

<style>
/* WRAPPER */
.hof-admin-page {
  padding: 30px;
  background: #f4f7fb;
  min-height: 100vh;
}

/* HEADER */
.hof-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25px;
}

.hof-panel-title {
  font-size: 24px;
  font-weight: 700;
  color: #003152;
}

/* CARD */
.hof-admin-card {
  background: #ffffff;
  border-radius: 16px;
  padding: 30px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.06);
}

/* FORM */
.hof-award-form {
  width: 100%;
}

/* GRID */
.hof-form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.hof-form-group {
  margin-bottom: 18px;
}

/* LABEL */
.hof-label {
  display: block;
  font-weight: 600;
  margin-bottom: 6px;
  color: #003152;
}

/* INPUT */
.hof-input,
.hof-select {
  width: 100%;
  padding: 10px 14px;
  border-radius: 8px;
  border: 1px solid #ddd;
  transition: 0.3s;
}

.hof-input:focus,
.hof-select:focus {
  border-color: #ec9707;
  box-shadow: 0 0 0 2px rgba(236,151,7,0.2);
}

/* TEXTAREA */
.hof-textarea {
  min-height: 100px;
}

/* BUTTONS */
.hof-btn {
  border: none;
  padding: 10px 18px;
  border-radius: 8px;
  cursor: pointer;
  text-decoration: none;
}

.hof-btn-primary {
  background: linear-gradient(135deg, #003152, #065a96);
  color: #fff;
}

.hof-btn-secondary {
  background: #ec9707;
  color: #fff;
}

.hof-form-actions {
  margin-top: 25px;
  display: flex;
  gap: 12px;
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .hof-form-row {
    grid-template-columns: 1fr;
  }
}
</style>

<div class="hof-admin-page">

  <!-- HEADER -->
  <div class="hof-panel-header">
    <h2 class="hof-panel-title">
      {{#str}}createaward,local_halloffame{{/str}}
    </h2>
  </div>

  <!-- CARD -->
  <div class="hof-admin-card">

    <form method="post" enctype="multipart/form-data" class="hof-award-form">
      <input type="hidden" name="sesskey" value="{{sesskey}}"/>

      <!-- LEVEL + DEPARTMENT -->
      <div class="hof-form-row">
        <div class="hof-form-group">
          <label class="hof-label">{{#str}}selectlevel,local_halloffame{{/str}}</label>
          <select name="level" id="levelSelect" class="hof-select">
            <option value="global">Global</option>
            <option value="department">Department</option>
          </select>
        </div>

        <div class="hof-form-group" id="departmentRow">
          <label class="hof-label">{{#str}}selectdepartment,local_halloffame{{/str}}</label>
          <select name="department" class="hof-select">
            <option value="">{{#str}}alldepartments,local_halloffame{{/str}}</option>
            {{#departments}}
              <option value="{{value}}">{{label}}</option>
            {{/departments}}
          </select>
        </div>
      </div>

      <!-- CATEGORY + USER -->
      <div class="hof-form-row">
        <div class="hof-form-group">
          <label class="hof-label">{{#str}}selectcategory,local_halloffame{{/str}}</label>
          <select name="category" class="hof-select">
            <option value="">Select</option>
            {{#categories}}
              <option value="{{name}}">{{name}}</option>
            {{/categories}}
          </select>
        </div>

        <div class="hof-form-group">
          <label class="hof-label">{{#str}}selectachiever,local_halloffame{{/str}}</label>
          <select name="userid" class="hof-select" required>
            <option value="">Select User</option>
            {{#users}}
              <option value="{{id}}">{{fullname}}</option>
            {{/users}}
          </select>
        </div>
      </div>

      <!-- TITLE -->
      <div class="hof-form-group">
        <label class="hof-label">{{#str}}awardtitle,local_halloffame{{/str}}</label>
        <input type="text" name="title" class="hof-input" required/>
      </div>

      <!-- MONTH -->
      <div class="hof-form-row">
        <div class="hof-form-group">
          <label class="hof-label">{{#str}}selectmonth,local_halloffame{{/str}}</label>
          <select name="month" class="hof-select">
            {{#months}}
              <option value="{{value}}">{{label}}</option>
            {{/months}}
          </select>
        </div>

        <div class="hof-form-group">
          <label class="hof-label">Upload Certificate</label>
          <input type="file" name="achieverimage" class="hof-input"/>
        </div>
      </div>

      <!-- MESSAGE -->
      <div class="hof-form-group">
        <label class="hof-label">{{#str}}messagetodisplay,local_halloffame{{/str}}</label>
        <textarea name="message" class="hof-input hof-textarea"></textarea>
      </div>

      <!-- ACTIONS -->
      <div class="hof-form-actions">
        <button type="submit" class="hof-btn hof-btn-primary">
          Save
        </button>

        <a href="{{backurl}}" style="background:#ec9707; border-color:#ec9707;" class="hof-btn hof-btn-secondary">
          Cancel
        </a>
      </div>

    </form>

  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {

    var levelSelect = document.getElementById("levelSelect");
    var departmentRow = document.getElementById("departmentRow");

    function toggleDepartment() {
        departmentRow.style.display = (levelSelect.value === "department") ? "block" : "none";
    }

    toggleDepartment();
    levelSelect.addEventListener("change", toggleDepartment);
});
</script>