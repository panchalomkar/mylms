{{! People Plugin - Country Filter — search + tag selection like Course filter }}
<div class="filterslist people-subfilter" data-filter-name="country">
    <div class="people-subfilter-header" role="button" aria-expanded="false" tabindex="0">
        <span class="people-subfilter-title">
            <i class="fa fa-globe mr-1"></i>
            {{#str}}country, local_people{{/str}}
        </span>
        <i class="fa fa-chevron-down people-subfilter-icon"></i>
    </div>
    <div class="people-subfilter-body" style="display:none;">
        {{#country}}
        <a href="#" data-name="country" class="reset people-clear-link">
            <i class="fa fa-times-circle mr-1"></i>{{#str}}clear, local_people{{/str}}
        </a>
        {{/country}}
        <form id="form-country" method="post" action="">
            {{#country}}
            <input type="hidden" name="filter-true" class="filter-true" value="true">
            {{/country}}

            {{! Selected country tags }}
            <div class="people-selected-courses" id="people-selected-country-display">
                {{#countryopt}}{{#selected}}
                <span class="people-course-selected-tag" data-value="{{{key}}}">
                    <span class="people-course-tag-text">{{{value}}}</span>
                    <span class="people-course-tag-remove" title="Remove"><i class="fa fa-times"></i></span>
                </span>
                {{/selected}}{{/countryopt}}
            </div>

            {{! Search box }}
            <div class="people-course-search-wrap">
                <input type="text" class="form-control people-course-search-input people-select-search"
                       data-target="people-country-checkbox-list"
                       placeholder="Search countries..." autocomplete="off">
                <i class="fa fa-search people-course-search-icon"></i>
            </div>

            {{! Hidden real select }}
            <select class="people-hidden-select" multiple="multiple" id="menucountryop" name="countryop[]" style="display:none;">
                {{#countryopt}}
                    <option value="{{{key}}}" {{{selected}}}>{{{value}}}</option>
                {{/countryopt}}
            </select>

            {{! Checkbox list }}
            <div class="people-course-list-wrap">
                <div class="people-course-checkbox-list people-generic-checkbox-list" id="people-country-checkbox-list"
                     data-tags-container="people-selected-country-display"
                     data-hidden-select="menucountryop">
                    {{#countryopt}}
                    <label class="people-course-item" data-value="{{{key}}}" data-label="{{{value}}}">
                        <input type="checkbox" class="people-generic-checkbox" value="{{{key}}}"
                               {{#selected}}checked{{/selected}}>
                        <span class="people-course-item-label">{{{value}}}</span>
                    </label>
                    {{/countryopt}}
                </div>
            </div>

            <input type="hidden" name="multipleselectfilter" value="country">
        </form>
    </div>
</div>
