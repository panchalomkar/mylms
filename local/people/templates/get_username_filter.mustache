{{! People Plugin - Username Filter }}
<div class="filterslist people-subfilter" data-filter-name="username">
    <div class="people-subfilter-header" role="button" aria-expanded="false" tabindex="0">
        <span class="people-subfilter-title">
            <i class="fa fa-id-card mr-1"></i>
            {{#str}}username, local_people{{/str}}
        </span>
        <i class="fa fa-chevron-down people-subfilter-icon"></i>
    </div>
    <div class="people-subfilter-body" style="display:none;">
        {{#usernamevalue}}
        <a href="#" data-name="username" class="reset people-clear-link">
            <i class="fa fa-times-circle mr-1"></i>{{#str}}clear, local_people{{/str}}
        </a>
        {{/usernamevalue}}
        <form id="form-username" method="post" action="">
            {{#usernamevalue}}
            <input class="filter-true" type="hidden" name="filter-true" value="true">
            {{/usernamevalue}}
            <div class="form-group mb-1">
                <div class="people-text-filter-wrap">
                    <input type="text"
                           id="username"
                           name="username"
                           class="form-control people-text-filter-input"
                           placeholder="{{#str}}Search..., local_people{{/str}}"
                           value="{{{username}}}"
                           autocomplete="off">
                    <span class="people-filter-enter-hint">Press Enter to filter</span>
                </div>
            </div>
            <input type="hidden" name="textfilter" value="username">
        </form>
    </div>
</div>
