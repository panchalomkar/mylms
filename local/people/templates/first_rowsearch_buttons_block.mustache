{{!
    People Plugin - Action Toolbar Template
    Moodle 5.0.2 + REMUI Theme 5
}}

<div class="people-toolbar mb-3">

    {{! Search box }}
    <div class="people-search-box">
        <form id="form-search" method="GET" action="{{{action}}}">
            <input value="{{{search}}}" name="txt" id="txt"
                   placeholder="{{#str}}Search..., local_people{{/str}}"
                   class="form-control" type="text" autocomplete="off">
            <button class="people-search-clear" id="searchbutton" type="button"
                    style="display:{{{search}}};" aria-label="Clear search">
                <i class="fa fa-times"></i>
            </button>
        </form>
    </div>

    {{! Company / Tenant selector }}
    <div class="people-company-select">
        {{^iscompanyselect}}
        <select id="menucompany" class="custom-select" name="company">
            {{#companies}}
            <option value="">{{#str}}company_choose, local_people{{/str}}</option>
            <option value="NONE" {{none_selected}}>{{#str}}company_without, local_people{{/str}}</option>
            <optgroup label="{{#str}}company_all, local_people{{/str}}">
                <option value="ALL" {{all_selected}}>{{#str}}company_all_excluding_main, local_people{{/str}}</option>
                {{#tenants}}
                <option value="{{{id}}}" {{selected}}>{{{name}}}</option>
                {{/tenants}}
            </optgroup>
            {{/companies}}
        </select>
        {{/iscompanyselect}}
        {{#iscompanyselect}}
        {{#companies}}
        <select name="company" class="custom-select">
            <option value="{{{id}}}">{{{name}}}</option>
        </select>
        {{/companies}}
        {{/iscompanyselect}}
    </div>

    {{! Action buttons }}
    <div class="people-toolbar__actions">

        {{! Add User }}
        <a class="people-btn people-btn--accent create-user-top" href="#" role="button"
           title="{{#str}}new_user, local_people{{/str}}">
            <i class="fa fa-user-plus"></i>
            <span class="d-none d-lg-inline">{{#str}}new_user, local_people{{/str}}</span>
        </a>

        {{! Enrol Users }}
        <a id="enrol_user" class="people-btn people-btn--primary bulk-action button_disable" href="#" role="button"
           title="{{#str}}enrol_users, local_people{{/str}}" style="opacity:.4;cursor:default;">
            <i class="fa fa-graduation-cap"></i>
            <span class="d-none d-lg-inline">{{#str}}enrol_users, local_people{{/str}}</span>
        </a>

        {{! Suspend }}
        <a data-action="suspend" data-showmodal="0"
           class="people-btn people-btn--primary btn-bulk-suspend_unsuspend bulk-action button_disable"
           href="#" role="button" style="opacity:.4;cursor:default;"
           title="{{#str}}suspend, local_people{{/str}}">
            <i class="fa fa-user-times"></i>
            <span class="d-none d-xl-inline">{{#str}}suspend, local_people{{/str}}</span>
        </a>

        {{! More actions dropdown }}
        <div class="people-dropdown">
            <button class="people-btn people-btn--secondary" type="button" aria-label="More actions">
                <i class="fa fa-ellipsis-v"></i>
            </button>
            <div class="people-dropdown__menu">

                <a href="{{{uploadURL}}}" class="people-dropdown__item">
                    <i class="fa fa-upload"></i>
                    {{#str}}bulk_upload, local_people{{/str}}
                </a>

                <a data-action="cohortadd" data-showmodal="1"
                   class="people-dropdown__item btn-bulk-action bulk-action button_disable" href="#">
                    <i class="fa fa-users"></i>
                    {{#str}}bulk_add_cohort, local_people{{/str}}
                </a>

                <a data-action="download" data-showmodal="0"
                   class="people-dropdown__item btn-bulk-action bulk-action button_disable" href="#">
                    <i class="fa fa-download"></i>
                    {{#str}}bulk_download, local_people{{/str}}
                </a>

                <a data-action="message" data-showmodal="1"
                   class="people-dropdown__item btn-bulk-action bulk-action button_disable" href="#">
                    <i class="fa fa-envelope"></i>
                    {{#str}}bulk_send_message, local_people{{/str}}
                </a>

                <a data-action="unlock" data-showmodal="0"
                   class="people-dropdown__item btn-bulk-suspend_unsuspend bulk-action button_disable" href="#">
                    <i class="fa fa-unlock"></i>
                    {{#str}}enable, local_people{{/str}}
                </a>

                {{#capability}}
                <a data-action="delete" data-showmodal="0"
                   class="people-dropdown__item btn-bulk-action bulk-action button_disable" href="#"
                   style="color:#dc3545;">
                    <i class="fa fa-trash" style="color:#dc3545;"></i>
                    {{#str}}bulk_delete, local_people{{/str}}
                </a>
                {{/capability}}

            </div>
        </div>

    </div>

</div>

{{! Hidden clear-all form }}
<form id="form-clearall" style="display:none;" method="post" action="{{{action}}}">
    <input type="hidden" name="clearall" id="clearall" value="clearall">
</form>

{{! Add User (hidden until opened in modal) }}
{{> local_people/register_form}}

{{#js}}
// Dropdown toggle on click for mobile.
(function() {
    var drops = document.querySelectorAll('.people-dropdown');
    drops.forEach(function(d) {
        var btn = d.querySelector('.people-btn');
        if (!btn) return;
        btn.addEventListener('click', function(e) {
            e.stopPropagation();
            d.classList.toggle('open');
        });
    });
    document.addEventListener('click', function() {
        drops.forEach(function(d) { d.classList.remove('open'); });
    });
})();
{{/js}}
