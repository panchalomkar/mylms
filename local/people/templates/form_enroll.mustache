{{!
    People Plugin - Enrol Form Template
    Moodle 5.0.2 + REMUI Theme 5
}}
<div id="people-enrol-form-wrap">
    <form class="form-horizontal" method="POST" id="EnrolForm" action="">
        <input type="hidden" name="sesskey" value="{{{inputs}}}">
        <input type="hidden" name="action" value="enroll">

        <div class="form-group mb-3">
            <label for="selectroles" class="form-label fw-semibold">
                {{#str}}role, local_people{{/str}}
            </label>
            {{{select}}}
        </div>

        <div class="form-group mb-3">
            <label for="selectcourses" class="form-label fw-semibold">
                {{#str}}courses, local_people{{/str}}
                <small class="text-muted d-block fw-normal">{{#str}}course_select_help, local_people{{/str}}</small>
            </label>
            {{{multiselect}}}
        </div>

        <div class="row g-3 mb-2">
            <div class="col-md-6">
                <label for="startdate" class="form-label fw-semibold">{{#str}}startdate, local_people{{/str}}</label>
                <div class="people-date-group">
                    <input id="startdate" name="startdate" type="text"
                           class="form-control" placeholder="MM/DD/YYYY" value=""
                           autocomplete="off">
                    <button type="button" class="people-date-clear" id="clearstartdate">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-6">
                <label for="enddate" class="form-label fw-semibold">{{#str}}enddate, local_people{{/str}}</label>
                <div class="people-date-group">
                    <input id="enddate" name="enddate" type="text"
                           class="form-control" placeholder="MM/DD/YYYY" value=""
                           autocomplete="off">
                    <button type="button" class="people-date-clear" id="clearenddate">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
            </div>
        </div>

    </form>
</div>
