{{!
    People Plugin - Left Panel Filter Block
    multifilter tags rendered hidden in panel; JS reads and mirrors to top bar
}}

{{! Applied filter tag data — hidden, read by JS to populate top bar }}
{{#multifilter}}
<div class="people-filter-tags-source" aria-hidden="true">
    {{#fields}}
    <span class="people-filter-tag-src" data-name="{{{fields}}}" data-label="{{{strfield}}}"></span>
    {{/fields}}
</div>
{{/multifilter}}

{{! Left panel filter accordion groups }}
<div id="people-filter-groups">

    {{! Text Filters }}
    <div class="people-accordion">
        <button class="people-accordion-header people-accordion-header--open" aria-expanded="true">
            <span><i class="fa fa-font mr-1"></i>{{#str}}text_filters, local_people{{/str}}</span>
            <i class="fa fa-chevron-down people-accordion-icon"></i>
        </button>
        <div class="people-accordion-body" style="display:block;">
            {{{userfullnamefilter}}}
            {{{emailfilter}}}
            {{{usernamefilter}}}
        </div>
    </div>

    {{! Location Filters }}
    <div class="people-accordion">
        <button class="people-accordion-header" aria-expanded="false">
            <span><i class="fa fa-map-marker mr-1"></i>{{#str}}location_filters, local_people{{/str}}</span>
            <i class="fa fa-chevron-down people-accordion-icon"></i>
        </button>
        <div class="people-accordion-body" style="display:none;">
            {{{cityfilter}}}
            {{{countryfilter}}}
        </div>
    </div>

    {{! Role Filters }}
    <div class="people-accordion">
        <button class="people-accordion-header" aria-expanded="false">
            <span><i class="fa fa-shield mr-1"></i>{{#str}}role_filters, local_people{{/str}}</span>
            <i class="fa fa-chevron-down people-accordion-icon"></i>
        </button>
        <div class="people-accordion-body" style="display:none;">
            {{{courserolefilter}}}
            {{{systemrolefilter}}}
            {{{authfilter}}}
        </div>
    </div>

    {{! Status Filters }}
    <div class="people-accordion">
        <button class="people-accordion-header" aria-expanded="false">
            <span><i class="fa fa-toggle-on mr-1"></i>{{#str}}status_filters, local_people{{/str}}</span>
            <i class="fa fa-chevron-down people-accordion-icon"></i>
        </button>
        <div class="people-accordion-body" style="display:none;">
            {{{confirmedfilter}}}
            {{{suspendedfilter}}}
        </div>
    </div>

  {{! Department Filters }}
    <div class="people-accordion">
        <button class="people-accordion-header" aria-expanded="false">
            <span><i class="fa fa-sitemap mr-1"></i>{{#str}}department, local_people{{/str}}</span>
            <i class="fa fa-chevron-down people-accordion-icon"></i>
        </button>
        <div class="people-accordion-body" style="display:none;">
            {{{departmentfilter}}}
        </div>
    </div>
    {{! Date Filters }}
    <div class="people-accordion">
        <button class="people-accordion-header" aria-expanded="false">
            <span><i class="fa fa-calendar mr-1"></i>{{#str}}date_filters, local_people{{/str}}</span>
            <i class="fa fa-chevron-down people-accordion-icon"></i>
        </button>
        <div class="people-accordion-body" style="display:none;">
            {{{firstaccessdfilter}}}
            {{{lastaccessedfilter}}}
            {{{lastmodifiedfilter}}}
        </div>
    </div>

</div>
