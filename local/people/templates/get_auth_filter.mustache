{{! People Plugin - Authentication Filter }}
<div class="filterslist people-subfilter" data-filter-name="auth">
    <div class="people-subfilter-header" role="button" aria-expanded="false" tabindex="0">
        <span class="people-subfilter-title">
            <i class="fa fa-key mr-1"></i>
            {{#str}}auth, local_people{{/str}}
        </span>
        <i class="fa fa-chevron-down people-subfilter-icon"></i>
    </div>
    <div class="people-subfilter-body" style="display:none;">
        {{#authenticationop}}
        <a href="#" data-name="auth" class="reset people-clear-link">
            <i class="fa fa-times-circle mr-1"></i>{{#str}}clear, local_people{{/str}}
        </a>
        {{/authenticationop}}
        <form id="form-auth" method="post" action="">
            {{#authenticationop}}
            <input type="hidden" class="filter-true" name="filter-true" value="true">
            {{/authenticationop}}
            <div class="people-select-wrap">
                {{{select}}}
            </div>
            <input type="hidden" name="selectfilter" value="auth">
        </form>
    </div>
</div>
