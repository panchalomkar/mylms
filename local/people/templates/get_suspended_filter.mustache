{{! People Plugin - Suspended Account Filter }}
<div class="filterslist people-subfilter" data-filter-name="suspended">
    <div class="people-subfilter-header" role="button" aria-expanded="false" tabindex="0">
        <span class="people-subfilter-title">
            <i class="fa fa-ban mr-1"></i>
            {{#str}}suspended, local_people{{/str}}
        </span>
        <i class="fa fa-chevron-down people-subfilter-icon"></i>
    </div>
    <div class="people-subfilter-body" style="display:none;">
        {{#suspendedvalue}}
        <a href="#" data-name="suspended" class="reset people-clear-link">
            <i class="fa fa-times-circle mr-1"></i>{{#str}}clear, local_people{{/str}}
        </a>
        {{/suspendedvalue}}
        {{#unsuspendedvalue}}
        <a href="#" data-name="unsuspended" class="reset people-clear-link">
            <i class="fa fa-times-circle mr-1"></i>{{#str}}clear, local_people{{/str}}
        </a>
        {{/unsuspendedvalue}}
        <form id="form-suspended" method="post" action="">
            <div class="people-radio-group">
                {{{input2}}}
                {{{input}}}
            </div>
            {{#suspendedvalue}}
            <input class="filter-true" type="hidden" name="filter-true" value="true">
            {{/suspendedvalue}}
            {{#unsuspendedvalue}}
            <input class="filter-true" type="hidden" name="filter-true" value="true">
            {{/unsuspendedvalue}}
            <input type="hidden" name="selectfilter" value="suspended">
        </form>
    </div>
</div>
