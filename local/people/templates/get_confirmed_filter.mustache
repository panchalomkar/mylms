{{! People Plugin - Confirmed Filter }}
<div class="filterslist people-subfilter" data-filter-name="confirmed">
    <div class="people-subfilter-header" role="button" aria-expanded="false" tabindex="0">
        <span class="people-subfilter-title">
            <i class="fa fa-check-circle mr-1"></i>
            {{#str}}confirmed, local_people{{/str}}
        </span>
        <i class="fa fa-chevron-down people-subfilter-icon"></i>
    </div>
    <div class="people-subfilter-body" style="display:none;">
        {{#confirmedop}}
        <a href="#" data-name="confirmed" class="reset people-clear-link">
            <i class="fa fa-times-circle mr-1"></i>{{#str}}clear, local_people{{/str}}
        </a>
        {{/confirmedop}}
        {{#unconfirmed}}
        <a href="#" data-name="unconfirmed" class="reset people-clear-link">
            <i class="fa fa-times-circle mr-1"></i>{{#str}}clear, local_people{{/str}}
        </a>
        {{/unconfirmed}}
        <form id="form-confirmed" method="post" action="">
            <div class="people-radio-group">
                {{{input2}}}
                {{{input}}}
            </div>
            {{#confirmedop}}
            <input class="filter-true" type="hidden" name="filter-true" value="true">
            {{/confirmedop}}
            {{#unconfirmed}}
            <input class="filter-true" type="hidden" name="filter-true" value="true">
            {{/unconfirmed}}
            <input type="hidden" name="selectfilter" value="confirmed">
        </form>
    </div>
</div>
