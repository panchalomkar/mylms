{{! People Plugin - System Role Filter }}
<div class="filterslist people-subfilter" data-filter-name="systemrole">
    <div class="people-subfilter-header" role="button" aria-expanded="false" tabindex="0">
        <span class="people-subfilter-title">
            <i class="fa fa-user-secret mr-1"></i>
            {{#str}}systemrole, local_people{{/str}}
        </span>
        <i class="fa fa-chevron-down people-subfilter-icon"></i>
    </div>
    <div class="people-subfilter-body" style="display:none;">
        {{#system}}
        <a href="#" data-name="systemrole" class="reset people-clear-link">
            <i class="fa fa-times-circle mr-1"></i>{{#str}}clear, local_people{{/str}}
        </a>
        {{/system}}
        <form id="form-systemrole" method="post" action="">
            {{#system}}
            <input type="hidden" class="filter-true" name="filter-true" value="true">
            {{/system}}
            <div class="people-select-wrap">
                {{{select}}}
            </div>
            <input type="hidden" name="systemrole" value="systemrole">
        </form>
    </div>
</div>
