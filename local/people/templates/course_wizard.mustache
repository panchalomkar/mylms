{{!
    People Plugin - Main Layout Template
    Moodle 5.0.2 + REMUI Theme 5 compatible
}}
<div id="people-plugin-root">

    {{! Page Header }}
    <div class="people-page-header mb-3">
        <div class="d-flex align-items-center">
            <div class="people-page-header__accent"></div>
            <div>
                <h2 class="people-page-header__title">{{#str}}pluginname, local_people{{/str}}</h2>
                <p class="people-page-header__subtitle text-light">{{#str}}peopledesc, local_people{{/str}}</p>
            </div>
        </div>
        <button class="people-filter-toggle" aria-expanded="true" aria-controls="people-filter-sidebar">
            <i class="fa fa-sliders"></i>
            {{#str}}filters, local_people{{/str}}
        </button>
    </div>

    {{! Action Toolbar }}
    {{{buttonblock}}}

    {{! Applied Filter Tags — always rendered, populated by JS from panel's hidden tags }}
    <div id="people-top-filter-tags" class="people-top-filter-tags" style="display:none;"></div>

    {{! Two-column layout: Filter panel + User table }}
    <div class="people-layout">

        {{! LEFT FILTER PANEL }}
        <div class="people-filter-panel" id="people-filter-sidebar" aria-label="Filter Panel">
            <div class="people-filter-panel__inner">
                <div class="people-filter-panel__header">
                    <h6 class="people-filter-panel__title text-light">
                        <i class="fa fa-filter"></i>
                        {{#str}}filter_users, local_people{{/str}}
                    </h6>
                </div>
                <div class="people-filter-panel__body">
                    {{! Filter submit/reset actions }}
                    <div class="people-filter-actions">
                        <button class="people-btn people-btn--primary people-btn--sm" id="send" type="button">
                            <i class="fa fa-check"></i>
                            {{#str}}apply_filter, local_people{{/str}}
                        </button>
                        <a class="people-btn people-btn--secondary people-btn--sm" id="reset-form" href="#">
                            <i class="fa fa-times"></i>
                            {{#str}}Clear_all_filter, local_people{{/str}}
                        </a>
                    </div>
                    {{! Filter accordion groups rendered from PHP }}
                    {{{filterblock}}}
                </div>
            </div>
        </div>

        {{! MAIN CONTENT AREA }}
        <div class="people-main-content">
            {{{userblock}}}
        </div>

    </div>

</div>
