{{!
    People Plugin - User Table Template (Redesigned)
    Moodle 5.0.2 + REMUI Theme 5
    Brand: #003152, #ec9707
}}
<table class="mt-table table-people">
    <thead>
        <tr>
            {{#head}}
            <th class="people-check-col" scope="col">
                <input type="checkbox" id="bulk-select-all" title="Select all" style="accent-color:#003152;">
            </th>
            <th scope="col" data-sort="firstname" data-order="{{{sortorder}}}">
                {{#str}}fullname, local_people{{/str}}
                {{#phsortingup}}<i class="fa fa-sort-asc sort-icon"></i>{{/phsortingup}}
                {{#phsortingdown}}<i class="fa fa-sort-desc sort-icon"></i>{{/phsortingdown}}
                {{#phsorting}}<i class="fa fa-sort sort-icon"></i>{{/phsorting}}
            </th>
            <th scope="col">{{#str}}email, local_people{{/str}}</th>
            <th scope="col">{{#str}}dept, local_people{{/str}}</th>
            <th scope="col">{{#str}}courseenrolled, local_people{{/str}}</th>
            <th scope="col">{{#str}}coursecompleted, local_people{{/str}}</th>
            {{#tenant}}
            <th scope="col" class="tenant-col">{{#str}}multitenant, local_people{{/str}}</th>
            {{/tenant}}
            <th scope="col" data-sort="lastaccess" data-order="{{{sortorder}}}">
                {{#str}}lastaccess, local_people{{/str}}
                {{#phsortingup}}<i class="fa fa-sort-asc sort-icon"></i>{{/phsortingup}}
                {{#phsortingdown}}<i class="fa fa-sort-desc sort-icon"></i>{{/phsortingdown}}
                {{#phsorting}}<i class="fa fa-sort sort-icon"></i>{{/phsorting}}
            </th>
            <th scope="col">{{#str}}status, local_people{{/str}}</th>
            <th scope="col">{{#str}}actions, local_people{{/str}}</th>
            {{/head}}
        </tr>
    </thead>
    <tbody>
        {{#istablerows}}
        <tr class="{{#issuspenduser}}people-row--suspended{{/issuspenduser}}">

            {{! Checkbox }}
            <td class="people-check-col">
                {{#issuspenduser}}
                <span class="usersuspended">{{{checkbox}}}</span>
                {{/issuspenduser}}
                {{^issuspenduser}}
                {{{checkbox}}}
                {{/issuspenduser}}
            </td>

            {{! Full Name + Avatar }}
            <td>
                <div class="people-user-cell">
                    {{#userimage}}
                    <img src="{{{userimage}}}" alt="{{{fullname}}}" class="people-user-avatar"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                    <div class="people-user-avatar-placeholder" style="display:none;">{{{initials}}}</div>
                    {{/userimage}}
                    {{^userimage}}
                    <div class="people-user-avatar-placeholder">{{{initials}}}</div>
                    {{/userimage}}
                    <div class="people-user-name">
                        {{#isupdateuser}}
                        <a href="{{{isupdateuserurl}}}">
                            {{#issuspenduser}}<span class="usersuspended">{{{fullname}}}</span>{{/issuspenduser}}
                            {{^issuspenduser}}{{{fullname}}}{{/issuspenduser}}
                        </a>
                        {{/isupdateuser}}
                        {{^isupdateuser}}
                        {{#issuspenduser}}<span class="usersuspended">{{{fullname}}}</span>{{/issuspenduser}}
                        {{^issuspenduser}}{{{fullname}}}{{/issuspenduser}}
                        {{/isupdateuser}}
                        {{#username}}<div class="people-user-username">@{{{username}}}</div>{{/username}}
                    </div>
                </div>
            </td>

            {{! Email }}
            <td>
                {{#issuspenduser}}<span class="usersuspended">{{{email}}}</span>{{/issuspenduser}}
                {{^issuspenduser}}{{{email}}}{{/issuspenduser}}
            </td>

            {{! Dept }}
            <td>
                {{#issuspenduser}}<span class="usersuspended">{{{dept}}}</span>{{/issuspenduser}}
                {{^issuspenduser}}{{{dept}}}{{/issuspenduser}}
            </td>

            {{! Enrolled courses }}
            <td>
                {{#issuspenduser}}<span class="usersuspended">{{{enroll}}}</span>{{/issuspenduser}}
                {{^issuspenduser}}{{{enroll}}}{{/issuspenduser}}
            </td>

            {{! Completed courses }}
            <td>
                {{#issuspenduser}}<span class="usersuspended">{{{complete}}}</span>{{/issuspenduser}}
                {{^issuspenduser}}{{{complete}}}{{/issuspenduser}}
            </td>

            {{! Tenant column (optional) }}
            {{#istenant}}
            <td class="tenant-col">
                {{#issuspenduser}}<span class="usersuspended">{{{tenant_comp}}}</span>{{/issuspenduser}}
                {{^issuspenduser}}{{{tenant_comp}}}{{/issuspenduser}}
            </td>
            {{/istenant}}

            {{! Last access }}
            <td>
                {{#issuspenduser}}<span class="usersuspended">{{{strlastaccess}}}</span>{{/issuspenduser}}
                {{^issuspenduser}}{{{strlastaccess}}}{{/issuspenduser}}
            </td>

            {{! Status badge }}
            <td>
                {{#issuspenduser}}
                    <span class="people-badge people-badge--suspended">
                        <i class="fa fa-ban mr-1"></i>{{#str}}suspended, local_people{{/str}}
                    </span>
                {{/issuspenduser}}
                {{^issuspenduser}}
                    {{#suspended}}
                    <span class="people-badge people-badge--suspended">
                        <i class="fa fa-ban mr-1"></i>{{#str}}suspended, local_people{{/str}}
                    </span>
                    {{/suspended}}
                    {{^suspended}}
                    {{#isconfirmbtn}}
                    <span class="people-badge people-badge--unconfirmed">
                        <i class="fa fa-clock-o mr-1"></i>{{#str}}unconfirmed, local_people{{/str}}
                    </span>
                    {{/isconfirmbtn}}
                    {{^isconfirmbtn}}
                    <span class="people-badge people-badge--active">
                        <i class="fa fa-check mr-1"></i>{{#str}}active, local_people{{/str}}
                    </span>
                    {{/isconfirmbtn}}
                    {{/suspended}}
                {{/issuspenduser}}
            </td>

            {{! Row actions }}
            <td>
                <div class="people-row-actions">
                    {{#loginasbtn}}
                    <a href="{{{urlloginas}}}" title="{{#str}}loginas, local_people{{/str}}" class="action-info">
                        <i class="fa fa-sign-in"></i>
                    </a>
                    {{/loginasbtn}}
                    {{#hasloginasbtn}}
                    <a href="{{{hasurlloginas}}}" title="{{#str}}loginas, local_people{{/str}}" class="action-info">
                        <i class="fa fa-sign-in"></i>
                    </a>
                    {{/hasloginasbtn}}
                    {{#iseditbtn}}
                    <a href="{{{urledit}}}" title="{{#str}}edit, local_people{{/str}}" class="action-primary">
                        <i class="fa fa-pencil"></i>
                    </a>
                    {{/iseditbtn}}
                    {{#issuspendbtn}}
                    <a href="{{{urlsus}}}" title="{{{suspendstring}}}" class="action-warning">
                        <i class="fa fa-{{#suspended}}play{{/suspended}}{{^suspended}}pause{{/suspended}}"></i>
                    </a>
                    {{/issuspendbtn}}
                    {{#isconfirmbtn}}
                    <a href="{{{confirmurl}}}" title="{{#str}}send_email_confirmation_again, local_people{{/str}}" class="action-success">
                        <i class="fa fa-envelope"></i>
                    </a>
                    {{/isconfirmbtn}}
                    {{#hasconfirmbtn}}
                    <a href="{{{hasconfirmurl}}}" title="{{#str}}confirm, local_people{{/str}}" class="action-success">
                        <i class="fa fa-check"></i>
                    </a>
                    {{/hasconfirmbtn}}
                    {{#isconfirmbuttn}}
                    <a href="{{{confirmurlbtn}}}" title="{{#str}}confirm, local_people{{/str}}" class="action-success">
                        <i class="fa fa-check-circle"></i>
                    </a>
                    {{/isconfirmbuttn}}
                </div>
            </td>

        </tr>
        {{/istablerows}}
    </tbody>
</table>
