{{! People Plugin - First Accessed Date Filter }}
<div class="filterslist people-subfilter" data-filter-name="firstaccessd">
    <div class="people-subfilter-header" role="button" aria-expanded="false" tabindex="0">
        <span class="people-subfilter-title">
            <i class="fa fa-calendar-check-o mr-1"></i>
            {{#str}}firstaccessd, local_people{{/str}}
        </span>
        <i class="fa fa-chevron-down people-subfilter-icon"></i>
    </div>
    <div class="people-subfilter-body" style="display:none;">
        {{#firstaccessd}}
        <a href="#" data-name="firstaccessd" class="reset people-clear-link">
            <i class="fa fa-times-circle mr-1"></i>{{#str}}clear, local_people{{/str}}
        </a>
        {{/firstaccessd}}
        <form id="form-firstaccessd" method="post" action="">
            {{#firstaccessd}}
            <input type="hidden" class="filter-true" name="filter-true" value="true">
            {{/firstaccessd}}
            <div class="people-date-picker-group">
                <div class="people-date-picker-field">
                    <label class="people-date-label">From</label>
                    <div class="people-date-input-wrap">
                        <i class="fa fa-calendar people-date-icon-left"></i>
                        <input type="text"
                               class="form-control people-date-picker"
                               name="firstaccessd_from"
                               id="firstaccessd_from"
                               placeholder="DD / MM / YYYY"
                               autocomplete="off"
                               readonly>
                    </div>
                    <div class="people-calendar-popup" id="people-cal-firstaccessd_from"></div>
                </div>
                <div class="people-date-picker-field">
                    <label class="people-date-label">To</label>
                    <div class="people-date-input-wrap">
                        <i class="fa fa-calendar people-date-icon-left"></i>
                        <input type="text"
                               class="form-control people-date-picker"
                               name="firstaccessd_to"
                               id="firstaccessd_to"
                               placeholder="DD / MM / YYYY"
                               autocomplete="off"
                               readonly>
                    </div>
                    <div class="people-calendar-popup" id="people-cal-firstaccessd_to"></div>
                </div>
            </div>
            <div style="display:none;">{{{dateisafter}}}</div>
            <div>{{{neveraccesscheckbox}}}</div>
            <input type="hidden" name="datefilter" value="firstaccessd">
        </form>
    </div>
</div>
