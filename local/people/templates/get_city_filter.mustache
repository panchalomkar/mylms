{{! People Plugin - City/Town Filter — search + tag selection like Course filter }}
<div class="filterslist people-subfilter" data-filter-name="city">
    <div class="people-subfilter-header" role="button" aria-expanded="false" tabindex="0">
        <span class="people-subfilter-title">
            <i class="fa fa-building mr-1"></i>
            {{#str}}city, local_people{{/str}}
        </span>
        <i class="fa fa-chevron-down people-subfilter-icon"></i>
    </div>
    <div class="people-subfilter-body" style="display:none;">
        {{#cityop}}
        <a href="#" data-name="city" class="reset people-clear-link">
            <i class="fa fa-times-circle mr-1"></i>{{#str}}clear, local_people{{/str}}
        </a>
        {{/cityop}}
        <form id="form-city" method="post" action="">
            {{#cityop}}
            <input type="hidden" class="filter-true" name="filter-true" value="true">
            {{/cityop}}

            {{! Selected city tags }}
            <div class="people-selected-courses" id="people-selected-city-display">
                {{#cityopt}}{{#selected}}
                <span class="people-course-selected-tag" data-value="{{{key}}}">
                    <span class="people-course-tag-text">{{{key}}}</span>
                    <span class="people-course-tag-remove" title="Remove"><i class="fa fa-times"></i></span>
                </span>
                {{/selected}}{{/cityopt}}
            </div>

            {{! Search box }}
            <div class="people-course-search-wrap">
                <input type="text" class="form-control people-course-search-input people-select-search"
                       data-target="people-city-checkbox-list"
                       placeholder="Search cities..." autocomplete="off">
                <i class="fa fa-search people-course-search-icon"></i>
            </div>

            {{! Hidden real select }}
            <select class="people-hidden-select" multiple="multiple" id="menucityop" name="cityop[]" style="display:none;">
                {{#cityopt}}
                    <option value="{{{key}}}" {{{selected}}}>{{{key}}}</option>
                {{/cityopt}}
            </select>

            {{! Checkbox list }}
            <div class="people-course-list-wrap">
                <div class="people-course-checkbox-list people-generic-checkbox-list" id="people-city-checkbox-list"
                     data-tags-container="people-selected-city-display"
                     data-hidden-select="menucityop">
                    {{#cityopt}}
                    <label class="people-course-item" data-value="{{{key}}}" data-label="{{{key}}}">
                        <input type="checkbox" class="people-generic-checkbox" value="{{{key}}}"
                               {{#selected}}checked{{/selected}}>
                        <span class="people-course-item-label">{{{key}}}</span>
                    </label>
                    {{/cityopt}}
                </div>
            </div>

            <input type="hidden" name="multipleselectfilter" value="city">
        </form>
    </div>
</div>
