{{!
    People Plugin - User Table Block
    Moodle 5.0.2 + REMUI Theme 5
    Brand: #003152, #ec9707
}}
<div class="people-table-wrap">

    {{! Table header: totals + tenant toggle }}
    <div class="people-table-header">
        <div class="people-table-total">
            {{#count}}
            {{{totalrecords}}}
            {{/count}}
            {{^count}}
            <span>&nbsp;</span>
            {{/count}}
        </div>
        {{#tenanthide}}
        <div class="d-flex align-items-center gap-2" style="gap:8px;">
            <input type="hidden" value="{{{host2service}}}" id="show_tenat_company_val">
            <label class="d-flex align-items-center mb-0" style="gap:6px;cursor:pointer;font-size:.84rem;">
                <input type="checkbox" id="show_tenat_company" value="{{{host2service}}}">
                {{#str}}multitenant_record, local_people{{/str}}
            </label>
        </div>
        {{/tenanthide}}
    </div>

    {{! Bulk action form wrapper }}
    <form id="form-bulk-actions">

        {{! Empty state }}
        {{#istableempty}}
        <div class="people-empty-state">
            <i class="fa fa-users"></i>
            <p>{{#str}}users_not_found, local_people{{/str}}</p>
            {{#lcinvitebutton}}
            <button class="people-btn people-btn--accent" id="btn_invite_user" type="button">
                <i class="fa fa-envelope"></i>
                {{#str}}invite, local_people{{/str}}
            </button>
            {{/lcinvitebutton}}
        </div>
        {{/istableempty}}

        {{! User table }}
        {{#istable}}
        <div class="table-responsive">
            {{> local_people/user_table}}
        </div>
        {{/istable}}

    </form>

    {{! Pagination footer }}
    <div class="people-pagination">
        {{#userperpage}}
        <form method="POST" class="people-per-page">
            <span>{{#str}}recordsperpage, local_people{{/str}}</span>
            <select id="id_userperpage" name="userperpage">
                {{#options}}
                <option value="{{{key}}}" {{{selected}}}>{{{key}}}</option>
                {{/options}}
            </select>
        </form>
        {{/userperpage}}
        <div class="paging-wrap">
            {{{pagingbar}}}
        </div>
    </div>

</div>
