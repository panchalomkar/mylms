            </div>

            <!-- Sub title -->
            <div class="text-gray-600 text-sm font-medium mt-4 mb-1">Points Graph</div>

            <!-- Chart -->
            <div class="bg-white rounded-lg border p-2">
                <div id="chart_quiz" class="h-40"></div>
            </div>
        </div>



        <!-- =============== RIGHT SIDE — DAILY LOGIN =============== -->
        <div>
            <h3 class="text-md font-bold text-gray-800 mb-2">DAILY LOGIN</h3>

            <div class="flex items-center gap-4 mb-4">
