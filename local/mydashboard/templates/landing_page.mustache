                    <div class="text-2xl font-bold text-gray-900">{{login_points}}</div>
                </div>
            </div>

            <div class="text-gray-600 text-sm font-medium mt-4 mb-1 flex justify-between">
                <span>Points Graph</span>
                <span class="text-yellow-500 text-xs">Login Points</span>
            </div>

            <!-- Chart -->
            <div class="bg-white rounded-lg border p-2">
                <div id="chart_login" class="h-40"></div>
            </div>
        </div>

    </div> <!-- END GRID -->

</div>

