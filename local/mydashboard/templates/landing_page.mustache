    </div>

    <!-- =========================== QUIZ + LOGIN GRID =========================== -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 px-4">

        <!-- =============== LEFT SIDE — DAILY QUIZ =============== -->
