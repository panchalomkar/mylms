              <div style="    width: 50px;height: 50px;" class=" rounded-full border-4 border-yellow-400 overflow-hidden shadow">
                        <img src="{{profileimage}}" class="w-full h-full object-cover" />
                    </div>
                
                <!-- Attempt Button -->
              
                  <a style="background: linear-gradient(90deg, #0B2964, #23468D);" class="flex items-center gap-2 hover:bg-blue-900 text-white px-3 py-1 rounded-lg shadow font-medium" href="{{dailyquiz_url}}"
