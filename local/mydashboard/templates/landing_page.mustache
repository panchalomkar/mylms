                                <b class="text-gray-800">{{phone}}</b>
                            </div>
                        </div>

                        <!-- RIGHT -->
                        <div class="space-y-3">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-rounded text-yellow-500 text-lg">trending_up</span>
                                <span class="text-gray-500">Next Level:</span>
                                <b class="text-gray-700">{{nextlevel}}</b>
