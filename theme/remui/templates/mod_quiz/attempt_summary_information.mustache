{{#hasitems}}
<div class="quiz-attempt-summary-card p-3 mb-3 border rounded shadow-sm bg-white">
    {{#caption}}
       
    {{/caption}}

    <div class="summary-items">
        {{#items}}
        <div class="summary-item d-flex justify-content-between align-items-center py-2 border-bottom">
            <span class="summary-title font-weight-bold">{{{title}}}</span>
            <span class="summary-content text-right">{{{content}}}</span>
        </div>
        {{/items}}
    </div>
</div>
{{/hasitems}}