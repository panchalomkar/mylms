{{!
    @template theme_remui/course_card_grid
}}


<style>
#courseDetailModal .modal-content {
 border: 1px solid #003152;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 1px 1px 225px 87px #7ba4bf;
}

#courseDetailModal .modal-header {
    background: #003152;
    color: #fff;
    border-bottom: 2px solid #ec9707;
}

#courseDetailModal .modal-title {
    color: #fff;
    font-weight: 600;
}

#courseDetailModal .btn-close {
    filter: invert(1); /* Makes close icon white */
}

#courseDetailModal .btn-close:hover {
    filter: invert(0) brightness(0.5);
    background-color: #ec9707;
    border-radius: 5px;
}

#courseDetailModal .modal-body {
    padding: 20px;
    background: #f8f9fa;
    color: #003152;
}

.progress-container {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.progress-bar {
  height: 0.5rem; /* 8px */
  background-color: #e5e7eb; /* light gray background */
  border-radius: 9999px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 9999px;
  transition: width 0.3s ease;
  /* background color set dynamically via inline style: {{progresscolor}} */
}

.progress-label {
  font-size: 0.75rem;
  font-weight: 500;
  color: #000;
}
</style>



<div class="course_card-0 course-box card-wrapper card dashboard-card edwanimate-{{animation}}"  data-course-id="{{id}}"  data-isenrolled="{{#isenrolled}}1{{/isenrolled}}{{^isenrolled}}0{{/isenrolled}}">
    <div tabindex="-1">
        <div class="card-img dashboard-card-img p-p-4 edw-course-img-wrapper" style='background-image: url("{{{courseimage}}}");'>
            <div href="{{ courseurl }} " class="view-course-url"></div>

            <div class="d-flex align-items-center justify-content-between">
                {{#skillleveltag}}
                    <p class="skilltag m-0 badge {{badge}}">{{{labeltag}}}</p>
                {{/skillleveltag}}

                <div class="card-img-icons-wrapper d-flex align-items-center flex-gap-2 ml-auto">
                    {{^visible}}
                        <div class="visibilityicon">
                            <i class="hidden-icon edw-icon edw-icon-Hide" aria-hidden="true" title="{{#str}} hiddencourse, theme_remui {{/str}}"></i>
                        </div>
                    {{/visible}}
                    {{#usercanmanage}}
                        {{>theme_remui/coursearchive_menu-picker-select}}
                    {{/usercanmanage}}
                </div>
            </div>

        </div>
    </div>
     <div class="course-card-body-wrapper p-3 d-flex h-100">
        <div class="card-body course-info-container d-flex flex-column  justify-content-between  flex-gap-5" id="course-info-container-{{id}}-{{uniqid}}">
            <div class="edw-card-design-hd d-flex flex-column flex-gap-3">
                <div class="d-flex flex-column align-items-start flex-gap-3 catlogue-border">
                    <span class="categoryname text-truncate small-info-semibold" title="{{{categoryname}}}"  style="font-size: 0.75rem; line-height: 1rem;background-color: {{{categorycolor}}}; color: {{categorytextcolor}};">
                        {{{categoryname}}}
                    </span>
                    <div class="w-100 ">
                        <a class="coursename text-decoration-none ellipsis ellipsis-3 h-semibold-6" href="{{courseurl}}" title="{{{ coursename }}}">
                            {{{coursename}}}
                        </a>
                    </div>
                </div>
                {{#instructors}}
                    <div class="d-flex flex-row flex-gap-0d5">
                        <div class="d-flex flex-row instructor-info-wrapper">
                            <a href="{{ url }}" class="d-flex  align-items-center flex-gap-d5 instructor-img {{ imgStyle }}"
                                aria-label="Instructor for {{coursename}} is - {{name}}" title="{{{name}}}">
                                <img src="{{ picture }}" class="rounded-circle" alt="{{ name }}" loading="lazy"/>
                                <div class="d-flex flex-column"><span class="text-muted" style="text-transform: uppercase;font-size: 11px;line-height: 15px; font-widget:300;">Instructor</span>
                                <h6 class="h-regular-6 course-instructors m-0 break-word ellipsis ellipsis-2" title="{{{name}}}">{{{name}}}</h6>
                                </div>
                            </a>
                        </div>

                        {{#instructorcount}}
                            <span class="small-info-semibold instructorscount d-flex align-items-center justify-content-center" title="{{#str}}instructorcounttitle,theme_remui{{/str}}">
                                +{{instructorcount}}
                            </span>
                        {{/instructorcount}}
                    </div>
                {{/instructors}}

                {{#coursesummary}}
                    <p class="coursesummary ellipsis ellipsis-2 para-regular-2 m-0">{{{coursesummary}}}</p>
                {{/coursesummary}}
            </div>
            <div class="edw-card-design-ft d-flex flex-column align-self-strech flex-gap-5">
                <div class="d-flex text-nowrap ernr-lesson-wrapper flex-row mt-2">
                    <div class="lesson-date-wrapper d-flex flex-wrap col-md-5">
                         {{#lessoncount}}
                        <div class="lesson-count small-info-semibold m-0 d-flex flex-gap-d5 align-items-center">
                            <span class="edw-icon edw-icon-Book" title="{{lessoncount}} lessons"></span>
                            <span>{{lessoncount}} {{{lessonstitletext}}}</span>
                        </div>
                        {{/lessoncount}}
   {{#durationweeks}}
<div class="updated-date small-info-semibold m-0 d-flex flex-gap-d5 align-items-center">
    <span class="edw-icon edw-icon-Time" title="Course Duration"></span>
    <span>{{durationweeks}} Weeks</span>
</div>
{{/durationweeks}}
                       
                    </div>
                    <div class="lesson-date-wrapper d-flex flex-wrap col-md-5">
                        {{#ernrshortdesign}}
                            <div>{{{ernrshortdesign}}}</div>
                        {{/ernrshortdesign}}
                        {{#enrolleduserscount}}
                            <div class="enrolled-users-count small-info-semibold m-0 d-flex flex-gap-d5 align-items-center">
                            <span class="edw-icon edw-icon-Group-user" title=""></span> <span>{{{enrolleduserscount}}} {{{enrolledusertitletext}}}</span>
                            </div>
                        {{/enrolleduserscount}}
                    
                     {{#showselecteddatesetting}}
                        <div class="updated-date small-info-semibold m-0 d-flex flex-gap-d5 align-items-center">
                            <span class="edw-icon edw-icon-Calendar" title=""></span> {{showselecteddatesetting}}
                        </div>
                        {{/showselecteddatesetting}}
                        </div>
                </div>
{{#isenrolled}}
<div class="progress-container mt-5">
    <div class="text-sm mb-1 w-full" style="display: flex; justify-content: space-between;">
        <span class="text-muted-light dark:text-text-secondary-dark">Course Progress</span>
        <span class="font-semibold text-text-light dark:text-text-dark">{{progress}}%</span>
    </div>
    <div class="progress-bar w-full rounded-full h-2 bg-gray-200 dark:bg-gray-700 overflow-hidden">
        <div class="progress-fill h-2 rounded-full"
             style="width: {{progress}}%; background-color: {{progresscolor}};">
        </div>
    </div>
</div>
{{/isenrolled}}

                <div class="payment-view-wrapper d-flex justify-content-between flex-gap-4">
                    <div class="d-flex d-none flex-gap-1 align-items-center enrollmenticons-wrapper">
                        {{#enrollmenticons }}{{{enrollmenticons}}}{{/enrollmenticons }}
                        {{#enrollmenticonsremainig}}
                            <span class="small-info-semibold paymentmethodcount d-flex align-items-center justify-content-center" title="">+{{{enrollmenticonsremainig}}}</span>
                        {{/enrollmenticonsremainig}}
                    </div>
                    <a class="btn btn-primary mb-2 mt-3 justify-content-center d-flex w-100  btn-sm view-course-btn" 
   href="{{ courseurl }}" 
   title="{{#str}}viewcoursetitle,theme_remui{{/str}}">
   View Course Details
</a>


                </div>
                 <div class="edw-card-design-ft d-flex flex-column align-self-strech flex-gap-5">
        </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="courseDetailModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">

      <div class="modal-header p-2">
        <h5 class="modal-title d-flex justify-content-center w-100">Course Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body" id="courseDetailContent">
        Loading...
      </div>

    </div>
  </div>
</div>


{{#js}}
require(['jquery'], function($) {
    $('.edw-course-card-grid .dashboard-card').each(function(index, gridCard) {
        $(gridCard).css('height', $(gridCard).outerHeight(true));
    });

    
   $(document).on('click', '#courseDetailModal .btn-close', function () {
        $('#courseDetailModal').modal('hide');
    });

    // Main click handler
    $(document).on('click', '.course-detail-trigger', function(e) {
        e.preventDefault();

        let isEnrolled = $(this).data('isenrolled');
        let courseUrl  = $(this).data('course-url');

        // Enrolled → go directly
        if (isEnrolled == 1) {
            window.location.href = courseUrl;
            return;
        }

        // Open Popup
        $('#courseDetailModal').modal('show');
        $("#courseDetailContent").html("Loading...");

        $.ajax({
            url: courseUrl,
            method: "GET",
            success: function(response) {

                // Detect enforced enrolment page
                if ($(response).find('.enrolmentoptions').length > 0) {

                    $("#courseDetailContent").html(
                        "<h4 class='text-danger mb-3'>Enrollment Required</h4>" +
                        $(response).find('.enrolmentoptions').html()
                    );

                    return;
                }

                // Load region-main content
                let cleanHtml = $(response).find('#region-main').html();
                $("#courseDetailContent").html(cleanHtml);
            },
            error: function() {
                $("#courseDetailContent").html(
                    "<div class='alert alert-danger'>Unable to load course details.</div>"
                );
            }
        });
    });

});
{{/js}}
