<script>
(function() {
    'use strict';

    function parseIsEnrolled(value) {
        if (value === undefined || value === null) { return false; }
        value = String(value).trim().toLowerCase();
        return (value === '1' || value === 'true' || value === 'yes');
    }

    function filterCourses(showEnrolledOnly) {
        const cards = document.querySelectorAll('.course-box');
        let visibleCount = 0;
        cards.forEach(function(card) {
            const attr = card.getAttribute('data-isenrolled');
            const enrolled = parseIsEnrolled(attr);
            if (showEnrolledOnly) {
                if (!enrolled) {
                    card.classList.add('d-none');
                } else {
                    card.classList.remove('d-none');
                    visibleCount++;
                }
            } else {
                card.classList.remove('d-none');
                visibleCount++;
            }
        });

        // Optionally show a "no courses" message
        let noMsg = document.getElementById('remui-no-enrolled-message');
        if (!noMsg) {
            noMsg = document.createElement('div');
            noMsg.id = 'remui-no-enrolled-message';
            noMsg.className = 'text-center p-4 d-none';
            noMsg.textContent = 'No courses found.';
            // append after filters-wrapper or to a container you prefer
            const container = document.querySelector('.filters-wrapper') || document.body;
            container.parentNode.insertBefore(noMsg, container.nextSibling);
        }
        if (showEnrolledOnly && visibleCount === 0) {
            noMsg.classList.remove('d-none');
        } else {
            noMsg.classList.add('d-none');
        }
    }

    function initEnrolledToggle() {
        const toggle = document.querySelector('#toggle-enrolled-courses');
        if (!toggle) return;

        // restore saved state
        try {
            const saved = localStorage.getItem('remui_show_enrolled_only');
            if (saved !== null) {
                toggle.checked = (saved === '1');
            }
        } catch (e) {
            // ignore storage errors
        }

        // initial run
        filterCourses(toggle.checked);

        // on change
        toggle.addEventListener('change', function() {
            const checked = !!toggle.checked;
            try {
                localStorage.setItem('remui_show_enrolled_only', checked ? '1' : '0');
            } catch (e) {}
            filterCourses(checked);
        });

        // Monitor for dynamic changes to course list (AJAX or re-render)
        const listRoot = document.querySelector('body'); // fallback
        const observerTarget = document.querySelector('.edw-course-card-grid') || document.querySelector('#course-archive-main-container') || listRoot;
        if (!observerTarget) return;

        const mo = new MutationObserver(function(mutations) {
            // If any course-box added/removed, re-run filter
            let shouldRun = false;
            for (const m of mutations) {
                if (m.addedNodes.length || m.removedNodes.length) {
                    shouldRun = true;
                    break;
                }
            }
            if (shouldRun) {
                // small delay to allow markup to settle
                setTimeout(function() {
                    filterCourses(toggle.checked);
                }, 80);
            }
        });

        mo.observe(observerTarget, { childList: true, subtree: true });
    }

    // DOM ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initEnrolledToggle);
    } else {
        initEnrolledToggle();
    }
})();
</script>

